{
  "bad-contract-route-missing": {
    "expect": ["[route-table]", "contract route (app)/stats has no route file"],
    "ops": [{ "json": { "file": "contracts/navigation.json", "path": ["routes", 7], "value": "(app)/stats" } }]
  },
  "bad-contract-unknown-key": {
    "expect": ["[contract]", "unknown key \"screens\""],
    "ops": [{ "json": { "file": "contracts/navigation.json", "path": ["screens"], "value": [] } }]
  },
  "bad-debug-not-test-only": {
    "expect": ["[debug-gated]", "src/app/debug.tsx:1", "does not render through TEST_ONLY"],
    "ops": [
      {
        "write": {
          "file": "src/app/debug.tsx",
          "lines": [
            "// src/app/debug.tsx",
            "import { DebugScreen } from '@/features/debug/debug-screen';",
            "",
            "export default DebugScreen;"
          ]
        }
      }
    ]
  },
  "bad-debug-route-unguarded": {
    "expect": ["[debug-gated]", "src/app/debug.tsx:1", "debug route debug is reachable in production builds"],
    "ops": [
      {
        "replace": {
          "file": "src/features/root-navigator/app-stack.tsx",
          "find": "      <Stack.Protected guard={isTestBuild}>\n        <Stack.Screen name=\"debug\" />\n      </Stack.Protected>\n",
          "with": "      <Stack.Screen name=\"debug\" />\n"
        }
      },
      {
        "replace": {
          "file": "src/features/root-navigator/app-stack.tsx",
          "find": "import { isTestBuild } from '@/features/debug/test-build';\n",
          "with": ""
        }
      },
      { "json": { "file": "contracts/navigation.json", "path": ["protected", 2], "delete": true } }
    ]
  },
  "bad-dynamic-route-no-parser": {
