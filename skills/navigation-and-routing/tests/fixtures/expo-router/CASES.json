  "bad-editor-no-prevent-remove": {
    "expect": [
      "[guarded-prevent-remove]",
      "src/features/task-editor/use-task-editor-model.ts:1",
      "never blocks removal"
    ],
    "ops": [
      {
        "write": {
          "file": "src/features/task-editor/use-task-editor-model.ts",
          "lines": [
            "// src/features/task-editor/use-task-editor-model.ts",
            "import { useRouter } from 'expo-router';",
            "",
            "export function useTaskEditorModel(): { readonly onSave: () => void } {",
            "  const router = useRouter();",
            "  return {",
            "    onSave: () => {",
            "      router.back();",
            "    },",
            "  };",
            "}"
          ]
        }
      }
    ]
  },
  "bad-editor-swipe-on": {
    "expect": ["[guarded-gesture-off]", "src/app/(app)/tasks/[taskId]/edit.tsx:1", "keeps the iOS back swipe"],
    "ops": [{ "json": { "file": "contracts/navigation.json", "path": ["guarded", 0, "gesture"], "value": "off" } }]
  },
  "bad-effect-navigation": {
    "expect": [
      "[flow-by-guard]",
      "src/features/root-navigator/app-stack.tsx:11",
      "a layout navigates from an effect (router.replace)"
    ],
    "ops": [
      {
        "replace": {
          "file": "src/features/root-navigator/app-stack.tsx",
          "find": "import { Stack } from 'expo-router';",
          "with": "import { Stack, router } from 'expo-router';\nimport { useEffect } from 'react';"
        }
      },
      {
        "replace": {
          "file": "src/features/root-navigator/app-stack.tsx",
          "find": "  const isSignedIn = useIsSignedIn();\n",
          "with": "  const isSignedIn = useIsSignedIn();\n  useEffect(() => {\n    if (!isSignedIn) router.replace('/sign-in');\n  }, [isSignedIn]);\n"
        }
      }
    ]
  },
  "bad-guard-changed": {
    "expect": [
      "[protected-guard]",
      "no <Stack.Protected guard={isSignedIn}> in src/features/root-navigator/app-stack.tsx",
      "the protected group guard={isSignedIn || isTestBuild} is not in the contract"
    ],
    "ops": [
      {
        "replace": {
          "file": "src/features/root-navigator/app-stack.tsx",
          "find": "guard={isSignedIn}",
          "with": "guard={isSignedIn || isTestBuild}"
        }
      }
    ]
  },
