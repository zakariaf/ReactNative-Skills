          "file": "src/services/live/start-live-updates.ts",
          "lines": [
            "// src/services/live/start-live-updates.ts",
            "import type { ErrorNet } from '@/services/error-net/error-net';",
            "",
            "export type LiveSocket = {",
            "  readonly connect: () => void;",
            "  readonly onError: (listener: (error: unknown) => void) => void;",
            "};",
            "",
            "export function createLiveSocket(url: string): LiveSocket {",
            "  const listeners: ((error: unknown) => void)[] = [];",
            "  return {",
            "    connect: () => {",
            "      listeners.forEach((listener) => {",
            "        listener(new Error(`not connected: ${url}`));",
            "      });",
            "    },",
            "    onError: (listener) => {",
            "      listeners.push(listener);",
            "    },",
            "  };",
            "}",
            "",
            "/** Reports socket errors through the net; the socket's connect() has nothing to do with the net's. */",
            "export function startLiveUpdates(net: Pick<ErrorNet, 'report'>, socket: LiveSocket): void {",
            "  socket.onError((error) => {",
            "    net.report({ source: 'global-handler', error, isFatal: false });",
            "  });",
            "  socket.connect();",
            "}"
          ]
        }
      }
    ]
