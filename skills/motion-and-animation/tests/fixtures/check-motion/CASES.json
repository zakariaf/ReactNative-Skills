  "bad-celebration-mount-effect": {
    "expect": [
      "src/features/lists/components/list-done.tsx:18 [celebration-through-hook] a celebration plays from useEffect"
    ],
    "ops": [
      {
        "write": {
          "file": "src/features/lists/components/list-done.tsx",
          "lines": [
            "// src/features/lists/components/list-done.tsx",
            "// Plants the bug: the celebration plays from a mount effect, so every remount replays it.",
            "import { useEffect } from 'react';",
            "import { View } from 'react-native';",
            "",
            "import { CelebrationBurst } from '@/ui/motion/celebration-burst';",
            "import { MOTION_MOMENTS } from '@/ui/motion/motion-moments';",
            "import { useCelebration } from '@/ui/motion/use-celebration';",
            "",
            "import type { ReactNode } from 'react';",
            "",
            "export type ListDoneProps = { readonly listId: string; readonly colors: readonly string[] };",
            "",
            "export function ListDone({ listId, colors }: ListDoneProps): ReactNode {",
            "  const celebration = useCelebration(MOTION_MOMENTS.listCleared);",
            "  useEffect(() => {",
            "    // The list screen mounts this view when the last task is done.",
            "    celebration.play(listId);",
            "  }, [celebration, listId]);",
            "  return (",
            "    <View>",
            "      <CelebrationBurst celebration={celebration} colors={colors} testID=\"lists.done\" />",
            "    </View>",
            "  );",
            "}"
          ]
        }
      }
    ]
  },
