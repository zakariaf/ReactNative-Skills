  "pass-gesture-tap-release": {
    "expect": ["RESULT: PASS"],
    "ops": [
      {
        "write": {
          "file": "src/features/tasks/components/press-scale.tsx",
          "lines": [
            "// src/features/tasks/components/press-scale.tsx",
            "// A tap scales the card down and springs it back on release: a tap event carries no velocity.",
            "import { Gesture, GestureDetector } from 'react-native-gesture-handler';",
            "import Animated, { useAnimatedStyle, useSharedValue, withSpring, withTiming } from 'react-native-reanimated';",
            "",
            "import { springOf, timingOf } from '@/ui/motion/moment-config';",
            "import { MOTION_MOMENTS } from '@/ui/motion/motion-moments';",
            "",
            "import type { ReactNode } from 'react';",
            "",
            "const PRESS = timingOf(MOTION_MOMENTS.press);",
            "const RELEASE = springOf(MOTION_MOMENTS.pressRelease);",
            "",
            "export function PressScale({ children }: { readonly children: ReactNode }): ReactNode {",
            "  const press = useSharedValue(0);",
            "  const tap = Gesture.Tap()",
            "    .onBegin(() => {",
            "      press.set(withTiming(1, PRESS));",
            "    })",
            "    .onFinalize(() => {",
            "      press.set(withSpring(0, RELEASE));",
            "    });",
            "  const hold = Gesture.LongPress().minDuration(400);",
            "  hold.onEnd(() => {",
            "    press.set(withSpring(0, RELEASE));",
            "  });",
            "  const style = useAnimatedStyle(() => ({ transform: [{ scale: 1 - press.get() / 20 }] }));",
            "  return (",
            "    <GestureDetector gesture={Gesture.Exclusive(hold, tap)}>",
            "      <Animated.View style={style}>{children}</Animated.View>",
            "    </GestureDetector>",
            "  );",
            "}"
          ]
        }
      }
    ]
  },
