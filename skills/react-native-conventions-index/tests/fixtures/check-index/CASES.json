      "[command-unknown]",
      "step 1 runs check-alpha.mjs --stirct, which alpha-one's check-alpha.mjs does not declare"
    ],
    "ops": [
      {
        "json": {
          "file": "skills/route-index/assets/index.json",
          "path": ["buildOrders", 0, "steps", 0, "proof"],
          "value": "`check-alpha.mjs . --stirct` (alpha-one) prints RESULT: PASS"
        }
      }
    ]
  },
  "bad-command-unknown": {
    "expect": [
      "[command-unknown]",
      "buildOrders[0] \"base\" step 1 runs check-beta.mjs, which alpha-one does not have in scripts/"
    ],
    "ops": [
      {
        "json": {
          "file": "skills/route-index/assets/index.json",
          "path": ["buildOrders", 0, "steps", 0, "proof"],
          "value": "`check-beta.mjs .` (alpha-one) prints RESULT: PASS"
        }
      }
    ]
  },
  "bad-coverage-drop": {
