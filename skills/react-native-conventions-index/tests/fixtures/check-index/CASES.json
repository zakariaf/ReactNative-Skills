{
  "bad-agents-drift": {
    "expect": ["AGENTS.md:", "[agents-drift] the intent for alpha-one differs from its description"],
    "ops": [
      {
        "replace": {
          "file": "AGENTS.md",
          "find": "- `alpha-one`: use when the alpha part changes.",
          "with": "- `alpha-one`: use when anything changes."
        }
      }
    ]
  },
  "bad-agents-unrouted": {
    "expect": ["[agents-drift] the intent map does not route beta-two"],
    "ops": [
      { "replace": { "file": "AGENTS.md", "find": "- `beta-two`: use when the beta feature changes.\n", "with": "" } }
    ]
  },
  "bad-catalog-drift": {
    "expect": ["[catalog-drift]", "beta-two: category is \"parts\" in the index, \"start\" in the catalogue"],
    "ops": [{ "json": { "file": "catalog.json", "path": ["skills", 2, "category"], "value": "start" } }]
  },
  "bad-command-flag": {
