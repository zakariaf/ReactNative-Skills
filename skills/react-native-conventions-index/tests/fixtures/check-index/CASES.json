  "bad-test-later-step": {
    "expect": [
      "[step-import-closure]",
      "src/feature/feature.ts (step 2, beta-two) arrives without its test: step 3 copies src/feature/feature.test.ts"
    ],
    "ops": [
      {
        "json": {
          "file": "skills/route-index/assets/index.json",
          "path": ["buildOrders", 0, "steps", 1, "copies"],
          "value": [{ "skill": "beta-two", "paths": ["src/feature/feature.ts", "src/feature/helper.ts"] }]
        }
      },
      {
        "json": {
          "file": "skills/route-index/assets/index.json",
          "path": ["buildOrders", 0, "steps", 2],
          "value": {
            "step": "The feature test",
