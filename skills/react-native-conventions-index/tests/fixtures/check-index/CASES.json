  "pass-app-skills": {
    "expect": [
      "installed mode: 2 of 3 listed skills installed, 1 other skill (the app's own, not checked)",
      "RESULT: PASS"
    ],
    "args": "{dir} --index {dir}/plugin/route-index",
    "ops": [
      { "rename": { "from": "skills/route-index", "to": "plugin/route-index" } },
      {
        "write": {
          "file": "skills/my-app-skill/SKILL.md",
          "content": "---\nname: my-app-skill\ndescription: The app's own skill. Use when the app needs it.\n---\n\n# My app skill\n"
        }
      }
    ]
  },
  "pass-installed": {
    "expect": [
      "installed mode: 2 of 3 listed skills installed, 1 other skill (the app's own, not checked)",
      "RESULT: PASS"
    ],
    "args": "{dir} --index {dir}/.agents/skills/route-index",
    "ops": [
      { "rename": { "from": "skills", "to": ".agents/skills" } },
      { "delete": ".agents/skills/beta-two" },
      {
        "write": {
          "file": ".agents/skills/my-app-skill/SKILL.md",
          "content": "---\nname: my-app-skill\ndescription: The app's own skill. Use when the app needs it.\n---\n\n# My app skill\n"
        }
      }
    ]
  },
  "pass-no-skills": {
    "expect": ["NOT APPLICABLE: no skills folder in", "RESULT: PASS"],
    "args": "{dir}/skills/alpha-one"
  },
  "pass-readme-catalogue": {
    "expect": ["library mode: 3 skills", "RESULT: PASS"],
    "ops": [
      {
        "write": {
          "file": "README.md",
          "content": "# Fixture library\n\n## The catalogue\n\n- `route-index`: routes tasks.\n- `alpha-one`: the alpha part.\n- `beta-two`: the beta part.\n\n## Commands\n\nRun build-index after a change.\n"
        }
      }
    ]
  }
