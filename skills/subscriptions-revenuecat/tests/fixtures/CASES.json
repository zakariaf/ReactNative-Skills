{
  "bad-sdk-outside-adapter": {
    "expect": ["[sdk-outside-adapter] imports react-native-purchases", "src/features/paywall/use-paywall-model.ts:2"],
    "ops": [
      {
        "write": {
          "file": "src/features/paywall/use-paywall-model.ts",
          "lines": [
            "// src/features/paywall/use-paywall-model.ts",
            "import Purchases from 'react-native-purchases';",
            "",
            "export const buyAnnual = async (): Promise<void> => {",
            "  const offerings = await Purchases.getOfferings();",
            "  const annual = offerings.current?.annual;",
            "  if (annual) await Purchases.purchasePackage(annual);",
            "};"
          ]
        }
      }
    ]
  },
