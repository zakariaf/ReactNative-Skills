        "replace": {
          "file": "server/src/quota/check-quota.ts",
          "find": "resolvePlan(await readEntitlement(userId), Date.now())",
          "with": "request.data.isPremium === true ? 'premium' : resolvePlan(await readEntitlement(userId), Date.now())"
        }
      },
      {
        "replace": {
          "file": "server/src/quota/check-quota.ts",
          "find": "{ readonly count: number }",
          "with": "{ readonly count: number; readonly isPremium?: boolean }"
        }
      }
    ]
  },
