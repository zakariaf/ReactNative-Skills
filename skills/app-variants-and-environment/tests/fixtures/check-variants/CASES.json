  "bad-variant-config-plugin-missing": {
    "expect": [
      "[variant-config] plugin \"expo-dev-client\" (every variant) comes from expo-dev-client, which is neither in package.json nor installed",
      "npx expo install expo-dev-client"
    ],
    "ops": [{ "json": { "file": "package.json", "path": ["dependencies", "expo-dev-client"], "delete": true } }]
  },
  "bad-variant-icon-copied": {
    "expect": ["[variant-icon] the development iOS icon files are byte-identical copies of production's"],
    "ops": [
      {
        "replace": {
          "file": "app.config.ts",
          "find": "const STORE_IOS_ICON = 'expo.icon';",
          "with": "const STORE_IOS_ICON = 'icon.png';"
        }
      },
      { "delete": "assets/icons/development/icon.png" },
      { "copy": { "from": "assets/icons/production/icon.png", "to": "assets/icons/development/icon.png" } }
    ]
  },
