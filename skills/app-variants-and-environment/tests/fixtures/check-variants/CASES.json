  "pass-multi-package-detected": {
    "expect": ["check-variants: 8 config evaluations checked, 0 problems"],
    "ops": [
      { "rename": { "from": "app.config.ts", "to": "apps/mobile/app.config.ts" } },
      { "rename": { "from": "eas.json", "to": "apps/mobile/eas.json" } },
      { "rename": { "from": "metro.config.js", "to": "apps/mobile/metro.config.js" } },
      { "rename": { "from": ".env.example", "to": "apps/mobile/.env.example" } },
      { "rename": { "from": "package.json", "to": "apps/mobile/package.json" } },
      { "rename": { "from": "src", "to": "apps/mobile/src" } },
      { "rename": { "from": "scripts", "to": "apps/mobile/scripts" } },
      { "rename": { "from": "assets", "to": "apps/mobile/assets" } },
      {
        "write": {
          "file": "package.json",
          "content": "{ \"name\": \"tasks-repo\", \"private\": true, \"workspaces\": [\"apps/*\"] }\n"
        }
      }
    ]
  },
  "pass-no-eas-json": {
    "expect": ["SKIP eas.json [eas-profile] not yet created (eas-build-and-submit creates it)"],
    "ops": [{ "delete": "eas.json" }]
  },
  "pass-not-expo": {
    "expect": ["NOT APPLICABLE: expo is not in package.json dependencies (not an Expo app)"],
    "ops": [{ "json": { "file": "package.json", "path": ["dependencies", "expo"], "delete": true } }]
  },
  "pass-submit-empty-production": {
    "expect": [
      "note: eas.json submit.production pins no ios.ascAppId or ios.bundleIdentifier and android.applicationId",
      "check-variants: 8 config evaluations checked, 0 problems"
    ],
    "ops": [{ "json": { "file": "eas.json", "path": ["submit", "production"], "value": {} } }]
  },
  "pass-submit-unpinned-note": {
    "expect": [
      "note: eas.json submit.production pins no ios.ascAppId or ios.bundleIdentifier and android.applicationId",
      "check-variants: 8 config evaluations checked, 0 problems"
