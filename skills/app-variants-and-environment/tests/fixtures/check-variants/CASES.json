        "delete": [
          "assets/icons/preview/android-foreground.png",
          "assets/icons/preview/android-background.png",
          "assets/icons/preview/android-monochrome.png"
        ]
      },
      {
        "copy": {
          "from": "assets/icons/production/android-foreground.png",
          "to": "assets/icons/preview/android-foreground.png"
        }
      },
      {
        "copy": {
          "from": "assets/icons/production/android-background.png",
          "to": "assets/icons/preview/android-background.png"
        }
      },
      {
        "copy": {
          "from": "assets/icons/production/android-monochrome.png",
          "to": "assets/icons/preview/android-monochrome.png"
        }
      }
    ]
  },
  "bad-variant-icon-missing": {
    "expect": [
      "FAIL assets/icons/preview/icon.png [variant-icon] icon of the preview variant names assets/icons/preview/icon.png, which does not exist: npx expo prebuild and EAS Build stop with ENOENT Fix: Draw the badged copies: make-variant-icons.mjs",
      "check-variants: 8 config evaluations checked, 1 problems"
    ],
    "ops": [{ "delete": "assets/icons/preview/icon.png" }]
  },
  "bad-variant-icon-missing-store": {
    "expect": [
      "FAIL assets/icons/production/android-background.png [variant-icon] android.adaptiveIcon.backgroundImage of the production variant names assets/icons/production/android-background.png, which does not exist: npx expo prebuild and EAS Build stop with ENOENT Fix: Move the app's store icon files into assets/icons/production/"
    ],
    "ops": [{ "delete": "assets/icons/production/android-background.png" }]
  },
  "bad-variant-icon-shared": {
    "expect": [
      "[variant-icon] development uses the production iOS icon",
      "[variant-icon] preview uses the production Android icon"
    ],
    "ops": [
      {
        "replace": {
          "file": "app.config.ts",
          "find": "const folder = `./assets/icons/${variant}`;",
          "with": "const folder = './assets/icons/production';"
        }
      },
      {
        "replace": {
          "file": "app.config.ts",
          "find": "ios: variant === 'production' ? `${folder}/${STORE_IOS_ICON}` : `${folder}/icon.png`,",
          "with": "ios: `${folder}/${STORE_IOS_ICON}`,"
        }
      }
    ]
  },
  "bad-variant-id-format": {
    "expect": ["[variant-id] android.package \"com.example.my-tasks\" (production) is not a valid Android package"],
    "ops": [
      {
        "replace": {
          "file": "app.config.ts",
          "find": "      package: identity.appId,",
          "with": "      package: identity.appId.replace('tasks', 'my-tasks'),"
        }
      }
    ]
  },
  "bad-variant-id-not-derived": {
    "expect": [
      "[variant-id] development Android package \"com.example.devtasks\" does not extend the production id \"com.example.tasks\" by one segment"
    ],
    "ops": [
      {
        "replace": {
          "file": "app.config.ts",
          "find": "      package: identity.appId,",
          "with": "      package: variant === 'development' ? 'com.example.devtasks' : identity.appId,"
        }
      }
    ]
  },
  "bad-variant-id-reserved": {
    "expect": [
      "[variant-id] android.package \"com.example.new\" (production) is not a valid Android package: \"new\" is a reserved Java keyword"
