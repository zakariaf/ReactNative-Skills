{
  "bad-config-throws-for-preview": {
    "expect": ["FAIL app.config.ts:1 [variant-config] app.config.ts fails for APP_VARIANT=preview: no preview icon set"],
    "ops": [
      {
        "replace": {
          "file": "app.config.ts",
          "find": "  const icons = iconsFor(variant);\n",
          "with": "  const icons = iconsFor(variant);\n  if (variant === 'preview') {\n    throw new Error('no preview icon set');\n  }\n"
        }
      }
    ]
  },
  "bad-eas-profile-base-conflict": {
    "expect": [
      "FAIL eas.json:6 [eas-profile] build.base (a shared base extended by development, preview, production): sets \"environment\": \"production\", but development builds development",
      "check-variants: 8 config evaluations checked, 1 problems"
    ],
    "ops": [
      {
        "write": {
          "file": "eas.json",
          "json": {
            "cli": { "version": ">= 24.10.0" },
            "build": {
              "base": { "node": "26.4.0", "environment": "production" },
              "development": {
                "extends": "base",
                "developmentClient": true,
                "distribution": "internal",
                "environment": "development",
                "env": { "APP_VARIANT": "development", "EXPO_PUBLIC_APP_VARIANT": "development" }
              },
              "preview": {
                "extends": "base",
                "distribution": "internal",
                "environment": "preview",
                "env": { "APP_VARIANT": "preview", "EXPO_PUBLIC_APP_VARIANT": "preview" }
              },
              "production": {
                "extends": "base",
                "env": { "APP_VARIANT": "production", "EXPO_PUBLIC_APP_VARIANT": "production" }
              }
            }
          }
        }
      }
    ]
  },
  "bad-eas-profile-dev-client": {
    "expect": ["[eas-profile] build.production: developmentClient is true in a production profile"],
    "ops": [{ "json": { "file": "eas.json", "path": ["build", "production", "developmentClient"], "value": true } }]
  },
  "bad-eas-profile-env": {
    "expect": ["[eas-profile] build.production: env.EXPO_PUBLIC_APP_VARIANT is null, expected \"production\""],
    "ops": [
      {
        "json": {
          "file": "eas.json",
          "path": ["build", "production", "env", "EXPO_PUBLIC_APP_VARIANT"],
          "delete": true
        }
      }
    ]
  },
  "bad-eas-profile-environment": {
    "expect": ["[eas-profile] build.preview: \"environment\" is \"production\", expected \"preview\""],
    "ops": [{ "json": { "file": "eas.json", "path": ["build", "preview", "environment"], "value": "production" } }]
  },
  "bad-eas-profile-missing": {
    "expect": ["[eas-profile] eas.json has no \"preview\" build profile"],
    "ops": [{ "json": { "file": "eas.json", "path": ["build", "preview"], "delete": true } }]
  },
  "bad-eas-profile-node-pin": {
    "expect": [
      "FAIL eas.json:7 [eas-profile] build.base pins Node 20.19.4: metro.config.js and app.config.ts load .ts files with Node's type stripping"
    ],
    "ops": [
      {
        "write": {
          "file": "eas.json",
          "json": {
            "cli": { "version": ">= 24.10.0" },
            "build": {
              "base": {
                "node": "20.19.4",
                "env": { "EXPO_PUBLIC_TASKS_API_URL": "https://api.tasks.test" },
                "ios": { "image": "latest" }
              },
              "development": {
                "extends": "base",
                "developmentClient": true,
                "distribution": "internal",
                "environment": "development",
                "env": { "APP_VARIANT": "development", "EXPO_PUBLIC_APP_VARIANT": "development" }
              },
              "preview": {
                "extends": "base",
                "distribution": "internal",
                "environment": "preview",
                "env": { "APP_VARIANT": "preview", "EXPO_PUBLIC_APP_VARIANT": "preview" }
              },
              "production": {
                "extends": "base",
                "environment": "production",
                "env": { "APP_VARIANT": "production", "EXPO_PUBLIC_APP_VARIANT": "production" }
              }
            }
          }
        }
      }
    ]
  },
  "bad-eas-profile-unnamed": {
    "expect": ["[eas-profile] build.simulator: sets no APP_VARIANT (directly or through extends)"],
    "ops": [
      { "json": { "file": "eas.json", "path": ["build", "simulator"], "value": { "ios": { "simulator": true } } } }
    ]
  },
  "bad-metro-missing": {
    "expect": ["FAIL metro.config.js [metro-cache-key] no metro.config.js"],
    "ops": [{ "delete": "metro.config.js" }]
  },
  "bad-metro-no-cache-version": {
    "expect": ["FAIL metro.config.js:1 [metro-cache-key] metro.config.js does not set cacheVersion"],
    "ops": [
      {
        "replace": {
          "file": "metro.config.js",
          "find": "config.cacheVersion = publicEnvCacheVersion(process.env);\n",
          "with": ""
        }
      }
    ]
  },
  "bad-metro-same-per-variant": {
    "expect": [
      "FAIL metro.config.js:20 [metro-cache-key] cacheVersion is",
      "for every variant: a production export reuses the development transforms"
    ],
    "ops": [
      {
        "replace": {
          "file": "metro.config.js",
          "find": "config.cacheVersion = publicEnvCacheVersion(process.env);",
          "with": "config.cacheVersion = publicEnvCacheVersion({ ...process.env, EXPO_PUBLIC_APP_VARIANT: undefined });"
        }
      }
    ]
  },
  "bad-metro-unkeyed": {
    "expect": ["[metro-cache-key] cacheVersion is not derived from the EXPO_PUBLIC_* values"],
    "ops": [
      {
        "replace": {
          "file": "metro.config.js",
          "find": "config.cacheVersion = publicEnvCacheVersion(process.env);",
          "with": "config.cacheVersion = '1.0';"
        }
      }
    ]
  },
  "bad-metro-variant-only": {
    "expect": [
      "[metro-cache-key] cacheVersion is not derived from the EXPO_PUBLIC_* values: it stays \"production\" when only EXPO_PUBLIC_RNSKILLS_PROBE changes"
    ],
    "ops": [
      {
        "replace": {
          "file": "metro.config.js",
          "find": "config.cacheVersion = publicEnvCacheVersion(process.env);",
          "with": "config.cacheVersion = process.env.EXPO_PUBLIC_APP_VARIANT ?? 'development';"
        }
      }
    ]
  },
  "bad-secret-config-extra": {
    "expect": [
      "[secret-config] extra.signingKey looks like a secret",
      "[secret-config] extra.signingKey holds a PEM private key"
    ],
    "ops": [
      {
        "replace": {
          "file": "app.config.ts",
          "find": "    experiments: { typedRoutes: true, reactCompiler: true },\n",
          "with": "    experiments: { typedRoutes: true, reactCompiler: true },\n    extra: { signingKey: '-----BEGIN PRIVATE XKEY-----\\nMIIBVQ\\n-----END PRIVATE XKEY-----' },\n"
        }
      },
      { "replace": { "file": "app.config.ts", "find": "PRIVATE XKEY", "with": "PRIVATE KEY", "all": true } }
    ]
  },
  "bad-secret-config-llm": {
    "expect": ["[secret-config] the value of OPENAI_API_KEY reaches extra.aiKey in the public config"],
    "ops": [
      {
        "replace": {
          "file": "app.config.ts",
          "find": "    experiments: { typedRoutes: true, reactCompiler: true },\n",
          "with": "    experiments: { typedRoutes: true, reactCompiler: true },\n    extra: { aiKey: process.env['OPENAI_API_KEY'] },\n"
        }
      }
    ]
  },
  "bad-secret-config-plugin": {
    "expect": ["[secret-config] the value of SENTRY_AUTH_TOKEN reaches plugins[1][1].authToken in the public config"],
    "ops": [
      {
        "replace": {
          "file": "app.config.ts",
          "find": "    'expo-router',\n",
          "with": "    'expo-router',\n    ['@sentry/react-native/expo', { organization: 'tasks', authToken: process.env['SENTRY_AUTH_TOKEN'] }],\n"
        }
      },
      { "json": { "file": "package.json", "path": ["dependencies", "@sentry/react-native"], "value": "~7.11.0" } }
    ]
  },
  "bad-variant-config": {
    "expect": ["FAIL app.json:1 [variant-config] app.json sits beside app.config.ts"],
    "ops": [{ "write": { "file": "app.json", "content": "{ \"expo\": { \"name\": \"Tasks\" } }\n" } }]
  },
  "bad-variant-config-local-plugin": {
    "expect": ["[variant-config] plugin \"./plugins/with-tasks-widget.js\" (every variant) does not exist"],
    "ops": [
