          "find": "  appId: 'com.example.tasks',",
          "with": "  appId: 'com.example.new',"
        }
      }
    ]
  },
  "bad-variant-id-shared": {
    "expect": [
      "[variant-id] development uses the production iOS bundle identifier \"com.example.tasks\"",
      "[variant-id] preview uses the production iOS bundle identifier \"com.example.tasks\""
    ],
    "ops": [
      {
        "replace": {
          "file": "app.config.ts",
          "find": "ios: { bundleIdentifier: identity.appId,",
          "with": "ios: { bundleIdentifier: BASE.appId,"
        }
      }
    ]
  },
  "bad-variant-name": {
    "expect": ["[variant-name] development and production are both named \"Tasks\""],
    "ops": [
      { "replace": { "file": "app.config.ts", "find": "    name: identity.name,", "with": "    name: BASE.name," } }
    ]
  },
  "bad-variant-name-marker": {
    "expect": ["[variant-name] the production name \"Tasks (Dev)\" carries a testing marker"],
    "ops": [
      {
        "replace": {
          "file": "app.config.ts",
          "find": "    name: identity.name,",
          "with": "    name: variant === 'production' ? 'Tasks (Dev)' : identity.name,"
        }
      }
    ]
  },
  "bad-variant-resolve-committed-env": {
    "expect": [
      "[variant-resolve] with no variant exported locally the config builds com.example.tasks / com.example.tasks / Tasks, not the development variant: .env sets the variant, and Expo CLI loads it for start, export and prebuild",
      "Fix: Remove APP_VARIANT and EXPO_PUBLIC_APP_VARIANT from .env"
    ],
    "ops": [
      { "replace": { "file": ".gitignore", "find": ".env*\n", "with": ".env*.local\n" } },
      { "write": { "file": ".env", "content": "APP_VARIANT=production\nEXPO_PUBLIC_APP_VARIANT=production\n" } }
    ]
  },
  "bad-variant-resolve-lenient": {
    "expect": [
      "[variant-resolve] the config evaluates with APP_VARIANT=staging (an unknown name)",
      "[variant-resolve] the config evaluates with APP_VARIANT=production without EXPO_PUBLIC_APP_VARIANT"
    ],
    "ops": [
      {
        "replace": {
          "file": "app.config.ts",
          "find": "const variant = resolveAppVariant(process.env);",
          "with": "const variant = (process.env['APP_VARIANT'] ?? 'development') as AppVariant;"
        }
      }
    ]
  },
  "bad-variant-resolve-local-default": {
    "expect": [
      "[variant-resolve] with no variant set locally the config builds com.example.tasks / com.example.tasks / Tasks, not the development variant"
    ],
    "ops": [
      {
        "replace": {
          "file": "src/config/app-variant.ts",
          "find": "    return 'development';",
          "with": "    return 'production';"
        }
      }
    ]
  },
  "bad-variant-resolve-mismatch": {
    "expect": [
      "FAIL app.config.ts:75 [variant-resolve] the config evaluates with APP_VARIANT=production without EXPO_PUBLIC_APP_VARIANT: the JS bundle would believe it is a development build"
    ],
    "ops": [
      {
        "replace": {
          "file": "src/config/app-variant.ts",
          "find": "if (forConfig !== forBundle) {",
          "with": "if (forConfig === undefined && forBundle !== undefined) {"
        }
      }
    ]
  },
  "bad-variant-resolve-unset": {
    "expect": [
      "[variant-resolve] the config evaluates with no variant in a production bundle (NODE_ENV=production: expo export, eas update)",
      "[variant-resolve] the config evaluates with no variant on an EAS Build worker (EAS_BUILD=true)"
    ],
    "ops": [
      {
        "replace": {
          "file": "src/config/app-variant.ts",
          "find": "if (needsExplicitVariant(env)) {",
          "with": "if (env['FORCE_EXPLICIT_VARIANT'] === 'yes') {"
        }
      }
    ]
  },
  "bad-variant-scheme": {
    "expect": [
      "[variant-scheme] the URL scheme \"acmetasks\" is registered by both development and production",
      "Fix: Give every variant its own scheme: acmetasks-dev, acmetasks-preview, acmetasks (variantIdentity does)."
    ],
    "ops": [
      {
        "replace": {
          "file": "app.config.ts",
          "find": "    scheme: identity.scheme,",
          "with": "    scheme: BASE.scheme,"
        }
      },
      { "replace": { "file": "app.config.ts", "find": "  scheme: 'tasks',", "with": "  scheme: 'acmetasks'," } }
    ]
  },
  "bad-variant-scheme-dev-client": {
    "expect": [
      "[variant-scheme] production registers the dev client's generated exp+<slug> scheme",
      "[variant-scheme] preview registers the dev client's generated exp+<slug> scheme"
    ],
    "ops": [
      {
        "replace": {
          "file": "app.config.ts",
          "find": "addGeneratedScheme: variant === 'development'",
          "with": "addGeneratedScheme: true"
        }
      }
    ]
  },
  "error-bad-eas-json": {
    "expect": ["ERROR [bad-input] eas.json is not valid JSON"],
    "ops": [{ "write": { "file": "eas.json", "content": "{ \"build\": \n" } }]
  },
  "error-no-app-config": {
    "expect": ["ERROR [bad-input] nothing to check: no app config"],
    "ops": [{ "delete": "app.config.ts" }]
  },
  "error-two-apps-no-app-dir": {
