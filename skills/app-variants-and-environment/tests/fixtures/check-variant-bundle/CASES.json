{
  "bad-secret-env-file": {
    "expect": ["[bundle-secret] the bundle contains the value of SENTRY_AUTH_TOKEN (from .env.production.local)"],
    "args": "{dir} --bundle dist/variant-proof/production --variant production --env-file .env.production.local",
    "ops": [
      {
        "write": {
          "file": ".env.production.local",
          "content": "SENTRY_AUTH_TOKEN=tok-0123456789abcdef\nEXPO_PUBLIC_TASKS_API_URL=https://api.example.com\n"
        }
      },
      {
        "replace": {
          "file": "dist/variant-proof/production/_expo/static/js/ios/entry-5f0c1e9a.js",
          "find": "e.title=\"Tasks\"",
          "with": "e.title=\"Tasks\";e.t=\"tok-0123456789abcdef\""
        }
      }
    ]
  },
  "bad-secret-in-hermes-bytecode": {
