    "args": "{dir} --bundle dist/variant-proof/hbc --variant production",
    "ops": [
      {
        "write": {
          "file": "dist/variant-proof/hbc/_expo/static/js/ios/entry-77aa.hbc",
          "base64": "xh+8A8EDGcgAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAABwcm9kdWN0aW9uAFRBU0tTX1RFU1RfQlVJTERfT05MWQAAAQI="
        }
      }
    ]
