  "bad-sentinel-in-production": {
    "expect": [
      "FAIL dist/variant-proof/production/_expo/static/js/ios/entry-5f0c1e9a.js:1 [bundle-sentinel] the production bundle contains the test-only sentinel \"TASKS_TEST_BUILD_ONLY\""
    ],
    "ops": [
      {
        "replace": {
          "file": "dist/variant-proof/production/_expo/static/js/ios/entry-5f0c1e9a.js",
          "find": "var t=null;",
          "with": "var t={s:\"TASKS_TEST_BUILD_ONLY\"};"
