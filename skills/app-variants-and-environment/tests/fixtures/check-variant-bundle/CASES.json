          "content": "Æ\u001f¼\u0003\u0000\u0000\u0000\u0000production\u0000Tasks\u0000passed to VirtualizedList._createRenderMask-pXroj-Rn5kRn5kRn5k0000aaaa1111bbbbatchedUpdatesImpl\u0000\u0001\u0002"
        }
      },
      {
        "replace": {
          "file": "dist/variant-proof/production/_expo/static/js/ios/entry-packed.hbc",
          "find": "Mask-pXroj-",
          "with": "Mask-proj-"
        }
      }
    ]
  },
