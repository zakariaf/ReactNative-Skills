  "bad-sentinel-missing-in-development": {
    "expect": [
      "FAIL dist/variant-proof/development [bundle-sentinel] the development bundle lacks the test-only sentinel \"TASKS_TEST_BUILD_ONLY\""
    ],
    "args": "{dir} --bundle dist/variant-proof/development --variant development",
    "ops": [
      {
        "replace": {
          "file": "dist/variant-proof/development/_expo/static/js/ios/entry-91b2d7c4.js",
          "find": "e.TEST_BUILD_SENTINEL=\"TASKS_TEST_BUILD_ONLY\"",
          "with": "e.debug=null"
        }
      }
    ]
  },
  "bad-sentinel-outside-src-in-production": {
    "expect": [
      "FAIL dist/variant-proof/production/_expo/static/js/ios/entry-5f0c1e9a.js:2 [bundle-sentinel] the production bundle contains the test-only sentinel \"TASKS_DEV_TOOLS_ONLY\""
    ],
    "ops": [
      { "rename": { "from": "src/app", "to": "app" } },
      { "delete": ["src/test-only.ts", "src/test-only-entry.ts"] },
      {
        "replace": {
          "file": "src/features/tasks/use-tasks-model.ts",
          "find": "import { TEST_ONLY } from '@/test-only';\n",
          "with": ""
        }
      },
      {
        "replace": {
          "file": "src/features/tasks/use-tasks-model.ts",
          "find": "  TEST_ONLY?.recordScreen('tasks');\n",
          "with": ""
        }
      },
      {
        "write": {
          "file": "app/_layout.tsx",
          "content": "// app/_layout.tsx\nimport { Stack } from 'expo-router';\n\nconst DEV_TOOLS: unknown = process.env.EXPO_PUBLIC_APP_VARIANT === 'production' ? null : require('../dev/dev-tools');\n\nexport default function RootLayout(): React.JSX.Element {\n  void DEV_TOOLS;\n  return <Stack />;\n}\n"
        }
      },
      {
        "write": { "file": "dev/dev-tools.ts", "content": "// dev/dev-tools.ts\nexport function resetAll(): void {}\n" }
      },
      {
        "replace": {
          "file": "dev/dev-tools.ts",
          "find": "export function resetAll(): void {}\n",
          "with": "export function resetAll(): void {}\n\nexport const DEV_TOOLS_SENTINEL = 'TASKS_DEV_TOOLS_ONLY';\n"
        }
      },
      {
        "replace": {
          "file": "dist/variant-proof/production/_expo/static/js/ios/entry-5f0c1e9a.js",
          "find": "e.title=\"Tasks\"",
          "with": "e.title=\"Tasks\";e.s=\"TASKS_DEV_TOOLS_ONLY\""
        }
      }
    ]
  },
  "bad-sentinel-unknown": {
    "expect": [
      "FAIL src/test-only.ts:1 [bundle-sentinel] src/test-only.ts gates test-only code, but no test-only sentinel is known: the bundle proof cannot tell whether that code shipped"
    ],
    "ops": [{ "delete": "src/test-only-entry.ts" }]
  },
