{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "types": ["jest", "node"],
    "paths": {
      "@/*": ["./src/*"],
      "@test/*": ["./test/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"],
  "exclude": [
    "node_modules",
    "ios",
    "android",
    "build",
    "dist",
    "web-build",
    "coverage",
    "reports",
    ".stryker-tmp",
    ".skill-tooling",
    "skills",
    "expo-env.d.ts",
    "src/app-env.d.ts"
  ]
}
