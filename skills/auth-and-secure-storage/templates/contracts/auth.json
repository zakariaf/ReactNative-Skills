{
  "$schema": "./auth.schema.json",
  "$comment": "The app's sign-in facts, read by auth-and-secure-storage's check-auth.mjs. Edit them for this app; the checker stays strict.",
  "sessionFactory": "createSessionManager",
  "protectedGroups": ["(app)"],
  "signedOutRoutes": ["sign-in"],
  "signOutSteps": ["query-cache"],
  "serverSignOutSteps": [],
  "createsAccounts": true,
  "accountDeletionRoute": "src/app/(app)/delete-account.tsx",
  "oauthSharedBrowserSession": null,
  "customAndroidBackupRules": null
}
