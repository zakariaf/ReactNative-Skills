          "src/services/create-device-services.ts",
          "src/services/services-context.tsx",
          "test/session"
        ]
      },
      {
        "replace": {
          "file": "src/services/secure-storage/secure-key-names.ts",
          "find": "export const SECURE_KEYS = {",
          "with": "export const SECURE_KEYS = {\n  /** The person's own API key for the sync service (bring your own key). */\n  apiKey: 'sync.api-key',"
        }
      },
      {
        "write": {
          "file": "contracts/auth.json",
          "lines": ["{", "  \"$schema\": \"./auth.schema.json\",", "  \"signIn\": false", "}"]
        }
      },
      {
        "write": {
          "file": "src/services/secure-storage/wipe-secrets-on-fresh-install.ts",
          "lines": [
            "// src/services/secure-storage/wipe-secrets-on-fresh-install.ts: the secrets-only fresh-install wipe.",
            "import { ALL_SECURE_KEYS } from './secure-key-names';",
            "",
            "import type { SecureStoragePort } from './secure-storage-port';",
            "import type { InstallMarkerPort } from '@/services/install-marker/install-marker-port';",
            "",
            "export async function wipeSecretsOnFreshInstall(",
            "  secureStorage: SecureStoragePort,",
            "  installMarker: InstallMarkerPort,",
            "): Promise<void> {",
            "  const marker = installMarker.isPresent();",
            "  if (!marker.ok || marker.value) return;",
            "  for (const key of ALL_SECURE_KEYS) {",
            "    const removed = await secureStorage.remove(key);",
            "    if (!removed.ok) return;",
            "  }",
            "  installMarker.write();",
            "}"
          ]
        }
      }
    ]
  },
  "pass-token-refresher": {
    "expect": ["check-auth:", "RESULT: PASS"],
    "ops": [
      {
        "write": {
          "file": "src/api/auth/server-token-refresher.ts",
          "lines": [
            "// src/api/auth/server-token-refresher.ts: the app server's refresh endpoint as the session's TokenRefresher.",
            "import { err, ok } from '@/core/result';",
            "",
            "import type { TokenRefresher } from '@/services/session/session-types';",
            "",
            "export function createServerTokenRefresher(baseUrl: string): TokenRefresher {",
            "  const refresher: TokenRefresher = {",
            "    refresh: async (refreshToken) => {",
            "      const answer = await fetch(`${baseUrl}/auth/refresh`, { method: 'POST', body: JSON.stringify({ refresh_token: refreshToken }) });",
            "      return answer.ok ? ok({ accessToken: 'from-body' }) : err({ kind: 'network-unavailable' });",
            "    },",
            "  };",
            "  return refresher;",
            "}"
          ]
        }
      }
    ]
  }
