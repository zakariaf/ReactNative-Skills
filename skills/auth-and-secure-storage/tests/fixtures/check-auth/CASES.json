      {
        "write": {
          "file": "contracts/auth.json",
          "lines": ["{", "  \"$schema\": \"./auth.schema.json\",", "  \"signIn\": false", "}"]
        }
      },
      {
        "write": {
          "file": "src/services/secure-storage/wipe-secrets-on-fresh-install.ts",
          "lines": [
            "// src/services/secure-storage/wipe-secrets-on-fresh-install.ts: the secrets-only fresh-install wipe.",
            "import { ALL_SECURE_KEYS } from './secure-key-names';",
            "",
            "import type { SecureStoragePort } from './secure-storage-port';",
            "import type { InstallMarkerPort } from '@/services/install-marker/install-marker-port';",
            "",
            "export async function wipeSecretsOnFreshInstall(",
            "  secureStorage: SecureStoragePort,",
            "  installMarker: InstallMarkerPort,",
            "): Promise<void> {",
            "  const marker = installMarker.isPresent();",
            "  if (!marker.ok || marker.value) return;",
            "  for (const key of ALL_SECURE_KEYS) {",
            "    const removed = await secureStorage.remove(key);",
            "    if (!removed.ok) return;",
            "  }",
            "  installMarker.write();",
            "}"
          ]
        }
      },
      { "delete": "src/services/secure-storage/wipe-secrets-on-fresh-install.ts" }
    ]
  },
