    "expect": ["check-auth:", "RESULT: PASS"],
    "ops": [
      {
        "$comment": "Secrets only: an app that keeps an API key in expo-secure-store and has no sign-in (the session, OAuth, Apple and the examples are gone).",
        "delete": [
          "src/api",
          "src/app/oauth-redirect.tsx",
