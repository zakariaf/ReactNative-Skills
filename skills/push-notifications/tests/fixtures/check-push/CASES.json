          "lines": [
            "// src/services/create-local-services.ts",
            "import { createExpoLocalNotificationsAdapter } from '@/services/local-notifications/expo-local-notifications-adapter';",
            "",
            "/** The composition root hands the foreground handler to the push adapter. */",
            "export function createLocalServices(): void {",
            "  createExpoLocalNotificationsAdapter({ installForegroundHandler: false });",
            "}"
          ]
