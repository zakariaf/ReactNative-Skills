{
  "bad-adapter-only": {
    "expect": [
      "src/features/share-list/use-badge-model.ts:6 [push-adapter-only]",
      "getPermissionsAsync from expo-notifications outside the push adapter"
    ],
    "ops": [
      {
        "write": {
          "file": "src/features/share-list/use-badge-model.ts",
          "lines": [
            "// src/features/share-list/use-badge-model.ts",
            "import { getPermissionsAsync } from 'expo-notifications';",
            "",
            "/** Reads the permission straight from the SDK instead of the port. */",
            "export async function isPushOn(): Promise<boolean> {",
            "  const status = await getPermissionsAsync();",
            "  return status.granted;",
            "}"
          ]
        }
      }
    ]
  },
