        "write": {
          "file": "src/features/task-photo/use-task-photo-model.ts",
          "lines": [
            "// src/features/task-photo/use-task-photo-model.ts",
            "// Camera and photo-library asks in effects are not notification prompts: permission-in-context stays silent.",
            "import { useCameraPermissions } from 'expo-camera';",
            "import * as MediaLibrary from 'expo-media-library';",
            "import { useEffect } from 'react';",
            "",
            "export function useTaskPhotoModel(): void {",
            "  const [, requestPermission] = useCameraPermissions();",
            "  useEffect(() => {",
            "    requestPermission().catch(() => undefined);",
            "    MediaLibrary.requestPermissionsAsync().catch(() => undefined);",
            "  }, [requestPermission]);",
            "}"
          ]
        }
      }
    ]
