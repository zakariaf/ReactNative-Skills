  "pass-local-handler-disabled": {
    "expect": ["RESULT: PASS"],
    "ops": [
      {
        "write": {
          "file": "src/services/local-notifications/expo-local-notifications-adapter.ts",
          "lines": [
            "// src/services/local-notifications/expo-local-notifications-adapter.ts",
            "import { setNotificationHandler } from 'expo-notifications';",
            "",
            "export type LocalAdapterOptions = { readonly installForegroundHandler?: boolean };",
            "",
            "/** local-notifications' adapter, copied unedited: its handler is guarded by the option. */",
            "export function createExpoLocalNotificationsAdapter({ installForegroundHandler = true }: LocalAdapterOptions): void {",
            "  if (installForegroundHandler) {",
            "    setNotificationHandler({",
            "      handleNotification: () =>",
            "        Promise.resolve({ shouldShowBanner: true, shouldShowList: true, shouldPlaySound: true, shouldSetBadge: false }),",
            "    });",
            "  }",
            "}"
