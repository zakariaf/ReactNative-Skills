        "lines": [
          "// src/services/auth/secure-token-store.ts: expo-secure-store has no whole-store clear, so its own clearAll is safe.",
          "import * as SecureStore from 'expo-secure-store';",
          "",
          "const KEYS = ['access-token', 'refresh-token'] as const;",
          "",
          "class SecureTokenStore {",
          "  clearAll(): void {",
          "    for (const key of KEYS) void SecureStore.deleteItemAsync(key);",
          "  }",
          "}",
          "",
          "export const tokenStore = new SecureTokenStore();",
          "export const signOut = (): void => {",
          "  tokenStore.clearAll();",
          "};"
        ]
      }
