      {
        "write": {
          "file": "src/features/preferences/use-data-resets.ts",
          "lines": [
            "// src/features/preferences/use-data-resets.ts: the confirmed reset is one write, then every store re-reads.",
            "import { err, ok } from '@/core/result';",
            "import { resetAllProgress } from '@/data/document/reset-document';",
            "import { updateAndPublish } from '@/stores/update-and-publish';",
            "",
            "import type { Result } from '@/core/result';",
            "import type { DocumentService } from '@/data/document/document-service';",
            "import type { Stores } from '@/stores/stores-context';",
            "",
            "export type ProgressResetFailure = { readonly kind: 'progress-not-reset' };",
            "",
            "export function createDataResets(documents: DocumentService, stores: Stores) {",
            "  return {",
            "    onConfirmResetProgress: (): Result<void, ProgressResetFailure> =>",
            "      updateAndPublish(stores, () =>",
            "        documents.update(resetAllProgress, { refreshBackup: true })",
            "          ? ok(undefined)",
            "          : err({ kind: 'progress-not-reset' }),",
            "      ),",
            "  };",
            "}"
          ]
        }
      },
      {
        "write": {
          "file": "src/stores/app-settings/app-settings-reducer.ts",
          "lines": [
            "// src/stores/app-settings/app-settings-reducer.ts",
            "import type { AppSettings } from '@/data/document/schema/app-document';",
            "",
            "export type AppSettingsAction =",
            "  | { readonly type: 'set-theme'; readonly theme: AppSettings['theme'] }",
            "  | { readonly type: 'set-language'; readonly language: AppSettings['language'] }",
            "  | { readonly type: 'set-reminder-hour'; readonly hour: number }",
            "  | { readonly type: 'set-sound'; readonly isOn: boolean }",
            "  | { readonly type: 'set-reduce-motion'; readonly reduceMotion: AppSettings['reduceMotion'] }",
            "  | { readonly type: 'set-text-scale'; readonly scale: number };",
            "",
            "const clampTextScale = (scale: number): number => Math.min(200, Math.max(100, Math.round(scale)));",
            "",
            "export function appSettingsReducer(settings: AppSettings, action: AppSettingsAction): AppSettings {",
            "  switch (action.type) {",
            "    case 'set-theme':",
            "      return { ...settings, theme: action.theme };",
            "    case 'set-language':",
            "      return { ...settings, language: action.language };",
            "    case 'set-reminder-hour':",
            "      return { ...settings, reminderHour: action.hour };",
            "    case 'set-sound':",
            "      return { ...settings, soundEnabled: action.isOn };",
            "    case 'set-reduce-motion':",
            "      return { ...settings, reduceMotion: action.reduceMotion };",
            "    case 'set-text-scale':",
            "      return { ...settings, textScale: clampTextScale(action.scale) };",
            "  }",
            "}"
          ]
        }
      },
      {
        "write": {
          "file": "src/stores/app-settings/app-settings-store.ts",
          "lines": [
            "// src/stores/app-settings/app-settings-store.ts: reduce, documents.update (one transaction), then publish.",
            "import { createStore } from 'zustand/vanilla';",
            "",
            "import { appSettingsReducer } from './app-settings-reducer';",
            "",
            "import type { AppSettingsAction } from './app-settings-reducer';",
            "import type { DocumentService } from '@/data/document/document-service';",
            "import type { AppSettings } from '@/data/document/schema/app-document';",
            "",
            "export type AppSettingsState = {",
            "  readonly settings: AppSettings;",
            "  readonly dispatch: (action: AppSettingsAction) => void;",
            "};",
            "",
            "export function createAppSettingsStore(documents: DocumentService) {",
            "  return createStore<AppSettingsState>()((set, get) => ({",
            "    settings: documents.doc().settings,",
            "    dispatch: (action) => {",
            "      const next = appSettingsReducer(get().settings, action);",
            "      if (next === get().settings) return;",
            "      documents.update((doc) => ({ ...doc, settings: next }));",
            "      set({ settings: next });",
            "    },",
            "  }));",
            "}"
          ]
        }
      }
    ]
