            "export function createPreferenceHandlers(dispatch: (action: AppSettingsAction) => void) {",
            "  return {",
            "    onSelectTheme: (theme: 'system' | 'light' | 'dark') => dispatch({ type: 'set-theme', theme }),",
            "    onSelectLanguage: (language: string | null) => dispatch({ type: 'set-language', language }),",
            "    onSelectReminderHour: (hour: number) => dispatch({ type: 'set-reminder-hour', hour }),",
            "    onToggleSound: (isOn: boolean) => dispatch({ type: 'set-sound', isOn }),",
            "    onToggleReduceMotion: (isOn: boolean) =>",
            "      dispatch({ type: 'set-reduce-motion', reduceMotion: isOn ? 'on' : 'off' }),",
            "    onChangeTextScale: (scale: number) => dispatch({ type: 'set-text-scale', scale }),",
