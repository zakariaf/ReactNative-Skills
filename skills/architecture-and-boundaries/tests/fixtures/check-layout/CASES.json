          "file": "src/services/error-net/error-net.ts",
          "lines": [
            "// The error net: global handlers buffer reports until a sink connects (no SDK, so no port triple).",
            "export type ErrorReport = { readonly source: 'global-handler' | 'unhandled-rejection' | 'render'; readonly error: unknown };",
            "",
            "export function createErrorNet(): { readonly report: (report: ErrorReport) => void; readonly pending: () => readonly ErrorReport[] } {",
            "  const buffered: ErrorReport[] = [];",
            "  return { report: (report) => void buffered.push(report), pending: () => [...buffered] };",
            "}"
          ]
        }
      }
    ]
