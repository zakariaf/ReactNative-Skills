{
  "$description": "Design tokens of the app (demo values of a Tasks app). Tier 1 primitives are named by measured OKLCH lightness x 100; tier 2 roles reference them as {color.primitive.<hue>.<lightness>}. Replace the values, keep the shape: the theme modules and the palette are compared with this file. \"components\" is the optional component tier ui-component-library builds from (its component-specs.json); drop it when the app has no component library.",
  "color": {
    "primitive": {
      "neutral": {
        "18": "#0F1115",
        "20": "#15171C",
        "23": "#1A1D23",
        "46": "#525866",
        "60": "#7A8190",
        "75": "#A8AFBB",
        "95": "#EBEDF1",
        "97": "#F5F6F8",
        "100": "#FFFFFF"
      },
      "blue": { "45": "#1C4DB5", "49": "#2156C8", "77": "#8AB4FF", "83": "#A8C7FF" },
      "red": { "26": "#3A1715", "50": "#B42318", "76": "#FF8A80", "96": "#FDECEA" },
      "green": { "45": "#13682C", "80": "#6FD691" },
      "amber": { "49": "#8A5300", "82": "#F5B94A" }
    },
    "light": {
      "background": "{color.primitive.neutral.97}",
      "surface": "{color.primitive.neutral.100}",
      "sunken": "{color.primitive.neutral.95}",
      "text": "{color.primitive.neutral.20}",
      "textMuted": "{color.primitive.neutral.46}",
      "primary": "{color.primitive.blue.49}",
      "onPrimary": "{color.primitive.neutral.100}",
      "border": "{color.primitive.neutral.60}",
      "separator": "#15171C1F",
      "shadow": "#15171C33",
      "focus": "{color.primitive.blue.45}",
      "danger": "{color.primitive.red.50}",
      "dangerSurface": "{color.primitive.red.96}",
      "success": "{color.primitive.green.45}",
      "warning": "{color.primitive.amber.49}",
      "scrim": "#0F111599"
    },
    "dark": {
      "background": "{color.primitive.neutral.18}",
      "surface": "{color.primitive.neutral.23}",
      "sunken": "{color.primitive.neutral.20}",
      "text": "{color.primitive.neutral.97}",
      "textMuted": "{color.primitive.neutral.75}",
      "primary": "{color.primitive.blue.77}",
      "onPrimary": "{color.primitive.neutral.18}",
      "border": "{color.primitive.neutral.60}",
      "separator": "#F5F6F824",
      "shadow": "#00000066",
      "focus": "{color.primitive.blue.83}",
      "danger": "{color.primitive.red.76}",
      "dangerSurface": "{color.primitive.red.26}",
      "success": "{color.primitive.green.80}",
      "warning": "{color.primitive.amber.82}",
      "scrim": "#000000B3"
    }
  },
  "spacing": { "none": 0, "xxs": 2, "xs": 4, "sm": 8, "md": 12, "lg": 16, "xl": 24, "xxl": 32 },
  "radius": { "sm": 6, "md": 10, "lg": 16 },
  "stroke": { "hair": 1, "regular": 2, "bold": 3 },
  "elevation": { "flat": 0, "raised": 2, "control": 4, "overlay": 8 },
  "size": { "minTouch": 44, "contentMaxWidth": 640 },
  "type": {
    "roles": {
      "display": {
        "fontSize": 34,
        "weight": "bold",
        "face": "display",
        "lineHeight": { "base": 1.15, "tall": 1.5 }
      },
      "title": {
        "fontSize": 28,
        "weight": "bold",
        "face": "display",
        "lineHeight": { "base": 1.2, "tall": 1.5 }
      },
      "heading": {
        "fontSize": 20,
        "weight": "bold",
        "face": "display",
        "lineHeight": { "base": 1.25, "tall": 1.55 }
      },
      "body": {
        "fontSize": 17,
        "weight": "regular",
        "face": "text",
        "lineHeight": { "base": 1.32, "tall": 1.5 }
      },
      "label": {
        "fontSize": 17,
        "weight": "bold",
        "face": "text",
        "lineHeight": { "base": 1.25, "tall": 1.5 }
      },
      "caption": {
        "fontSize": 13,
        "weight": "regular",
        "face": "text",
        "lineHeight": { "base": 1.4, "tall": 1.6 }
      },
      "number": {
        "fontSize": 28,
        "weight": "bold",
        "face": "display",
        "lineHeight": { "base": 1.15, "tall": 1.5 },
        "isTabular": true
      }
    },
    "styles": {
      "brandName": {
        "fontSize": 22,
        "weight": "bold",
        "face": "brand",
        "lineHeight": { "base": 1.1, "tall": 1.1 },
        "letterSpacingEm": 0.01
      },
      "screenTitle": {
        "fontSize": 28,
        "weight": "bold",
        "face": "display",
        "lineHeight": { "base": 1.2, "tall": 1.5 }
      },
      "sectionHeading": {
        "fontSize": 20,
        "weight": "bold",
        "face": "display",
        "lineHeight": { "base": 1.25, "tall": 1.55 }
      },
      "rowLabel": {
        "fontSize": 17,
        "weight": "regular",
        "face": "text",
        "lineHeight": { "base": 1.32, "tall": 1.5 }
      },
      "rowLabelStrong": {
        "fontSize": 17,
        "weight": "bold",
        "face": "text",
        "lineHeight": { "base": 1.32, "tall": 1.5 }
      },
      "rowDescription": {
        "fontSize": 14,
        "weight": "regular",
        "face": "text",
        "lineHeight": { "base": 1.3, "tall": 1.5 }
      },
      "buttonLabel": {
        "fontSize": 17,
        "weight": "bold",
        "face": "text",
        "lineHeight": { "base": 1.25, "tall": 1.5 }
      },
      "badge": {
        "fontSize": 12,
        "weight": "bold",
        "face": "text",
        "lineHeight": { "base": 1.3, "tall": 1.45 }
      },
      "statValue": {
        "fontSize": 30,
        "weight": "bold",
        "face": "display",
        "lineHeight": { "base": 1.1, "tall": 1.45 },
        "isTabular": true
      },
      "statLabel": {
        "fontSize": 13,
        "weight": "regular",
        "face": "text",
        "lineHeight": { "base": 1.4, "tall": 1.6 }
      },
      "toast": {
        "fontSize": 15,
        "weight": "regular",
        "face": "text",
        "lineHeight": { "base": 1.35, "tall": 1.55 }
      }
    }
  },
  "motion": {
    "duration": {
      "pressIn": 70,
      "fast": 120,
      "standard": 240,
      "slow": 360,
      "reducedFade": 120,
      "holdToConfirm": 1500
    },
    "easing": {
      "standard": [0.2, 0, 0, 1],
      "decelerate": [0, 0, 0, 1],
      "accelerate": [0.3, 0, 1, 1],
      "overshoot": [0.34, 1.56, 0.64, 1]
    },
    "spring": {
      "release": { "damping": 14, "stiffness": 420, "mass": 1 },
      "sheet": { "damping": 22, "stiffness": 260, "mass": 1 }
    }
  },
  "press": {
    "kind": "opacity",
    "androidRipple": true,
    "opacity": 0.7,
    "scale": 0.97,
    "squash": { "x": 0.02, "y": -0.04 },
    "disabledEdge": "solid"
  },
  "components": {
    "button": {
      "minHeight": 48,
      "minHeightLarge": 56,
      "paddingBlock": "{spacing.sm}",
      "paddingInline": "{spacing.lg}",
      "gap": "{spacing.sm}",
      "radius": "{radius.md}",
      "border": "{stroke.regular}",
      "icon": 20,
      "rowMinBasis": 120
    },
    "textButton": {
      "paddingBlock": "{spacing.sm}",
      "paddingInline": "{spacing.sm}",
      "underlineThickness": 2,
      "underlineOffset": 2
    },
    "iconButton": {
      "size": 48,
      "sizeSmall": "{size.minTouch}",
      "radius": "{radius.md}",
      "icon": 24
    },
    "checkbox": {
      "box": 24,
      "radius": "{radius.sm}",
      "border": "{stroke.regular}"
    },
    "checkMark": {
      "width": 6,
      "height": 11,
      "stroke": 2
    },
    "chevron": {
      "size": 8,
      "stroke": 2
    },
    "toggle": {
      "width": 52,
      "height": 32,
      "radius": "{radius.lg}",
      "border": "{stroke.regular}",
      "knob": 22,
      "knobInset": 3
    },
    "segmentedControl": {
      "minHeight": "{size.minTouch}",
      "gap": "{spacing.xs}",
      "radius": "{radius.md}",
      "border": "{stroke.regular}",
      "paddingBlock": "{spacing.xs}",
      "paddingInline": "{spacing.xs}",
      "labelGap": "{spacing.xs}"
    },
    "slider": {
      "height": "{size.minTouch}",
      "minWidth": 120,
      "trackHeight": 6,
      "trackRadius": 3,
      "thumb": 28,
      "thumbBorder": "{stroke.regular}"
    },
    "progressBar": {
      "height": 8,
      "minWidth": 60,
      "radius": 4
    },
    "radio": {
      "size": 24,
      "border": "{stroke.regular}",
      "dot": 12
    },
    "optionCard": {
      "minHeight": 56,
      "paddingBlock": "{spacing.md}",
      "paddingInline": "{spacing.lg}",
      "gap": "{spacing.md}",
      "radius": "{radius.md}"
    },
    "list": {
      "radius": "{radius.lg}",
      "border": "{stroke.hair}"
    },
    "sectionHeader": {
      "paddingTop": "{spacing.lg}",
      "paddingBottom": "{spacing.xs}",
      "paddingInline": "{spacing.lg}",
      "gap": "{spacing.sm}",
      "icon": 16
    },
    "row": {
      "minHeight": 52,
      "paddingBlock": "{spacing.md}",
      "paddingInline": "{spacing.lg}",
      "gap": "{spacing.md}",
      "separator": "{stroke.hair}",
      "labelGap": "{spacing.xxs}",
      "subRowIndent": 60
    },
    "iconTile": {
      "size": 32,
      "radius": "{radius.sm}",
      "icon": 20,
      "sizeLarge": 64,
      "radiusLarge": "{radius.lg}",
      "iconLarge": 36
    },
    "card": {
      "radius": "{radius.lg}",
      "border": "{stroke.hair}",
      "padding": "{spacing.lg}",
      "paddingCompact": "{spacing.md}",
      "gap": "{spacing.md}"
    },
    "cardHeader": {
      "gap": "{spacing.md}"
    },
    "callout": {
      "gap": "{spacing.md}",
      "icon": 20,
      "iconNudge": 2
    },
    "badge": {
      "paddingBlock": "{spacing.xxs}",
      "paddingInline": "{spacing.sm}",
      "gap": "{spacing.xs}",
      "radius": "{radius.sm}",
      "icon": 14,
      "maxTilt": 8
    },
    "chip": {
      "paddingBlock": "{spacing.xs}",
      "paddingInline": "{spacing.md}",
      "gap": "{spacing.xs}",
      "radius": "{radius.sm}",
      "border": "{stroke.hair}",
      "icon": 14
    },
    "appBar": {
      "minHeight": 56,
      "paddingInline": "{spacing.xs}",
      "gap": "{spacing.xs}"
    },
    "scrim": {
      "paddingBlock": "{spacing.xl}",
      "paddingInline": "{spacing.lg}"
    },
    "dialog": {
      "radius": "{radius.lg}",
      "paddingTop": "{spacing.xl}",
      "paddingInline": "{spacing.xl}",
      "paddingBottom": "{spacing.lg}",
      "gap": "{spacing.md}",
      "elevation": "{elevation.overlay}",
      "buttonRowGap": "{spacing.md}",
      "buttonRowMarginTop": "{spacing.sm}"
    },
    "toast": {
      "paddingBlock": "{spacing.md}",
      "paddingInline": "{spacing.lg}",
      "radius": "{radius.md}",
      "gap": "{spacing.md}",
      "icon": 20,
      "stackGap": "{spacing.sm}",
      "drop": 16,
      "border": "{stroke.hair}"
    },
    "emptyState": {
      "gap": "{spacing.md}",
      "paddingBlock": "{spacing.xxl}"
    },
    "pagerDots": {
      "dot": 8,
      "activeWidth": 20,
      "gap": "{spacing.sm}"
    },
    "statGrid": {
      "gap": "{spacing.md}",
      "cellPadding": "{spacing.md}",
      "radius": "{radius.md}",
      "cellGap": "{spacing.xxs}"
    },
    "barChart": {
      "height": 120,
      "bar": 16,
      "gap": "{spacing.sm}",
      "radius": "{radius.sm}",
      "minBar": 2,
      "labelGap": "{spacing.xs}"
    },
    "busy": {
      "block": 8,
      "radius": 2,
      "gap": 4,
      "hop": 6
    },
    "tileButton": {
      "minHeight": 88,
      "paddingBlock": "{spacing.md}",
      "paddingInline": "{spacing.sm}",
      "gap": "{spacing.sm}",
      "radius": "{radius.md}",
      "icon": 28
    },
    "toggleTile": {
      "minHeight": 88,
      "paddingBlock": "{spacing.sm}",
      "paddingInline": "{spacing.xs}",
      "gap": "{spacing.xs}",
      "radius": "{radius.md}",
      "icon": 24,
      "stateGap": "{spacing.xxs}"
    },
    "navCard": {
      "minHeight": 64,
      "paddingBlock": "{spacing.md}",
      "paddingInline": "{spacing.lg}",
      "gap": "{spacing.md}",
      "labelGap": "{spacing.xxs}",
      "radius": "{radius.md}"
    },
    "actionCard": {
      "minHeight": 56,
      "paddingBlock": "{spacing.sm}",
      "paddingInline": "{spacing.lg}",
      "gap": "{spacing.md}",
      "radius": "{radius.md}"
    },
    "confetti": {
      "band": 64,
      "piece": 10,
      "radius": 2,
      "fall": 32
    }
