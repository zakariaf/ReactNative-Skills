  "pass-prewarmed-left-out": {
    "expect": [
      "cold start: left out 2 launches whose process started before the launch",
      "cold start: median 820 ms of 5 launches (limit 1000 ms)",
      "RESULT: PASS"
    ],
    "ops": [
      {
        "$comment": "The two latest launches resumed an older process (iOS prewarm; an Android push start on an old version): left out, the median stays on the 5 real launches.",
        "json": {
          "file": "report.json",
          "path": ["entries", 8],
          "value": {
            "kind": "cold-start",
            "label": "tasks",
            "atEpochMs": 1790430200000,
            "data": { "nativeMs": 3600000, "jsMs": 300, "totalMs": 3600300, "prewarmed": true }
          }
        }
      },
      {
        "json": {
          "file": "report.json",
          "path": ["entries", 9],
          "value": {
            "kind": "cold-start",
            "label": "tasks",
            "atEpochMs": 1790430200001,
            "data": { "nativeMs": 60000, "jsMs": 300, "totalMs": 60300, "prewarmed": false }
          }
        }
      }
    ]
  },
  "pass-tighter-budget-file": {
    "expect": ["cold start: median 820 ms of 5 launches (limit 900 ms)", "RESULT: PASS"],
    "ops": [{ "write": { "file": "quality-gates.json", "json": { "perf": { "coldStartHomeMsMax": 900 } } } }]
  },
  "pass-unstamped-entry-noted": {
    "expect": [
      "note: 1 entry carries no build stamp (written before entries were stamped) and is judged as build 12's",
      "RESULT: PASS"
    ],
    "ops": [{ "json": { "file": "report.json", "path": ["entries", 7, "build"], "delete": true } }]
  }
}
