{
  "bad-android-growth": {
    "expect": ["[bundle-growth]", "the android bundle grew x1.250"],
    "args": "{dir}/dist {dir} --platform android --baseline {dir}/baseline-android.json",
    "ops": [
      {
        "write": {
          "file": "dist/_expo/static/js/android/entry-9c1d.js",
          "content": ""
        }
      },
      { "write": { "file": "baseline-android.json", "json": { "bundleJsBytes": 2000 } } }
    ]
  },
  "bad-cap": {
    "expect": ["[bundle-cap]", "3100 bytes of ios JS is over the 3000-byte cap"],
    "ops": [
      {
        "write": {
          "file": "dist/_expo/static/js/ios/entry-3f2a.js",
          "content": ""
        }
      },
      { "json": { "file": "baseline.json", "path": ["bundleJsBytes"], "value": 3000 } }
    ]
  },
  "bad-growth": {
    "expect": ["[bundle-growth]", "the ios bundle grew x1.267 over the baseline (1500 bytes)"],
    "ops": [{ "json": { "file": "baseline.json", "path": ["bundleJsBytes"], "value": 1500 } }]
  },
  "error-bad-platform": {
    "expect": ["ERROR [bad-input] --platform must be ios or android, got web"],
    "args": "{dir}/dist {dir} --platform web"
  },
  "error-bytecode-only": {
    "expect": ["ERROR [bad-input] the ios export holds Hermes bytecode (.hbc), not minified JS"],
    "ops": [
      {
        "rename": { "from": "dist/_expo/static/js/ios/entry-3f2a.js", "to": "dist/_expo/static/js/ios/entry-3f2a.hbc" }
      }
    ]
  },
  "error-default-baseline-missing": {
    "expect": [
      "ERROR [bad-input] baseline perf-baselines/bundle-ios.json does not exist",
      "the growth check is never skipped"
    ],
    "args": "{dir}/dist {dir}"
  },
  "error-missing-baseline": {
    "expect": ["ERROR [bad-input] baseline", "does not exist"],
    "args": "{dir}/dist {dir} --baseline {dir}/perf-baselines/none.json"
  },
  "pass-android": {
    "expect": ["bundle (android): 2,000 bytes of minified JS in 1 file(s)", "RESULT: PASS"],
    "args": "{dir}/dist {dir} --platform android --baseline {dir}/baseline-android.json",
    "ops": [
      {
        "write": {
          "file": "dist/_expo/static/js/android/entry-9c1d.js",
          "content": ""
        }
      },
      { "write": { "file": "baseline-android.json", "json": { "bundleJsBytes": 2000 } } }
    ]
  },
  "pass-default-baseline": {
    "expect": ["baseline: 1,900 bytes (x1.000, limit x1.1)", "RESULT: PASS"],
    "args": "{dir}/dist {dir}",
    "ops": [{ "rename": { "from": "baseline.json", "to": "perf-baselines/bundle-ios.json" } }]
  },
  "pass-relative-baseline-other-cwd": {
    "expect": ["baseline: 1,900 bytes (x1.000, limit x1.1)", "RESULT: PASS"],
    "args": "{dir}/dist {dir} --baseline baseline.json"
  },
  "pass-write-baseline": {
    "expect": ["wrote", "RESULT: PASS"],
    "args": "{dir}/dist {dir} --baseline {dir}/perf-baselines/bundle-ios.json --write-baseline",
    "ops": [
      {
        "$comment": "First run: perf-baselines/ does not exist yet; --write-baseline creates it.",
        "write": { "file": "notes.txt", "content": "no baseline folder yet\n" }
      }
    ]
  }
}
