  "pass-destructured-set-active": {
    "expect": ["RESULT: PASS"],
    "ops": [
      {
        "$comment": "The idiomatic destructured form, and a renamed one: both stop through a bare call.",
        "write": {
          "file": "src/features/charts/chart-runner.ts",
          "lines": [
            "// src/features/charts/chart-runner.ts",
            "import { useEffect } from 'react';",
            "import { useFrameCallback } from 'react-native-reanimated';",
            "",
            "import type { SharedValue } from 'react-native-reanimated';",
            "",
            "/** A live chart's clock: starts inactive and runs only while the chart moves. */",
            "export function useChartRunner(progress: SharedValue<number>, isRunning: boolean): void {",
            "  const { setActive } = useFrameCallback((info) => {",
            "    progress.set(progress.get() + (info.timeSincePreviousFrame ?? 0));",
            "  }, false);",
            "  useEffect(() => {",
            "    setActive(isRunning);",
            "    return () => {",
            "      setActive(false);",
            "    };",
            "  }, [isRunning, setActive]);",
            "}"
          ]
        }
      },
      {
        "write": {
          "file": "src/features/charts/pulse-runner.ts",
          "lines": [
            "// src/features/charts/pulse-runner.ts",
            "import { useEffect } from 'react';",
            "import { useFrameCallback } from 'react-native-reanimated';",
            "",
            "import type { SharedValue } from 'react-native-reanimated';",
            "",
            "export function usePulse(phase: SharedValue<number>, isOn: boolean): void {",
            "  const { setActive: setTicking } = useFrameCallback((info) => {",
            "    phase.set((phase.get() + (info.timeSincePreviousFrame ?? 0)) % 1000);",
            "  }, isOn);",
            "  useEffect(() => {",
            "    setTicking(isOn);",
            "  }, [isOn, setTicking]);",
            "}"
          ]
        }
      }
    ]
  },
