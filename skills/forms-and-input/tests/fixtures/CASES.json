  "pass-server-code-table": [
    {
      "write": {
        "file": "src/features/task-editor/apply-title-conflict.ts",
        "lines": [
          "// src/features/task-editor/apply-title-conflict.ts",
          "import type { TaskEditorInput } from './task-editor-schema';",
          "import type { MessageKey } from '@/i18n/messages';",
          "import type { UseFormSetError } from 'react-hook-form';",
          "",
          "type TitleCode = 'title-taken' | 'title-banned';",
          "",
          "const TITLE_MESSAGES: Readonly<Record<TitleCode, MessageKey>> = {",
          "  'title-taken': 'task-editor.title.duplicate',",
          "  'title-banned': 'forms.field.invalid',",
          "};",
          "",
          "export function applyTitleConflict(setError: UseFormSetError<TaskEditorInput>, code: TitleCode): void {",
          "  setError('title', { type: 'conflict', message: TITLE_MESSAGES[code] });",
          "  setError('title', { type: 'conflict', message: 'task-editor.title.duplicate' });",
