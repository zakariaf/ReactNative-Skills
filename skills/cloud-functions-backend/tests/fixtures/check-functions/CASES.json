  "bad-missing-app-check-root-namespace": {
    "expect": [
      "[missing-app-check]",
      "functions/src/tasks/archive-list.ts:5",
      "does not set enforceAppCheck: true"
    ],
    "ops": [
      {
        "write": {
          "file": "functions/src/tasks/archive-list.ts",
          "lines": [
            "// functions/src/tasks/archive-list.ts",
            "import * as functions from 'firebase-functions';",
            "",
            "// The root entry point is 2nd gen in firebase-functions 7, so this is a 2nd-gen callable without App Check.",
            "export const archiveList = functions.https.onCall({ enforceAppCheck: false }, async (request) => {",
            "  if (!request.auth) throw new functions.https.HttpsError('unauthenticated', 'unauthenticated');",
            "  return { archived: true };",
            "});"
          ]
        }
      }
    ]
  },
  "bad-missing-app-check-cjs": {
    "expect": [
      "[missing-app-check]",
      "functions/src/tasks/count-tasks.js:5",
      "without an options object"
    ],
    "ops": [
      {
        "write": {
          "file": "functions/src/tasks/count-tasks.js",
          "lines": [
            "// functions/src/tasks/count-tasks.js",
            "const { onCall: call, HttpsError } = require('firebase-functions/https');",
            "",
            "// A CommonJS callable with no options object.",
            "exports.countTasks = call((request) => {",
            "  if (request.auth === undefined) throw new HttpsError('unauthenticated', 'unauthenticated');",
            "  return { count: 0 };",
            "});"
          ]
        }
      }
    ]
  },
