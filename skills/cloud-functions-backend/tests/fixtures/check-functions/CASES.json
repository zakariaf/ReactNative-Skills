{
  "bad-missing-app-check": {
    "expect": [
      "[missing-app-check]",
      "functions/src/lib/define-callable.ts:83",
      "does not set enforceAppCheck: true"
    ],
    "ops": [
      {
        "replace": {
          "file": "functions/src/lib/define-callable.ts",
          "find": "      enforceAppCheck: true,",
          "with": "      enforceAppCheck: false,"
        }
      }
    ]
  },
  "bad-missing-app-check-no-options": {
    "expect": [
      "[missing-app-check]",
      "functions/src/tasks/ping.ts:5"
    ],
    "ops": [
      {
        "write": {
          "file": "functions/src/tasks/ping.ts",
          "lines": [
            "// functions/src/tasks/ping.ts",
            "import { HttpsError, onCall } from 'firebase-functions/v2/https';",
            "",
            "// No options object: App Check is not enforced.",
            "export const ping = onCall(async (request) => {",
            "  if (!request.auth) throw new HttpsError('unauthenticated', 'unauthenticated');",
            "  return 'pong';",
            "});"
          ]
        }
      }
    ]
  },
  "bad-missing-app-check-consume": {
