  "pass-budget-handler": {
    "expect": [
      "RESULT: PASS"
    ],
    "ops": [
      {
        "write": {
          "file": "functions/src/ops/on-budget-alert.ts",
          "lines": [
            "// functions/src/ops/on-budget-alert.ts",
            "import { onMessagePublished } from 'firebase-functions/v2/pubsub';",
            "import * as logger from 'firebase-functions/logger';",
            "import * as v from 'valibot';",
            "",
            "const BudgetNotification = v.object({ costAmount: v.number(), budgetAmount: v.number(), alertThresholdExceeded: v.optional(v.number()) });",
            "",
            "export const onBudgetAlert = onMessagePublished({ topic: 'budget-alerts', retry: false }, async (event) => {",
            "  const parsed = v.safeParse(BudgetNotification, event.data.message.json);",
            "  if (!parsed.success) return;",
            "  logger.info('budget', { ratio: parsed.output.costAmount / parsed.output.budgetAmount });",
            "});"
          ]
        }
      }
    ]
  },
