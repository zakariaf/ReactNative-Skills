{
  "name": "functions",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "engines": {
    "node": "24"
  },
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --target=node24 --format=esm --external:firebase-functions --external:firebase-admin --outfile=lib/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test \"src/**/*.test.ts\""
  },
  "dependencies": {
    "firebase-admin": "14.5.0",
    "firebase-functions": "7.4.0"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "esbuild": "0.28.2",
    "typescript": "6.0.3",
    "valibot": "1.5.0"
  }
}
