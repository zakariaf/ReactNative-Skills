{
  "bad-commit-dangling": {
    "expect": ["[dangling-id]", "2b3c4d5:3", "\"REQ-77\" is not a requirement entry"],
    "args": "{dir} --log {dir}/commits.log",
    "ops": [
      {
        "write": {
          "file": "commits.log",
          "content": "==> commit 1a2b3c4d5e6f7a8b9c0d1e2f3a4b5c6d7e8f9a0b\nfeat(tasks): add a task\n\nREQ-1: a new task goes to the top.\n\n==> files\nsrc/features/tasks/add-task.ts\n==> commit 2b3c4d5e6f7a8b9c0d1e2f3a4b5c6d7e8f9a0b1c\nfix(tasks): keep Undo on screen\n\nServes REQ-2 and REQ-77.\n\n==> files\nsrc/features/tasks/complete-task.ts\n"
        }
      }
    ]
  },
  "bad-dangling-comment": {
    "expect": ["[dangling-id]", "src/features/settings/settings-screen.tsx:2", "\"SCR-16\" is not a screen entry"],
    "ops": [
      {
        "write": {
          "file": "src/features/settings/settings-screen.tsx",
          "content": "// src/features/settings/settings-screen.tsx\n// Settings (SCR-3) links to the Leaderboard (SCR-16).\nexport function SettingsScreen(): null {\n  return null;\n}\n"
        }
      }
    ]
  },
  "bad-dangling-flow": {
    "expect": ["[dangling-id]", ".maestro/complete-task.yaml:2", "\"DEC-12\" is not a decision entry"],
    "ops": [
      {
        "write": {
          "file": ".maestro/complete-task.yaml",
          "content": "# .maestro/complete-task.yaml\n# Completes a task (REQ-2); Undo lasts as DEC-12 says.\nappId: com.example.tasks\n---\n- launchApp\n"
        }
      }
    ]
  },
  "bad-dangling-in-spec": {
    "expect": ["[dangling-id]", "docs/spec/decisions.md:12", "\"REQ-42\""],
    "ops": [{ "replace": { "file": "docs/spec/decisions.md", "find": "Used by REQ-2.", "with": "Used by REQ-42." } }]
  },
  "bad-dangling-markdown": {
    "expect": ["[dangling-id]", "docs/notes.md:6", "\"NN-5\" is not a non-negotiable entry"],
    "ops": [{ "replace": { "file": "docs/notes.md", "find": "NN-1 to NN-4", "with": "NN-1 to NN-5" } }]
  },
  "bad-dangling-test-title": {
    "expect": ["[dangling-id]", "src/features/tasks/add-task.test.ts:9", "\"REQ-19\" is not a requirement entry"],
    "ops": [
      { "replace": { "file": "src/features/tasks/add-task.test.ts", "find": "(REQ-1)", "with": "(REQ-1, REQ-19)" } }
    ]
  },
  "bad-decided-without-decided": {
    "expect": [
      "[entry-field-missing]",
      "docs/spec/decisions.md:6",
      "decision DEC-1 · How long Undo stays on screen has no \"Decided:\" line (Status: decided needs it: a settled decision records its outcome)"
    ],
    "ops": [
      {
        "replace": {
          "file": "docs/spec/decisions.md",
          "find": "- Status: open\n- Options: 4 seconds",
          "with": "- Status: decided\n- Options: 4 seconds"
        }
      }
    ]
  },
  "bad-decision-no-default": {
    "expect": [
      "[entry-field-missing]",
      "docs/spec/decisions.md:6",
      "decision DEC-1 · How long Undo stays on screen has no \"Default:\" line (Status: open needs it"
    ],
    "ops": [{ "replace": { "file": "docs/spec/decisions.md", "find": "- Default: 5 seconds\n", "with": "" } }]
  },
  "bad-dropped-traced": {
    "expect": ["[out-of-scope-traced]", "src/features/lists/list-limit.test.ts:3", "which the spec marks dropped"],
    "ops": [
      {
        "write": {
          "file": "src/features/lists/list-limit.test.ts",
          "content": "// src/features/lists/list-limit.test.ts\ndescribe('listLimit', () => {\n  it('stops at three lists without Premium (REQ-5)', () => {\n    expect(3).toBe(3);\n  });\n});\n"
        }
      },
      {
        "replace": {
          "file": "docs/spec/requirements.md",
          "find": "### REQ-5 · Free lists limit\n\n- Status: planned",
          "with": "### REQ-5 · Free lists limit\n\n- Status: dropped"
        }
      }
    ]
  },
  "bad-duplicate-id": {
    "expect": ["[duplicate-spec-id]", "docs/spec/screens.md:27", "SCR-2 is already \"Task editor\""],
    "ops": [
      {
        "replace": {
          "file": "docs/spec/screens.md",
          "find": "## SCR-3 · Settings",
          "with": "## SCR-2 · Task details\n\nThe read-only view of a task.\n\n## SCR-3 · Settings"
        }
      }
    ]
  },
  "bad-heading-without-title": {
