  "bad-ref-pattern-commits": {
    "expect": [
      "[ref-pattern-mismatch]",
      "docs/spec/requirements.md:8",
      "REQ-1 does not match requirementRef.pattern of contracts/commits.json (commit bodies and Spec-Change trailers)"
    ],
    "ops": [
      {
        "write": {
          "file": "contracts/commits.json",
          "content": "{\n  \"scopeFolders\": [\n    \"src/features/*\",\n    \"src/*\"\n  ],\n  \"extraScopes\": [],\n  \"requirementRef\": {\n    \"pattern\": \"\\\\bTASKS-\\\\d+\\\\b\",\n    \"required\": true,\n    \"exemptScopes\": []\n  }\n}\n"
        }
      }
    ]
  },
  "bad-ref-pattern-default": {
    "expect": [
      "[ref-pattern-mismatch]",
      "docs/spec/stories.md:3",
      "US_4 does not match the default requirement reference (Spec-Change trailers)"
    ],
    "ops": [
      {
        "json": {
          "file": "contracts/spec.json",
          "path": ["kinds", 5],
          "value": { "kind": "story", "prefix": "US_", "traced": true }
