    ],
    "ops": [
      {
        "write": {
          "file": "src/features/widgets/widget-data.test.ts",
          "content": "// src/features/widgets/widget-data.test.ts\ndescribe('widgetData', () => {\n  it('lists the next three tasks for the widget (OOS-3)', () => {\n    expect([1, 2, 3]).toHaveLength(3);\n  });\n});\n"
        }
