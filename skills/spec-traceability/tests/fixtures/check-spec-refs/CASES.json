  "bad-spec-empty": {
    "expect": ["[spec-empty]", "docs/spec/README.md:1", "docs/spec/ holds no entry heading"],
    "ops": [
      {
        "delete": [
          "docs/spec/non-negotiables.md",
          "docs/spec/screens.md",
          "docs/spec/requirements.md",
          "docs/spec/decisions.md",
          "docs/spec/out-of-scope.md",
          "docs/spec/glossary.md"
        ]
      },
      {
        "write": {
          "file": "docs/spec/README.md",
          "lines": ["# Product spec", "", "## Tasks", "", "Users add tasks and complete them."]
        }
      },
      { "write": { "file": "src/features/tasks/add-task.test.ts", "lines": ["it('adds a task', () => {});"] } },
      { "write": { "file": ".maestro/add-task.yaml", "lines": ["appId: com.example.tasks", "---", "- launchApp"] } },
      { "write": { "file": "docs/notes.md", "lines": ["# Notes"] } },
      {
        "write": {
          "file": "src/features/tasks/tasks-screen.tsx",
          "lines": ["// src/features/tasks/tasks-screen.tsx", "export const TasksScreen = (): null => null;"]
        }
      }
    ]
  },
