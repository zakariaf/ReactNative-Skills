          "find": "### REQ-2 · Complete a task\n\n- Status: planned",
          "with": "### REQ-2 · Complete a task\n\n- Status: built"
        }
      }
    ]
  },
  "bad-untraced-cited-only-in-source": {
    "expect": ["[untraced-requirement]", "docs/spec/screens.md:7", "SCR-1 · Task list is marked built"],
    "ops": [
      {
        "write": {
          "file": "src/app/(app)/index.tsx",
          "content": "// src/app/(app)/index.tsx\nimport { TasksScreen } from '@/features/tasks/tasks-screen';\n\nexport default TasksScreen;\n"
        }
      },
      {
        "replace": {
          "file": "docs/spec/screens.md",
          "find": "## SCR-1 · Task list\n\n- Status: planned",
          "with": "## SCR-1 · Task list\n\n- Status: built"
        }
      },
      { "replace": { "file": ".maestro/add-task.yaml", "find": "# Task list (SCR-1): adds", "with": "# Adds" } }
    ]
  },
  "error-bad-contract-json": {
    "expect": ["ERROR [bad-input] contracts/spec.json is not valid JSON"],
    "ops": [{ "write": { "file": "contracts/spec.json", "content": "{ \"specDir\": \n" } }]
  },
  "error-contract-bad-prefix": {
    "expect": ["ERROR [bad-input]", "kinds[2].prefix \"req-\" must be 1-10 capital letters"],
    "ops": [{ "json": { "file": "contracts/spec.json", "path": ["kinds", 2, "prefix"], "value": "req-" } }]
  },
  "error-contract-unknown-key": {
    "expect": [
      "ERROR [bad-input] contracts/spec.json does not match contracts/spec.schema.json: unknown key \"prefixes\""
    ],
    "ops": [{ "json": { "file": "contracts/spec.json", "path": ["prefixes"], "value": ["REQ-"] } }]
  },
  "error-range-and-log": {
    "expect": ["ERROR [bad-input] pass either --range or --log, not both"],
    "args": "{dir} --range HEAD~1..HEAD --log x.log"
  },
  "error-spec-option-missing": {
    "expect": ["ERROR [bad-input] nothing to check: spec folder nowhere does not exist"],
    "args": "{dir} --spec nowhere"
  },
  "pass-commits-clean": {
    "expect": ["check-spec-refs:", "RESULT: PASS"],
    "args": "{dir} --log {dir}/commits.log",
    "ops": [
      {
        "write": {
          "file": "commits.log",
          "content": "==> commit 1a2b3c4d5e6f7a8b9c0d1e2f3a4b5c6d7e8f9a0b\nfeat(tasks): add a task\n\nREQ-1: a new task goes to the top (Task list (SCR-1), spec 1.1).\n\n==> files\nsrc/features/tasks/add-task.ts\n"
        }
      }
    ]
  },
  "pass-config-contract-key": {
    "expect": ["TRACE REQ-1 [built] Add a task", "RESULT: PASS"],
    "args": "{dir} --trace",
    "ops": [
      { "rename": { "from": "contracts/spec.json", "to": "qa/spec.json" } },
      { "json": { "file": "qa/spec.json", "path": ["specDir"], "value": "qa/spec" } },
      { "rename": { "from": "docs/spec", "to": "qa/spec" } },
      { "write": { "file": "rn-skills.config.json", "json": { "specContract": "qa/spec.json" } } }
    ]
  },
  "pass-default-contract": { "expect": ["RESULT: PASS"], "ops": [{ "delete": "contracts/spec.json" }] },
  "pass-no-spec": {
    "expect": ["NOT APPLICABLE: the app keeps no requirement spec (no contracts/spec.json and no docs/spec/ folder)"],
    "ops": [{ "delete": ["docs/spec", "contracts/spec.json"] }]
  },
  "pass-route-built": {
    "expect": ["check-spec-refs:", "RESULT: PASS"],
    "ops": [
      {
        "write": {
          "file": "src/app/(app)/index.tsx",
          "content": "// src/app/(app)/index.tsx\nimport { TasksScreen } from '@/features/tasks/tasks-screen';\n\nexport default TasksScreen;\n"
        }
      },
      {
        "$comment": "SCR-1 is traced by the good case's flow, so only the missing route file fails.",
        "replace": {
          "file": "docs/spec/screens.md",
          "find": "## SCR-1 · Task list\n\n- Status: planned",
          "with": "## SCR-1 · Task list\n\n- Status: built"
        }
      }
    ]
  },
  "pass-spec-option": {
    "expect": ["RESULT: PASS"],
    "args": "{dir} --spec apps/mobile/docs/spec",
    "ops": [{ "rename": { "from": "docs/spec", "to": "apps/mobile/docs/spec" } }]
  },
  "pass-trace": {
    "expect": [
      "TRACE REQ-1 [built] Add a task: .maestro/add-task.yaml, src/features/tasks/add-task.test.ts",
      "TRACE REQ-2 [planned] Complete a task: no test or flow",
      "TRACE SCR-1 [planned] Task list: .maestro/add-task.yaml"
    ],
    "args": "{dir} --trace"
  }
}
