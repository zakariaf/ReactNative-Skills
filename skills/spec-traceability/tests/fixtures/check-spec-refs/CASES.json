    "expect": ["[spec-missing]", "contracts/spec.json:", "the spec folder docs/product-spec/ does not exist"],
    "ops": [{ "json": { "file": "contracts/spec.json", "path": ["specDir"], "value": "docs/product-spec" } }]
  },
  "bad-unknown-section": {
    "expect": ["[unknown-spec-section]", "src/features/tasks/add-task.test.ts:9", "\"spec 2.4\""],
