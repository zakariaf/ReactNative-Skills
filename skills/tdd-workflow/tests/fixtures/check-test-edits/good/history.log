+// src/features/tasks/task-urgency.test.ts
+import { taskUrgency } from './task-urgency';
+
+describe('taskUrgency', () => {
+  it('returns today for a task due today (TASKS-12)', () => {
+    expect(taskUrgency(0)).toBe('today');
+  });
+
+  it('returns soon for a task due in 2 days', () => {
+    expect(taskUrgency(2)).toBe('soon');
+  });
+});
diff --git a/src/features/tasks/task-urgency.ts b/src/features/tasks/task-urgency.ts
new file mode 100644
index 0000000..3e41ca3
--- /dev/null
+++ b/src/features/tasks/task-urgency.ts
@@ -0,0 +1,12 @@
+// src/features/tasks/task-urgency.ts
+export type Urgency = 'overdue' | 'today' | 'soon' | 'later';
+
+export function taskUrgency(daysLeft: number): Urgency {
+  if (daysLeft < 0) {
+    return 'overdue';
+  }
+  if (daysLeft === 0) {
+    return 'today';
+  }
+  return daysLeft <= 2 ? 'soon' : 'later';
+}
