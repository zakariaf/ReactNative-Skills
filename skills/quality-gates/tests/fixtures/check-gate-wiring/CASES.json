  "bad-extra-jest-project-unlisted": {
    "expect": [
      "[jest-scope]",
      "testMatch is TEST_ROOTS.map((root)=>`${root}*.web.test.{ts,tsx}`)"
    ],
    "ops": [
      {
        "$comment": "a new 'web' project that quality-gates.json jest.projects does not list: the static check still compares it with the canonical scope",
        "replace": {
          "file": "jest.config.js",
          "find": "const goldenProject = {\n",
          "with": "const webProject = {\n  ...SHARED,\n  displayName: 'web',\n  preset: 'jest-expo/web',\n  testMatch: TEST_ROOTS.map((root) => `${root}*.web.test.{ts,tsx}`),\n  testPathIgnorePatterns: [...SHARED.testPathIgnorePatterns, '\\\\.e2e\\\\.'],\n  setupFilesAfterEnv: ['<rootDir>/jest.setup.ts'],\n};\n\nconst goldenProject = {\n"
        }
      },
      {
        "replace": {
          "file": "jest.config.js",
          "find": "projects: [unitProject, androidProject, goldenProject],",
          "with": "projects: [unitProject, androidProject, goldenProject, webProject],"
        }
      }
    ]
