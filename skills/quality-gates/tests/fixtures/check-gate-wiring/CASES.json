{
  "bad-android-secrets-readable": {
    "expect": [
      "[claude-settings]",
      "permissions.deny lost \"Read(**/*.keystore)\"",
      "permissions.deny lost \"Read(**/*service-account*.json)\""
    ],
    "ops": [
      {
        "replace": {
          "file": ".claude/settings.json",
          "find": "      \"Read(**/*.keystore)\",\n",
          "with": ""
        }
      },
      {
        "replace": {
          "file": ".claude/settings.json",
          "find": "      \"Read(**/*service-account*.json)\",\n",
          "with": ""
        }
      }
    ]
  },
  "bad-canonical-project-renamed": {
    "expect": [
      "FAIL jest.config.js:1 [jest-scope] no project has displayName 'unit'"
    ],
    "ops": [
      {
        "$comment": "the unit project is renamed to an 'added' project with a narrower scope, listed in quality-gates.json as if it were new",
        "replace": {
          "file": "jest.config.js",
          "find": "  displayName: 'unit',\n",
          "with": "  displayName: 'web',\n"
        }
      },
      {
        "json": {
          "file": "quality-gates.json",
          "path": [
            "jest",
            "projects",
            "web"
          ],
          "value": {
            "roots": [
              "<rootDir>"
            ],
            "testMatch": [
              "<rootDir>/src/features/**/*.test.{ts,tsx}"
            ],
            "testPathIgnorePatterns": [
              "/node_modules/",
              "<rootDir>/(ios|android|build|dist|web-build)/",
              "<rootDir>/(coverage|reports|skills|\\.stryker-tmp|\\.skill-tooling)/",
              "<rootDir>/\\.(agents|claude|codex|cursor|windsurf|roo|cline|continue|kiro)/",
              "\\.golden\\.test\\.",
              "\\.sim\\.test\\.",
              "\\.android\\.test\\."
            ],
            "modulePathIgnorePatterns": [
              "<rootDir>/(ios|android|build|dist|web-build)/",
              "<rootDir>/(coverage|reports|skills|\\.stryker-tmp|\\.skill-tooling)/",
              "<rootDir>/\\.(agents|claude|codex|cursor|windsurf|roo|cline|continue|kiro)/"
            ]
          }
        }
      }
    ]
  },
