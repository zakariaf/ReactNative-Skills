  "bad-lifecycle-write-named-handler": {
    "expect": [
      "FAIL src/features/task-editor/use-draft-autosave.ts:10 [lifecycle-write] an AppState listener writes (saveDraft) on its own through its handler onChange",
      "FAIL src/stores/drafts/watch-note-draft.ts:9 [lifecycle-write] an AppState listener writes (persistNow) on its own through its handler handleChange",
      "RESULT: FAIL (2 problems)"
    ],
    "ops": [
      {
        "write": {
          "file": "src/features/task-editor/use-draft-autosave.ts",
          "lines": [
            "// src/features/task-editor/use-draft-autosave.ts",
            "import { useEffect } from 'react';",
            "import { AppState } from 'react-native';",
            "",
            "import type { AppStateStatus } from 'react-native';",
            "",
            "export function useDraftAutosave(saveDraft: () => void): void {",
            "  useEffect(() => {",
            "    const onChange = (next: AppStateStatus): void => {",
            "      if (next !== 'active') saveDraft();",
            "    };",
            "    const subscription = AppState.addEventListener('change', onChange);",
            "    return () => {",
            "      subscription.remove();",
            "    };",
            "  }, [saveDraft]);",
            "}"
          ]
        }
      },
      {
        "write": {
          "file": "src/stores/drafts/watch-note-draft.ts",
          "lines": [
            "// src/stores/drafts/watch-note-draft.ts",
            "import { AppState } from 'react-native';",
            "",
            "import type { AppStateStatus } from 'react-native';",
            "",
            "export function watchNoteDraft(draft: { persistNow: () => void }): () => void {",
            "  const subscription = AppState.addEventListener('change', handleChange);",
            "  function handleChange(next: AppStateStatus): void {",
            "    if (next === 'background') draft.persistNow();",
            "  }",
            "  return () => {",
            "    subscription.remove();",
            "  };",
            "}"
          ]
        }
      }
    ]
