  "bad-fallback-screen-no-locale": {
    "expect": [
      "[root-direction-provider]",
      "src/features/crash-recovery/crash-fallback.tsx:1",
      "the root ErrorBoundary fallback (crash-fallback.tsx)"
    ],
    "ops": [
      {
        "write": {
          "file": "src/features/crash-recovery/crash-fallback.tsx",
          "lines": [
            "// src/features/crash-recovery/crash-fallback.tsx",
            "// The app's root fallback, the `Fallback` the root layout hands createRouteErrorBoundary. It renders",
            "// outside every provider the root layout mounts (Expo Router's boundary replaces the layout), so it",
            "// reads no React context that lacks a default. useTheme() is safe: design-system-structure's theme",
            "// context defaults to the app's light theme, the same theme AppText falls back to, so the text and",
            "// the background stay a pair whose contrast the theme proves. Copy comes from i18n-strings-and-",
            "// catalogs' createTranslateNow (src/i18n/translate-now.ts), a t() that needs no provider: it uses the",
            "// language and digits I18nProvider showed last, so the person keeps their own language, and the",
            "// device's languages when no provider committed yet. Expo Router's root mounts SafeAreaProvider above",
            "// the layout, so safe-area hooks still work. Keep it trivial: nothing catches or records an error",
            "// thrown here.",
            "import { createTranslateNow } from '@/i18n/translate-now';",
            "import { appErrorNet } from '@/services/error-net/app-error-net';",
            "import { useTheme } from '@/theme/use-theme';",
            "",
            "import { CrashScreen } from './crash-screen';",
            "",
            "import type { CrashFallbackProps } from './create-route-error-boundary';",
            "",
            "/** A missing crash message is recorded, never thrown: a throw here would be an unrecorded crash. */",
            "function reportMessageError(error: Error): void {",
            "  appErrorNet.report({ source: 'render', error, isFatal: false });",
            "}",
            "",
            "/** The crash screen with the app's copy and background; its one way out is `onRestart`. */",
            "export function CrashFallback({ onRestart }: CrashFallbackProps): React.JSX.Element {",
            "  const theme = useTheme();",
            "  const t = createTranslateNow(reportMessageError);",
            "  return (",
            "    <CrashScreen",
            "      title={t('crash.title')}",
            "      body={t('crash.body')}",
            "      actionLabel={t('crash.restart')}",
            "      onAction={onRestart}",
            "      backgroundColor={theme.colors.background}",
            "    />",
            "  );",
            "}"
          ]
        }
      },
      {
        "write": {
          "file": "src/features/crash-recovery/crash-screen.tsx",
          "lines": [
            "// src/features/crash-recovery/crash-screen.tsx",
            "// The fallback a crashed route shows: a title, one sentence and one way out. A pure view whose",
            "// strings and background arrive as props. Under the root layout it renders outside every provider",
            "// the layout mounts, so it reads no context that lacks a default. The app passes the background",
            "// from useTheme(), whose context defaults to the light theme outside ThemeProvider: the same theme",
            "// AppText falls back to, so text and background stay a pair whose contrast the theme proves. Keep",
            "// it trivial: no boundary catches an error thrown here, and React reports it to React Native as a",
            "// fatal crash the error net never sees.",
            "import { Button, StyleSheet, View } from 'react-native';",
            "",
            "import { AppText } from '@/ui/app-text';",
            "",
            "export type CrashScreenProps = {",
            "  readonly title: string;",
            "  readonly body: string;",
            "  readonly actionLabel: string;",
            "  readonly onAction: () => void;",
            "  /**",
            "   * The screen background, from useTheme() (its context defaults to the light theme outside",
            "   * ThemeProvider), so it always matches the theme AppText draws the text with.",
            "   */",
            "  readonly backgroundColor: string;",
            "};",
            "",
            "/** Crash fallback: one way out, never an automatic retry. */",
            "export function CrashScreen({",
            "  title,",
            "  body,",
            "  actionLabel,",
            "  onAction,",
            "  backgroundColor,",
            "}: CrashScreenProps): React.JSX.Element {",
            "  return (",
            "    <View",
            "      testID=\"crash.screen\"",
            "      style={[styles.screen, { backgroundColor }]}",
            "      accessibilityRole=\"alert\"",
            "    >",
            "      <AppText testID=\"crash.title\">{title}</AppText>",
            "      <AppText testID=\"crash.body\">{body}</AppText>",
            "      <Button testID=\"crash.restart-button\" title={actionLabel} onPress={onAction} />",
            "    </View>",
            "  );",
            "}",
            "",
            "const styles = StyleSheet.create({",
            "  screen: { flex: 1, justifyContent: 'center', gap: 16, paddingHorizontal: 24 },",
            "});"
          ]
        }
      }
    ]
  },
