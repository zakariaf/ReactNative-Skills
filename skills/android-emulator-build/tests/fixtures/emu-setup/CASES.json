    ],
    "ops": [
      {
        "$comment": "React Native's Gradle plugin compiles with JDK 17; a JDK 21 pin disagrees",
        "write": {
          "file": "node_modules/@react-native/gradle-plugin/react-native-gradle-plugin/build.gradle.kts",
          "content": "java { targetCompatibility = JavaVersion.VERSION_11 }\n\nkotlin { jvmToolchain(17) }\n"
        }
      },
      {
        "replace": {
          "file": "scripts/android/toolchain.ts",
          "find": "export const JDK_MAJOR = 17;",
          "with": "export const JDK_MAJOR = 21;"
