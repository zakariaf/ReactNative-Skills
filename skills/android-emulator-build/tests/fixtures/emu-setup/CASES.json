  },
  "error-no-package-json": {
    "expect": ["ERROR [bad-input] nothing to check: no package.json in the repo root"],
    "ops": [{ "delete": "package.json" }]
  },
  "pass-app-dir": {
    "expect": ["check-emu-setup:", "0 problems"],
    "args": "{dir} --app-dir apps/mobile",
    "ops": [
      { "json": { "file": "package.json", "path": ["workspaces"], "value": ["apps/*"] } },
      {
        "json": {
          "file": "package.json",
          "path": ["scripts", "build:android:emu"],
          "value": "node scripts/build/build-android-emu.ts --app-dir apps/mobile"
        }
      },
      { "json": { "file": "package.json", "path": ["dependencies", "expo"], "delete": true } },
      {
        "write": {
          "file": "apps/mobile/package.json",
          "json": { "name": "@acme/mobile", "private": true, "dependencies": { "expo": "~57.0.26" } }
        }
      },
      { "rename": { "from": "metro.config.js", "to": "apps/mobile/metro.config.js" } },
      { "rename": { "from": "app.config.ts", "to": "apps/mobile/app.config.ts" } }
    ]
  },
  "pass-command-strings": {
    "expect": ["check-emu-setup:", "0 problems"],
    "ops": [
      {
        "write": {
          "file": "scripts/tools/emulator-safe.ts",
          "content": "// scripts/tools/emulator-safe.ts\nimport { execFileSync, execSync } from 'node:child_process';\n\nimport { adbArgs } from '../android/adb-args.ts';\n\nexport function safeCalls(adbPath: string, serial: string): void {\n  execSync('adb -s emulator-5556 shell getprop sys.boot_completed');\n  execSync('adb devices');\n  execSync('emulator -list-avds');\n  execSync('emulator -avd tasks-e2e -port 5560 -no-window');\n  execSync('avdmanager delete avd -n tasks-old');\n  execFileSync(adbPath, ['-s', serial, 'install', 'app.apk']);\n  execFileSync(adbPath, adbArgs(serial, 'shell', 'pidof', 'com.acme.tasks'));\n  execFileSync('adb', ['-s', serial, 'emu', 'kill']);\n}\n"
        }
      },
      {
        "write": {
          "file": "scripts/emulator-safe.sh",
          "content": "#!/bin/sh\nadb -s \"$SERIAL\" install build/android-emu/app-preview.apk\nadb -s emulator-5556 emu kill\nemulator -avd \"$AVD\" -port 5560 &\nemulator @tasks-smoke -no-window &\navdmanager create avd -n tasks-e2e -k \"$IMAGE\" -d pixel_8\n./gradlew --no-daemon :app:assembleRelease\n"
        }
      }
    ]
  },
  "pass-no-contract": {
    "expect": ["check-emu-setup:", "0 problems"],
    "ops": [{ "delete": ["contracts/android-emu-build.json", "contracts/android-emu-build.schema.json"] }]
  },
  "pass-not-expo": {
    "expect": ["NOT APPLICABLE: package.json has no expo dependency"],
    "ops": [{ "json": { "file": "package.json", "path": ["dependencies", "expo"], "delete": true } }]
  },
  "pass-toolchain-jdk-plugin": {
    "expect": ["check-emu-setup:", "0 problems"],
    "ops": [
      {
        "$comment": "the installed Gradle plugin's jvmToolchain(17) agrees with JDK_MAJOR = 17",
        "write": {
          "file": "node_modules/@react-native/gradle-plugin/react-native-gradle-plugin/build.gradle.kts",
          "content": "java { targetCompatibility = JavaVersion.VERSION_11 }\n\nkotlin { jvmToolchain(17) }\n"
        }
      }
    ]
