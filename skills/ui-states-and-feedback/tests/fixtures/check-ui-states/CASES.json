          "lines": [
            "// planted: two ways to run the action on a non-confirmed outcome (Android back answers 'dismissed')",
            "import type { ConfirmOutcome } from '@/ui/feedback/confirm';",
            "",
            "export async function deleteNotes(ask: () => Promise<ConfirmOutcome>, remove: () => void): Promise<void> {",
            "  const outcome = await ask();",
            "  // A comment that mentions !== 'cancelled' stays silent.",
            "  const label = \"outcome !== 'dismissed'\";",
            "  if (outcome !== 'cancelled') remove();",
            "  if (label === '') return;",
            "  const again = await ask();",
            "  // A guard on 'cancelled' alone lets 'dismissed' fall through to the delete.",
            "  if (again === 'cancelled') return;",
            "  remove();",
            "}"
          ]
        }
      }
    ]
  },
