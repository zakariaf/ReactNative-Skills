    "ops": [
      {
        "write": {
          "file": "src/features/tasks/use-notes-state.ts",
          "lines": [
            "// planted: query data defaulted to [] first, then handed to the state function under another name",
            "import { useInfiniteQuery, useQuery } from '@tanstack/react-query';",
            "",
            "import { listScreenStateOf } from '@/ui/feedback/screen-state';",
            "",
            "type Options = Parameters<typeof useQuery<string[]>>[0];",
            "type PagedOptions = Parameters<typeof useInfiniteQuery<{ readonly items: string[] }>>[0];",
            "type State = ReturnType<typeof listScreenStateOf<string>>;",
            "",
            "export function useNotesState(options: Options): State {",
            "  const query = useQuery(options);",
            "  const notes = query.data ?? [];",
            "  return listScreenStateOf({ items: notes, isFetching: query.isFetching, isPaused: false, failureKey: null, isFiltered: false });",
            "}",
            "",
            "export function useRenamedState(options: Options): State {",
            "  const { data: rows, isFetching } = useQuery(options);",
            "  const items = rows ?? [];",
            "  return listScreenStateOf({ items, isFetching, isPaused: false, failureKey: null, isFiltered: false });",
            "}",
            "",
            "export function usePagedState(options: PagedOptions): State {",
            "  const pages = useInfiniteQuery(options);",
            "  return listScreenStateOf({",
            "    items: pages.data?.pages.flatMap((page) => page.items) ?? [],",
            "    isFetching: pages.isFetching,",
            "    isPaused: false,",
            "    failureKey: null,",
            "    isFiltered: false,",
            "  });",
            "}",
            "",
            "// allowed: a count next to a derived state decides nothing",
            "export function useNoteCount(options: Options): number {",
            "  const query = useQuery(options);",
            "  const all = query.data ?? [];",
            "  return all.length;",
            "}"
          ]
        }
      }
    ]
  },
