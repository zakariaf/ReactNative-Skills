          "lines": [
            "// allowed: guards on a refresh that render nothing: the load-more guard TanStack recommends and an effect that waits",
            "import { useInfiniteQuery } from '@tanstack/react-query';",
            "import { useEffect } from 'react';",
            "",
            "type PagedOptions = Parameters<typeof useInfiniteQuery<{ readonly items: string[] }>>[0];",
            "",
            "export function useMoreTasks(options: PagedOptions, save: () => void): () => void {",
            "  const query = useInfiniteQuery(options);",
            "  const { isFetching } = query;",
            "  useEffect(() => {",
            "    if (isFetching) return;",
            "    save();",
            "  }, [isFetching, save]);",
            "  const onEndReached = (): void => {",
            "    if (query.isFetching || !query.hasNextPage) return;",
            "    void query.fetchNextPage();",
            "  };",
            "  return onEndReached;",
            "}",
            "",
            "export function isWorthSaving(items: readonly string[], query: { readonly isFetching: boolean }): boolean {",
            "  return items.some((item) => {",
            "    if (query.isFetching) return false;",
            "    return item !== '';",
            "  });",
            "}"
          ]
        }
      }
