            "import { useEffect } from 'react';",
            "import { Platform } from 'react-native';",
            "",
            "import { useAnnounce } from '@/ui/a11y/use-announce';",
            "",
            "export function useNotesSyncModel(failureText: string | null): { readonly failureText: string | null } {",
