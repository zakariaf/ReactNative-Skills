        "write": {
          "file": "src/features/tasks/use-task-titles.ts",
          "lines": [
            "// planted: three ways to default query data to [], each turns \"not loaded\" and \"failed\" into \"empty\"",
            "import { useQuery, useSuspenseQuery } from '@tanstack/react-query';",
            "",
            "import { listScreenStateOf } from '@/ui/feedback/screen-state';",
            "",
            "type Options = Parameters<typeof useQuery<string[]>>[0];",
            "",
            "export function useTaskTitles(options: Options): readonly string[] {",
            "  const { data = [] } = useQuery(options);",
            "  return data;",
            "}",
            "",
            "export function useDoneTitles(options: Options): readonly string[] {",
            "  const { isFetching, data: done = [] } = useQuery(options);",
            "  return isFetching ? [] : done;",
            "}",
            "",
            "export function useTitlesState(options: Options): ReturnType<typeof listScreenStateOf<string>> {",
            "  const query = useQuery(options);",
            "  return listScreenStateOf({",
            "    items: query.data ?? [],",
            "    isFetching: query.isFetching,",
            "    isPaused: false,",
            "    failureKey: null,",
            "    isFiltered: false,",
            "  });",
            "}",
            "",
            "// allowed: the state above is derived from the query, so a [] for a count decides nothing",
            "export function useTitleCount(options: Options): number {",
            "  const query = useQuery(options);",
            "  return (query.data ?? []).length;",
            "}",
            "",
            "// allowed: useSuspenseQuery always has data, so this default is dead code, not a wrong state",
            "export function useSuspendedTitles(options: Options): readonly string[] {",
            "  const { data = [] } = useSuspenseQuery(options);",
            "  return data;",
            "}"
          ]
        }
