  "bad-120hz-plugin-off": {
    "expect": ["config/with-promotion.js:6 [plist-120hz]", "turns CADisableMinimumFrameDurationOnPhone off"],
    "ops": [
      {
        "replace": {
          "file": "app.config.ts",
          "find": "    android: { package: 'com.example.tasks' },\n",
          "with": "    android: { package: 'com.example.tasks' },\n    plugins: ['./config/with-promotion.js'],\n"
        }
      },
      {
        "write": {
          "file": "config/with-promotion.js",
          "lines": [
            "// config/with-promotion.js: planted bug, the plugin turns the template's 120 Hz key off.",
            "const { withInfoPlist } = require('expo/config-plugins');",
            "",
            "module.exports = function withPromotion(config) {",
            "  return withInfoPlist(config, (next) => {",
            "    next.modResults.CADisableMinimumFrameDurationOnPhone = false;",
            "    return next;",
            "  });",
            "};"
          ]
        }
      }
    ]
  },
