{
  "bad-120hz-delete": {
    "expect": ["plugins/with-frame-rate.ts:6 [plist-120hz]"],
    "ops": [
      {
        "write": {
          "file": "plugins/with-frame-rate.ts",
          "lines": [
            "// plugins/with-frame-rate.ts: planted bug, any file under plugins/ is read; this one deletes the key.",
            "import { withInfoPlist, type ConfigPlugin } from 'expo/config-plugins';",
            "",
            "export const withFrameRate: ConfigPlugin = (config) =>",
            "  withInfoPlist(config, (next) => {",
            "    delete next.modResults['CADisableMinimumFrameDurationOnPhone'];",
            "    return next;",
            "  });"
          ]
        }
      }
    ]
  },
  "bad-120hz-false": {
    "expect": ["app.config.ts:12 [plist-120hz]", "iOS then caps the app at 60 fps on ProMotion iPhones"],
    "ops": [
      {
        "replace": {
          "file": "app.config.ts",
          "find": "    ios: { bundleIdentifier: 'com.example.tasks' },\n",
          "with": "    ios: {\n      bundleIdentifier: 'com.example.tasks',\n      infoPlist: { CADisableMinimumFrameDurationOnPhone: false },\n    },\n"
        }
      }
    ]
  },
