  "pass-daily-only": {
    "expect": ["RESULT: PASS"],
    "ops": [
      {
        "$comment": "A daily-only game: the contract entry has packCount 0, levelsPerPack 0 and no starRule; the levels folder keeps only the LevelsSpec (packs: [], table: []), its test and the daily goldens.",
        "json": {
          "file": "contracts/levels.json",
          "path": ["games", 0],
          "value": { "id": "lights-out", "packCount": 0, "levelsPerPack": 0, "daily": true, "endless": false }
        }
      },
      {
        "delete": [
          "src/games/lights-out/levels/pack-1.json",
          "src/games/lights-out/levels/pack-2.json",
          "src/games/lights-out/levels/pack-3.json",
          "src/games/lights-out/levels/lights-out-level-plan.ts",
          "src/games/lights-out/levels/lights-out-level-plan.test.ts",
          "src/games/lights-out/levels/lights-out-solver.ts",
          "src/games/lights-out/levels/lights-out-solver.test.ts"
        ]
      },
      {
        "write": {
          "file": "src/games/lights-out/levels/lights-out-levels.ts",
          "lines": [
            "// src/games/lights-out/levels/lights-out-levels.ts",
            "import type { LevelsSpec } from '@/core/game/levels';",
            "import type { LightsOutMove, LightsOutState } from '@/games/lights-out/rules/lights-out-types';",
            "",
            "export const LIGHTS_OUT_DAILY_SALT = 0x7c9e;",
            "export const LIGHTS_OUT_DAILY_DIFFICULTY = 45;",
            "",
            "/** A daily-only game: no packs, no table, no solver; only the daily mode. */",
            "export const LIGHTS_OUT_LEVELS: LevelsSpec<LightsOutState, LightsOutMove> = {",
            "  difficultyFor: () => LIGHTS_OUT_DAILY_DIFFICULTY,",
            "  packs: [],",
            "  table: [],",
            "  solver: null,",
            "  daily: { kind: 'daily', difficulty: LIGHTS_OUT_DAILY_DIFFICULTY, salt: LIGHTS_OUT_DAILY_SALT },",
            "  endless: { kind: 'none' },",
            "};"
          ]
        }
      },
      {
        "write": {
          "file": "src/games/lights-out/levels/lights-out-levels.test.ts",
