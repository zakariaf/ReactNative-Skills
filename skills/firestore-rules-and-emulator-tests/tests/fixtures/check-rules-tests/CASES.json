            "import { assertSucceeds, type RulesTestEnvironment } from '@firebase/rules-unit-testing';",
            "import { doc, getDoc } from 'firebase/firestore';",
            "",
            "import { createRulesTestEnvironment } from './rules-test-env';",
            "",
            "let testEnv: RulesTestEnvironment;",
            "",
            "beforeAll(async () => {",
            "  testEnv = await createRulesTestEnvironment('firestore');",
            "});",
            "",
            "describe('users/{uid}/reminders/{reminderId}', () => {",
            "  it('lets the owner read a reminder', async () => {",
            "    await assertSucceeds(getDoc(doc(testEnv.authenticatedContext('user-a').firestore(), 'users/user-a/reminders/r1')));",
            "  });",
            "});"
