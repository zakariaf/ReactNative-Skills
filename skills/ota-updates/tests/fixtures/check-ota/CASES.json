          "find": "    ...updatesConfig(EAS_PROJECT_ID),\n",
          "with": "    ...updatesConfig(EAS_PROJECT_ID),\n    updates: { ...updatesConfig(EAS_PROJECT_ID).updates, checkAutomatically: 'NEVER' },\n"
        }
