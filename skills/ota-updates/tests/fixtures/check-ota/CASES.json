{
  "bad-adapter-dev-client": {
    "expect": [
      "FAIL src/services/updates/expo-updates-adapter.ts:",
      "[adapter-enabled-guard] checkForUpdateAsync without mapping ERR_NOT_AVAILABLE_IN_DEV_CLIENT"
    ],
    "ops": [
      {
        "replace": {
          "file": "src/services/updates/expo-updates-adapter.ts",
          "find": "  'ERR_NOT_AVAILABLE_IN_DEV_CLIENT',\n",
          "with": ""
        }
      }
    ]
  },
  "bad-adapter-enabled-guard": {
    "expect": [
      "FAIL src/services/updates/expo-updates-adapter.ts:",
      "[adapter-enabled-guard] checkForUpdateAsync without reading Updates.isEnabled"
    ],
    "ops": [
      {
        "replace": {
          "file": "src/services/updates/expo-updates-adapter.ts",
          "find": "  if (!Updates.isEnabled) return err(DISABLED);\n",
          "with": "",
          "count": 3
        }
      }
    ]
  },
  "bad-build-channel": {
    "expect": ["[build-channel] build profile production (APP_VARIANT production) bakes channel \"prod\""],
    "ops": [{ "json": { "file": "eas.json", "path": ["build", "production", "channel"], "value": "prod" } }]
  },
  "bad-build-channel-environment": {
    "expect": ["[build-channel] build profile preview builds channel preview with environment production"],
    "ops": [{ "json": { "file": "eas.json", "path": ["build", "preview", "environment"], "value": "production" } }]
  },
  "bad-build-channel-missing": {
    "expect": [
      "[build-channel] build profile preview (EAS Build's default environment preview) bakes no channel into its binaries",
      "[build-channel] build profile production (EAS Build's default environment production) bakes no channel into its binaries"
    ],
    "ops": [
      {
        "write": {
          "file": "eas.json",
          "lines": [
            "{",
            "  \"cli\": { \"version\": \">= 24.10.0\", \"appVersionSource\": \"remote\" },",
            "  \"build\": {",
            "    \"development\": { \"developmentClient\": true, \"distribution\": \"internal\" },",
            "    \"preview\": { \"distribution\": \"internal\" },",
            "    \"production\": { \"autoIncrement\": true }",
            "  },",
            "  \"submit\": { \"production\": {} }",
            "}"
          ]
        }
      }
    ]
  },
  "bad-build-channel-no-env": {
    "expect": ["[build-channel] build profile production (environment production) bakes channel \"prod\""],
    "ops": [
      { "json": { "file": "eas.json", "path": ["build", "production", "env"], "delete": true } },
      { "json": { "file": "eas.json", "path": ["build", "production", "channel"], "value": "prod" } }
    ]
  },
  "bad-build-channel-no-profile": {
    "expect": ["[build-channel] no build profile builds the preview variant"],
    "ops": [
      { "json": { "file": "eas.json", "path": ["build", "preview-simulator"], "delete": true } },
      { "json": { "file": "eas.json", "path": ["build", "preview"], "delete": true } }
    ]
  },
  "bad-build-channel-unknown-variant": {
    "expect": [
      "[build-channel] build profile staging (APP_VARIANT staging) builds a variant that is not one of development, preview, production"
    ],
    "ops": [
      {
        "json": {
          "file": "eas.json",
          "path": ["build", "staging"],
          "value": {
            "distribution": "internal",
            "channel": "staging",
            "env": { "APP_VARIANT": "staging", "EXPO_PUBLIC_APP_VARIANT": "staging" }
          }
        }
      }
    ]
  },
  "bad-cross-channel-republish": {
    "expect": ["[cross-channel-republish] eas update:republish to another channel"],
    "ops": [
      {
        "json": {
          "file": "package.json",
          "path": ["scripts", "ota:promote"],
          "value": "eas update:republish --channel preview --destination-channel production"
        }
      }
    ]
  },
  "bad-emergency-launch": {
    "expect": ["FAIL src/services/updates/expo-updates-adapter.ts:1 [emergency-launch]"],
    "ops": [
      {
