          "lines": [
            "// src/features/settings/use-restart-model.ts",
            "import * as Updates from 'expo-updates';",
            "",
            "/** Planted: a feature model that reads the native updater directly instead of the UpdatesPort. */",
            "export function useRestartModel(): { readonly ready: boolean } {",
            "  const { isUpdatePending } = Updates.useUpdates();",
            "  return { ready: isUpdatePending };",
            "}"
          ]
        }
      }
