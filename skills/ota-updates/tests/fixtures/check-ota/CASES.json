    "ops": [
      {
        "replace": {
          "file": ".eas/workflows/preview-update.yml",
          "find": "    if: ${{ needs.get_ios_build.outputs.build_id && needs.get_android_build.outputs.build_id }}\n",
          "with": ""
        }
      }
    ]
  },
  "bad-launch-nonblocking": {
    "expect": ["[launch-nonblocking] updates.fallbackToCacheTimeout is 30000"],
    "ops": [
      {
        "replace": {
          "file": "app.config.ts",
          "find": "    ...updatesConfig(EAS_PROJECT_ID),\n",
          "with": "    ...updatesConfig(EAS_PROJECT_ID),\n    updates: { ...updatesConfig(EAS_PROJECT_ID).updates, fallbackToCacheTimeout: 30000 },\n"
        }
      }
    ]
  },
  "bad-launch-nonblocking-module-scope": {
    "expect": [
      "[launch-nonblocking] updates.fallbackToCacheTimeout is 30000: every cold start waits on the network, up to that long, on a slow connection (production)"
    ],
    "ops": [
      {
        "write": {
          "file": "src/config/build-variant.ts",
          "content": "// src/config/build-variant.ts\n// Read once at module scope: each variant must be evaluated in a fresh module graph to see its own value.\nexport const BUILD_VARIANT = process.env.APP_VARIANT ?? 'development';\n"
        }
      },
      {
        "replace": {
          "file": "app.config.ts",
          "find": "import { updatesConfig } from './src/config/updates-config.ts';\n",
          "with": "import { BUILD_VARIANT } from './src/config/build-variant.ts';\nimport { updatesConfig } from './src/config/updates-config.ts';\n"
        }
      },
      {
        "replace": {
          "file": "app.config.ts",
          "find": "    ...updatesConfig(EAS_PROJECT_ID),\n",
          "with": "    ...updatesConfig(EAS_PROJECT_ID),\n    updates: { ...updatesConfig(EAS_PROJECT_ID).updates, ...(BUILD_VARIANT === 'production' ? { fallbackToCacheTimeout: 30000 } : {}) },\n"
        }
      }
    ]
  },
