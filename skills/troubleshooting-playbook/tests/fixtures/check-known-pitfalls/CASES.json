          "file": "src/features/tasks/use-task-stats.ts",
          "lines": [
            "// src/features/tasks/use-task-stats.ts",
            "import { useShallow } from 'zustand/shallow';",
            "",
            "import { useTasksStore } from '@/stores/tasks-store';",
            "",
            "export function useOpenCount(): number {",
            "  return useTasksStore((state) => state.tasks.filter((task) => !task.isDone).length);",
            "}",
            "",
            "export function useFirstTitle(): string | undefined {",
            "  return useTasksStore((state) => state.tasks.map((task) => task.title)[0]);",
            "}",
            "",
            "export function useTitles(): string[] {",
            "  return useTasksStore(useShallow((state) => state.tasks.map((task) => task.title)));",
            "}",
            "",
            "export function useTasks() {",
            "  return useTasksStore((state) => state.tasks);",
            "}"
          ]
        }
      }
