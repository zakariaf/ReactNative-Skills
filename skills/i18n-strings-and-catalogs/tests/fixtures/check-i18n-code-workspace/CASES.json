{
  "bad-app-entry": {
    "expect": [
      "[polyfill-first]",
      "apps/mobile/package.json:5",
      "the app entry is \"expo-router/entry\""
    ],
    "ops": [
      {
        "json": {
          "file": "apps/mobile/package.json",
          "path": [
            "main"
          ],
          "value": "expo-router/entry"
        }
      }
    ]
  },
  "bad-app-jest": {
    "expect": [
      "[jest-polyfills]",
      "apps/mobile/jest.config.js:10",
      "does not load intl-polyfills.ts"
    ],
    "ops": [
      {
        "replace": {
          "file": "apps/mobile/jest.config.js",
          "find": "setupFiles: POLYFILL_SETUP",
          "with": "setupFiles: []"
        }
      }
    ]
  },
  "bad-app-locales": {
    "expect": [
      "[system-text-locales]",
      "apps/mobile/app.config.ts:1",
      "sets no \"locales\""
    ],
    "ops": [
      {
        "replace": {
          "file": "apps/mobile/app.config.ts",
          "find": "    locales: nativeLocales(projectRoot, NATIVE_TEXT_KEYS),\n",
          "with": ""
        }
      }
    ]
  },
  "bad-app-text": {
    "expect": [
      "[jsx-literal-text]",
      "apps/mobile/src/features/tasks/tasks-screen.tsx:19",
      "My tasks"
    ],
    "ops": [
      {
        "replace": {
          "file": "apps/mobile/src/features/tasks/tasks-screen.tsx",
          "find": "<T id=\"tasks.list.title\" testID=\"tasks.title\" />",
          "with": "<AppText testID=\"tasks.title\">My tasks</AppText>"
        }
      }
    ]
  },
  "bad-root-jest-path": {
    "expect": [
      "FAIL jest.config.js:5 [jest-polyfills] setupFiles loads",
      "the i18n folder is apps/mobile/src/i18n"
    ],
    "extends": "pass-root-jest",
    "ops": [
      {
        "$comment": "the single app's path kept in the root config: no such file, so Jest runs on Node's ICU",
        "replace": {
          "file": "jest.config.js",
          "find": "const INTL_POLYFILLS = 'apps/mobile/src/i18n/intl-polyfills.ts';",
          "with": "const INTL_POLYFILLS = 'src/i18n/intl-polyfills.ts';"
        }
      }
    ]
  },
  "error-no-app-dir": {
    "expect": [
      "ERROR [bad-input] nothing to check: no .ts/.tsx files under src",
      "--app-dir apps/mobile"
    ],
    "args": "{dir}"
  },
  "pass-root-jest": {
    "expect": [
      "RESULT: PASS"
    ],
    "ops": [
      {
        "$comment": "the multi-package form: one root jest.config.js for every workspace loads the app's polyfills by their repo path",
        "rename": {
          "from": "apps/mobile/jest.config.js",
          "to": "jest.config.js"
        }
      },
      {
        "replace": {
          "file": "jest.config.js",
          "find": "const INTL_POLYFILLS = 'src/i18n/intl-polyfills.ts';",
          "with": "const INTL_POLYFILLS = 'apps/mobile/src/i18n/intl-polyfills.ts';"
        }
      }
    ]
  }
}
