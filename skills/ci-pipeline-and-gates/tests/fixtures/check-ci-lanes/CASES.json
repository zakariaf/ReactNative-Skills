  "pass-fetch-depth": {
    "expect": ["RESULT: PASS"],
    "ops": [
      {
        "replace": {
          "file": ".github/workflows/ci.yml",
          "find": "          persist-credentials: false\n",
          "with": "          persist-credentials: false\n          # A gate inside verify compares with the target branch (origin/<base>): full history, no later git fetch.\n          fetch-depth: 0\n"
        }
      },
      {
        "replace": {
          "file": ".github/workflows/ci.yml",
          "find": "        run: npm run verify\n",
          "with": "        run: npm run verify\n        env:\n          GATE_BASE: origin/${{ github.base_ref || 'main' }}\n"
        }
      }
    ]
  },
  "pass-lane-opt-outs": {
    "expect": ["RESULT: PASS"],
    "ops": [
      { "delete": ".github/workflows/devices.yml" },
      {
        "json": {
          "file": "contracts/ci.json",
          "path": ["laneOptOuts"],
          "value": {
            "android-build": "Android builds run on EAS for every release; no emulator lane in CI yet.",
            "android-e2e": "Android flows run before each release on a developer machine (android-emulator-build).",
            "ios-build": "macOS minutes are not budgeted for this private repository; built locally before releases.",
            "ios-e2e": "macOS minutes are not budgeted for this private repository; flows run locally before releases."
          }
        }
      }
    ]
  },
  "pass-multi-package": {
    "expect": ["3 workflows checked, 0 problems", "RESULT: PASS"],
    "args": "{dir} --app-dir apps/mobile",
    "ops": [
      {
        "write": {
          "file": "apps/mobile/package.json",
          "json": {
            "name": "mobile",
            "private": true,
            "scripts": {
              "build:ios:sim": "node scripts/build/build-ios-sim.ts",
              "build:android:emu": "node scripts/build/build-android-emu.ts",
              "e2e:ios": "node scripts/e2e/run-e2e.ts --platform ios",
              "e2e:android": "node scripts/e2e/run-e2e.ts --platform android"
            }
          }
        }
      },
      { "json": { "file": "package.json", "path": ["scripts", "build:ios:sim"], "delete": true } },
      { "json": { "file": "package.json", "path": ["scripts", "build:android:emu"], "delete": true } },
      { "json": { "file": "package.json", "path": ["scripts", "e2e:ios"], "delete": true } },
      { "json": { "file": "package.json", "path": ["scripts", "e2e:android"], "delete": true } },
      {
        "replace": {
          "file": ".github/workflows/devices.yml",
          "find": "run: npm run build:android:emu -- --variant preview",
          "with": "run: npm run -w apps/mobile build:android:emu -- --variant preview"
        }
      },
      {
        "replace": {
          "file": ".github/workflows/devices.yml",
          "find": "run: npm run e2e:android\n",
          "with": "run: npm run e2e:android --workspace apps/mobile\n"
        }
      },
      {
        "replace": {
          "file": ".github/workflows/devices.yml",
          "find": "run: npm run build:ios:sim -- --variant preview",
          "with": "run: npm run --workspace=apps/mobile build:ios:sim -- --variant preview"
        }
      },
      {
        "replace": {
          "file": ".github/workflows/devices.yml",
          "find": "run: npm run e2e:ios\n",
          "with": "run: npm run e2e:ios -w ./apps/mobile/\n"
        }
      }
    ]
  },
  "pass-not-applicable": {
    "expect": ["NOT APPLICABLE: no .github/workflows/ folder: this repo has no GitHub Actions CI", "RESULT: PASS"],
