  "bad-release-nested-script": {
    "expect": [
      ".github/workflows/release.yml:11 [release-trigger] push starts a workflow that runs npm run ship (eas build)",
      "RESULT: FAIL"
    ],
    "ops": [
      { "json": { "file": "package.json", "path": ["scripts", "ship"], "value": "npm run -s store:build" } },
      {
        "json": {
          "file": "package.json",
          "path": ["scripts", "store:build"],
          "value": "eas build --profile production --platform all --non-interactive --auto-submit"
        }
      },
      { "json": { "file": "package.json", "path": ["scripts", "loop:a"], "value": "npm run loop:b" } },
      { "json": { "file": "package.json", "path": ["scripts", "loop:b"], "value": "npm run loop:a" } },
      {
        "replace": {
          "file": ".github/workflows/release.yml",
          "find": "on:\n  workflow_dispatch:\n",
          "with": "on:\n  push:\n    branches: [main]\n  workflow_dispatch:\n"
        }
      },
      {
        "replace": {
          "file": ".github/workflows/release.yml",
          "find": "run: >-\n          eas build --profile production --platform \"$PLATFORM\" --non-interactive\n          --freeze-credentials --no-wait --message \"release from $GITHUB_SHA\"\n",
          "with": "run: npm run loop:a && npm run ship\n"
        }
      }
    ]
  },
