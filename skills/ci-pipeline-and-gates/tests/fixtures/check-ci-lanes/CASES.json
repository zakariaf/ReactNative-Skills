{
  "bad-ad-hoc-command": {
    "expect": [".github/workflows/ci.yml:46 [ad-hoc-command]", "RESULT: FAIL"],
    "ops": [
      {
        "replace": {
          "file": ".github/workflows/ci.yml",
          "find": "run: npm run verify",
          "with": "run: npm run verify && npx jest --ci"
        }
      }
    ]
  },
