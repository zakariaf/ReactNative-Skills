            "// src/hooks/use-today.ts",
            "import { useSyncExternalStore } from 'react';",
            "import { AppState } from 'react-native';",
            "",
            "import { useServices } from '@/services/services-context';",
            "",
            "import type { DateKey } from '@/core/dates/date-key';",
            "",
            "function subscribeToAppState(onChange: () => void): () => void {",
            "  const subscription = AppState.addEventListener('change', onChange);",
            "  return () => {",
            "    subscription.remove();",
            "  };",
            "}",
            "",
            "/** Today, read on every render; re-rendered only when the app changes state. */",
            "export function useToday(): DateKey {",
            "  const { clock } = useServices();",
            "  return useSyncExternalStore(subscribeToAppState, () => clock.today());",
            "}"
          ]
