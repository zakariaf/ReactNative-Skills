{
  "$comment": "Generated by check-native-snapshot.mjs --write (expo-prebuild-and-config-plugins): the native config npx expo prebuild derives from app.config.ts and its config plugins (npx expo config --type introspect). Review its diff like code; regenerate with --write only after a deliberate change.",
  "variant": "production",
  "ios": {
    "entitlements": {
      "aps-environment": "development",
      "com.apple.developer.applesignin": [
        "Default"
      ]
    },
    "expoPlist": {
      "EXUpdatesCheckOnLaunch": "ALWAYS",
      "EXUpdatesEnableBsdiffPatchSupport": true,
      "EXUpdatesEnabled": false,
      "EXUpdatesLaunchWaitMs": 0
    },
    "infoPlist": {
      "CADisableMinimumFrameDurationOnPhone": true,
      "CFBundleAllowMixedLocalizations": true,
      "CFBundleDevelopmentRegion": "$(DEVELOPMENT_LANGUAGE)",
      "CFBundleDisplayName": "Tasks",
      "CFBundleExecutable": "$(EXECUTABLE_NAME)",
      "CFBundleIdentifier": "$(PRODUCT_BUNDLE_IDENTIFIER)",
      "CFBundleInfoDictionaryVersion": "6.0",
      "CFBundleLocalizations": [
        "en",
        "ar"
      ],
      "CFBundleName": "$(PRODUCT_NAME)",
      "CFBundlePackageType": "$(PRODUCT_BUNDLE_PACKAGE_TYPE)",
      "CFBundleSignature": "????",
      "CFBundleURLTypes": [
        {
          "CFBundleURLSchemes": [
            "tasks",
            "com.example.tasks"
          ]
        }
      ],
      "LSMinimumSystemVersion": "12.0",
      "LSRequiresIPhoneOS": true,
      "NSAppTransportSecurity": {
        "NSAllowsArbitraryLoads": true,
        "NSExceptionDomains": {
          "localhost": {
            "NSExceptionAllowsInsecureHTTPLoads": true
          }
        }
      },
      "NSBonjourServices": [
        "_expo._tcp"
      ],
      "NSCameraUsageDescription": "Allow $(PRODUCT_NAME) to access your camera",
      "NSLocalNetworkUsageDescription": "Expo Dev Launcher uses the local network to discover and connect to development servers running on your computer.",
      "NSMicrophoneUsageDescription": "Allow $(PRODUCT_NAME) to access your microphone",
      "NSPhotoLibraryUsageDescription": "Allow $(PRODUCT_NAME) to access your photos",
      "NSUserActivityTypes": [
        "$(PRODUCT_BUNDLE_IDENTIFIER).expo.index_route"
      ],
      "RCTMetroPort": "$(RCT_METRO_PORT)",
      "UIBackgroundModes": [
        "fetch"
      ],
      "UILaunchStoryboardName": "SplashScreen",
      "UIRequiredDeviceCapabilities": [
        "armv7"
      ],
      "UIRequiresFullScreen": false,
      "UIStatusBarStyle": "UIStatusBarStyleDefault",
      "UISupportedInterfaceOrientations": [
        "UIInterfaceOrientationPortrait",
        "UIInterfaceOrientationPortraitUpsideDown"
      ],
      "UISupportedInterfaceOrientations~ipad": [
        "UIInterfaceOrientationPortrait",
        "UIInterfaceOrientationPortraitUpsideDown",
        "UIInterfaceOrientationLandscapeLeft",
        "UIInterfaceOrientationLandscapeRight"
      ],
      "UIUserInterfaceStyle": "Automatic",
      "UIViewControllerBasedStatusBarAppearance": false
    },
    "podfileProperties": {
      "expo.inlineModules.watchedDirectories": "[]",
      "expo.inlineModules.xcodeProjectTargets": "{\"mainTarget\":\"Tasks\",\"targets\":[]}"
    }
  },
  "android": {
    "application": "allowBackup=true enableOnBackInvokedCallback=true icon=@mipmap/ic_launcher label=@string/app_name localeConfig=@xml/locales_config name=.MainApplication roundIcon=@mipmap/ic_launcher_round supportsRtl=true theme=@style/AppTheme",
    "components": {
      "activity .MainActivity": {
        "attributes": "configChanges=keyboard|keyboardHidden|orientation|screenSize|screenLayout|uiMode|smallestScreenSize|locale|layoutDirection exported=true launchMode=singleTask screenOrientation=portrait theme=@style/Theme.App.SplashScreen windowSoftInputMode=adjustResize",
        "intentFilters": [
          "action=MAIN category=LAUNCHER",
          "action=VIEW category=DEFAULT category=BROWSABLE data(scheme=tasks)"
        ]
      }
    },
    "features": [
      "android.hardware.camera required=false",
      "android.hardware.camera.autofocus required=false"
    ],
    "gradleProperties": {
      "expo.inlineModules.watchedDirectories": "[]"
    },
    "metaData": {
      "expo.modules.updates.ENABLED": "false",
      "expo.modules.updates.ENABLE_BSDIFF_PATCH_SUPPORT": "true",
      "expo.modules.updates.EXPO_UPDATES_CHECK_ON_LAUNCH": "ALWAYS",
      "expo.modules.updates.EXPO_UPDATES_LAUNCH_WAIT_MS": "0"
    },
    "permissions": [
      "android.permission.INTERNET",
      "android.permission.READ_EXTERNAL_STORAGE maxSdkVersion=32 tools:replace=android:maxSdkVersion",
      "android.permission.RECORD_AUDIO",
      "android.permission.SYSTEM_ALERT_WINDOW",
      "android.permission.VIBRATE",
      "android.permission.WRITE_EXTERNAL_STORAGE maxSdkVersion=32 tools:replace=android:maxSdkVersion"
    ],
    "queries": [
      "intent action=VIEW category=BROWSABLE data(scheme=https)"
    ],
    "strings": {
      "app_name": "Tasks",
      "expo_splash_screen_resize_mode": "contain",
      "expo_system_ui_user_interface_style": "automatic"
    }
  }
}
