  "pass-icon-composer": {
    "expect": ["RESULT: PASS"],
    "ops": [
      { "delete": ["assets/icons/production/icon-dark.png", "assets/icons/production/icon-tinted.png"] },
      {
        "json": {
          "file": "contracts/app-art.json",
          "path": ["optional"],
          "value": ["dark", "tinted", "featureGraphic"]
        },
        "$comment": "An Icon Composer app: dark and tinted are hand-made in the .icon folder, so the renderer writes neither (DELETE.txt removes the base's copies, which the default contract rendered)."
      },
      {
        "replace": {
          "file": "app.config.ts",
          "find": "icon: iosAppearanceIcon(projectRoot)",
          "with": "icon: `${ICONS}/expo.icon`"
        }
      },
      {
        "replace": {
          "file": "app.config.ts",
          "find": "import { iosAppearanceIcon, splashPlugin } from",
          "with": "import { splashPlugin } from"
        }
      }
    ]
  },
