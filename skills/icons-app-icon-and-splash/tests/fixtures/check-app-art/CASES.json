  "pass-icons-only": {
    "expect": [
      "NOT APPLICABLE: the app does not render its app art in code (no scripts/art/render-app-art.ts; contracts/app-art.json declares no rendered art (no outputs, optional or glyphArea))"
    ],
    "ops": [
      { "delete": "scripts/art/render-app-art.ts" },
      {
        "$comment": "An app that only needs check-icons' allow-lists keeps them in contracts/app-art.json without adopting the art pipeline.",
        "write": {
          "file": "contracts/app-art.json",
          "json": { "icons": { "allowImages": ["src/features/tasks/images/*.png"] } }
        }
      },
      { "delete": ["assets/icons/production/icon-dark.png", "src/ui/icons/brand-mark.ts"] }
    ]
  },
