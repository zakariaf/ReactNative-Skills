    ],
    "ops": [
      {
        "$comment": "iosAppearanceIcon() is called, but not as ios.icon: dark and tinted never ship.",
        "replace": {
          "file": "app.config.ts",
          "find": "icon: iosAppearanceIcon(projectRoot) },",
          "with": "icon: `${ICONS}/icon.png` },"
        }
      },
      {
        "replace": {
          "file": "app.config.ts",
          "find": "  return {\n    ...config,",
          "with": "  const appearances = iosAppearanceIcon(projectRoot);\n  return {\n    ...config,\n    extra: { appearances },"
        }
      }
    ]
  },
