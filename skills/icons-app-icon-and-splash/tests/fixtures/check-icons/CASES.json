  "pass-no-icon-set": {
    "expect": ["no icon set yet (src/ui/icons/icon-paths.ts and design/icon-layers.json are absent)", "RESULT: PASS"],
    "ops": [{ "delete": ["src/ui/icons", "design/icon-layers.json", "src/features/tasks/tasks-screen.tsx"] }]
  },
  "pass-svg-chart": {
    "expect": ["RESULT: PASS"],
    "ops": [
      {
        "$comment": "react-native-svg drawing a chart (not a UI icon) is allowed without an allow-list entry.",
        "write": {
          "file": "src/features/tasks/components/progress-ring.tsx",
          "lines": [
            "// src/features/tasks/components/progress-ring.tsx",
            "import Svg, { Circle } from 'react-native-svg';",
            "",
            "export function ProgressRing({ share }: { readonly share: number }): React.JSX.Element {",
            "  return (",
            "    <Svg width={96} height={96} viewBox=\"0 0 96 96\">",
            "      <Circle cx={48} cy={48} r={40} strokeWidth={8} strokeDasharray={`${String(share * 251)} 251`} />",
            "    </Svg>",
            "  );",
            "}"
          ]
        }
      }
    ]
  },
  "pass-text-symbols": {
    "expect": ["RESULT: PASS"],
    "ops": [
      {
        "$comment": "Text-presentation symbols render as font glyphs, not emoji: arrows, card suits, a check mark, a warning sign without VS16.",
        "write": {
          "file": "src/i18n/catalogs/en.json",
          "content": "{\n  \"tasks.title\": \"Tasks\",\n  \"tasks.swap\": \"Swap ↔ order\",\n  \"games.suit\": \"♠ Spades ♥ Hearts\",\n  \"tasks.done\": \"Done ✔\",\n  \"tasks.overdue\": \"⚠ Overdue\",\n  \"legal.mark\": \"Tasks™ ©\"\n}\n"
        }
      }
    ]
  }
