{
  "bad-directional-drift": {
    "expect": [
      "[icon-set] DIRECTIONAL_ICONS [back, forward, chevron] differs from the layers' directional list [back, forward, chevron, undo]"
    ],
    "ops": [{ "replace": { "file": "src/ui/icons/icon-paths.ts", "find": "  'undo',\n]);", "with": "]);" } }]
  },
  "bad-emoji": {
    "expect": ["FAIL src/i18n/catalogs/en.json:3 [no-emoji]", "FAIL src/i18n/catalogs/en.json:4 [no-emoji]"],
    "ops": [
      {
        "write": {
          "file": "src/i18n/catalogs/en.json",
          "content": "{\n  \"tasks.title\": \"Tasks\",\n  \"tasks.empty\": \"All done 🎉\",\n  \"tasks.streak\": \"On a roll 🔥\"\n}\n"
        }
      }
    ]
  },
  "bad-emoji-vs16": {
    "expect": ["FAIL src/i18n/catalogs/en.json:3 [no-emoji]", "RESULT: FAIL (1 problems)"],
    "ops": [
      {
        "write": {
          "file": "src/i18n/catalogs/en.json",
          "content": "{\n  \"tasks.title\": \"Tasks\",\n  \"tasks.overdue\": \"⚠️ Overdue\"\n}\n"
        }
      }
    ]
  },
  "bad-generated-header": {
    "expect": ["FAIL src/ui/icons/icon-paths.ts:1 [generated-header]"],
    "ops": [
      {
        "replace": {
          "file": "src/ui/icons/icon-paths.ts",
          "find": "// GENERATED by scripts/art/build-icon-paths.ts from design/icon-layers.json. Do not edit.\n",
          "with": "// Icon paths (tweaked by hand).\n"
        }
      }
    ]
  },
  "bad-icon-library": {
    "expect": [
      "FAIL src/features/tasks/add-button.tsx:2 [no-icon-library] @expo/vector-icons draws icons outside the app's icon set"
    ],
    "ops": [
      {
        "write": {
          "file": "src/features/tasks/add-button.tsx",
          "content": "// src/features/tasks/add-button.tsx\nimport Ionicons from '@expo/vector-icons/Ionicons';\n\nexport const AddIcon = (): React.JSX.Element => <Ionicons name=\"add\" size={24} />;\n"
        }
      }
    ]
  },
  "bad-icon-library-scoped": {
    "expect": [
      "FAIL src/features/tasks/add-button.tsx:2 [no-icon-library] @react-native-vector-icons/ionicons draws icons outside the app's icon set",
      "FAIL src/features/tasks/add-button.tsx:3 [no-icon-library] @tabler/icons-react-native draws icons outside the app's icon set",
      "RESULT: FAIL (2 problems)"
    ],
    "ops": [
      {
        "write": {
          "file": "src/features/tasks/add-button.tsx",
          "content": "// src/features/tasks/add-button.tsx\nimport Ionicons from '@react-native-vector-icons/ionicons';\nimport { IconPlus } from '@tabler/icons-react-native';\n\nexport const AddIcon = (): React.JSX.Element => <Ionicons name=\"add\" size={24} />;\nexport const PlusIcon = (): React.JSX.Element => <IconPlus size={24} />;\n"
        }
      }
    ]
  },
  "bad-icon-set-extra": {
    "expect": ["[icon-set] icon \"plus\" has no layers in design/icon-layers.json"],
    "ops": [{ "json": { "file": "design/icon-layers.json", "path": ["glyphs", "plus"], "delete": true } }]
  },
  "bad-icon-set-missing": {
    "expect": ["[icon-set] icon \"plus\" is in the layers but not in ICON_PATHS"],
    "ops": [
      { "replace": { "file": "src/ui/icons/icon-paths.ts", "find": "\\n  plus: '[^']*',", "with": "", "regex": true } }
    ]
  },
  "bad-image-file": {
    "expect": ["[no-image-file] image file in app source", "src/features/tasks/empty-list.png"],
    "ops": [
      {
        "png": {
          "files": ["src/features/tasks/empty-list.png"],
          "width": 64,
          "height": 64,
          "fill": "#FFFFFF",
          "rects": []
        }
      }
    ]
  },
  "bad-image-import": {
    "expect": [
      "FAIL src/features/tasks/empty-state.ts:2 [no-image-file] image import \"../../../assets/images/empty.png\""
    ],
    "ops": [
      {
        "write": {
          "file": "src/features/tasks/empty-state.ts",
          "content": "// src/features/tasks/empty-state.ts\nexport const EMPTY_ART: number = require('../../../assets/images/empty.png');\n"
        }
      }
    ]
  },
  "bad-layers-invalid": {
    "expect": [
      "FAIL design/icon-layers.json:1 [icon-layers-invalid] directional icon \"redo\" is not a glyph of the set"
    ],
    "ops": [
      {
        "json": {
          "file": "design/icon-layers.json",
          "path": ["directional"],
          "value": ["back", "forward", "chevron", "undo", "redo"]
        }
      }
    ]
  },
  "bad-layers-missing": {
    "expect": ["FAIL design/icon-layers.json [icon-layers-missing]"],
    "ops": [{ "delete": "design/icon-layers.json" }]
  },
  "bad-layers-op": {
    "expect": [
      "FAIL design/icon-layers.json:1 [icon-layers-invalid] \"plus\" layer 0 has op \"outline\"; use stroke or fill"
    ],
    "ops": [
      {
        "json": { "file": "design/icon-layers.json", "path": ["glyphs", "plus", "layers", 0, "op"], "value": "outline" }
      }
    ]
  },
  "bad-module-load": {
    "expect": ["FAIL src/ui/icons/icon-paths.ts:1 [icon-module-load]"],
    "ops": [
      {
        "replace": {
          "file": "src/ui/icons/icon-paths.ts",
          "find": "export const ICON_PATHS = {",
          "with": "export const ICON_PATHS = {{"
        }
      }
    ]
  },
  "bad-monorepo-emoji": {
    "expect": ["FAIL apps/mobile/src/i18n/catalogs/en.json:3 [no-emoji]"],
    "ops": [
      {
        "write": {
          "file": "src/i18n/catalogs/en.json",
          "content": "{\n  \"tasks.title\": \"Tasks\",\n  \"tasks.empty\": \"All done 🎉\",\n  \"tasks.streak\": \"On a roll 🔥\"\n}\n"
        }
      },
      { "rename": { "from": "app.config.ts", "to": "apps/mobile/app.config.ts" } },
      { "rename": { "from": "contracts", "to": "apps/mobile/contracts" } },
      { "rename": { "from": "design", "to": "apps/mobile/design" } },
      { "rename": { "from": "package.json", "to": "apps/mobile/package.json" } },
      { "rename": { "from": "scripts", "to": "apps/mobile/scripts" } },
      { "rename": { "from": "src", "to": "apps/mobile/src" } },
      { "rename": { "from": "tsconfig.json", "to": "apps/mobile/tsconfig.json" } },
      {
        "write": {
          "file": "package.json",
          "json": { "name": "tasks", "private": true, "workspaces": ["apps/*", "packages/*"] }
        }
      },
      { "write": { "file": "packages/shared/package.json", "json": { "name": "@tasks/shared", "private": true } } }
    ]
  },
  "bad-path-edit": {
    "expect": ["[icon-path-stale] \"plus\" covers", "differently from its layers"],
    "ops": [
      {
        "replace": {
          "file": "src/ui/icons/icon-paths.ts",
          "find": "plus: '[^']*'",
          "with": "plus: 'M3.8 3.8L20.2 3.8L20.2 20.2L3.8 20.2Z'",
          "regex": true
        }
      }
    ]
  },
  "bad-path-grid": {
    "expect": ["[icon-path-grid] \"plus\" spans 30.0,30.0 to 40.0,40.0, outside the 24 grid"],
    "ops": [
      {
        "replace": {
          "file": "src/ui/icons/icon-paths.ts",
          "find": "plus: '[^']*'",
          "with": "plus: 'M30 30L40 30L40 40L30 40Z'",
          "regex": true
        }
      },
      {
        "json": {
          "file": "design/icon-layers.json",
          "path": ["glyphs", "plus", "layers"],
          "value": [{ "op": "fill", "fillRule": "nonzero", "d": "M30 30L40 30L40 40L30 40Z" }]
        }
      }
    ]
  },
  "bad-path-syntax": {
    "expect": ["FAIL src/ui/icons/icon-paths.ts:15 [icon-path-syntax] \"plus\":"],
    "ops": [
      { "replace": { "file": "src/ui/icons/icon-paths.ts", "find": "plus: 'M", "with": "plus: 'M#", "regex": true } }
    ]
  },
  "bad-paths-missing": {
    "expect": ["FAIL src/ui/icons/icon-paths.ts [icon-paths-missing]"],
    "ops": [{ "delete": "src/ui/icons/icon-paths.ts" }]
  },
  "bad-stale-path": {
    "expect": ["[icon-path-stale] \"plus\" is 1.20 units off its layers (a stale or swapped path)"],
    "ops": [
      {
        "replace": {
          "file": "src/ui/icons/icon-paths.ts",
          "find": "plus: '[^']*'",
          "with": "plus: 'M5 5L19 5L19 19L5 19Z'",
          "regex": true
        }
      }
    ]
  },
  "error-monorepo-no-source": {
    "expect": ["ERROR [bad-input] apps/mobile: nothing to check: app source folder"],
    "ops": [
      { "delete": "src" },
      { "rename": { "from": "app.config.ts", "to": "apps/mobile/app.config.ts" } },
      { "rename": { "from": "contracts", "to": "apps/mobile/contracts" } },
      { "rename": { "from": "design", "to": "apps/mobile/design" } },
      { "rename": { "from": "package.json", "to": "apps/mobile/package.json" } },
      { "rename": { "from": "scripts", "to": "apps/mobile/scripts" } },
      { "rename": { "from": "tsconfig.json", "to": "apps/mobile/tsconfig.json" } },
      {
        "write": {
          "file": "package.json",
          "json": { "name": "tasks", "private": true, "workspaces": ["apps/*", "packages/*"] }
        }
      },
      { "write": { "file": "packages/shared/package.json", "json": { "name": "@tasks/shared", "private": true } } }
    ]
  },
  "error-no-source": {
    "expect": ["ERROR [bad-input] nothing to check: app source folder"],
    "ops": [{ "delete": "src" }]
  },
  "pass-aliased-image": {
    "expect": ["RESULT: PASS"],
    "ops": [
      {
        "$comment": "An image imported through an extra tsconfig alias (@/assets/* -> ./assets/*) is matched against the allow-list at its real path.",
        "json": { "file": "tsconfig.json", "path": ["compilerOptions", "paths", "@/assets/*"], "value": ["./assets/*"] }
      },
      {
        "write": {
          "file": "src/features/about/team-photo.ts",
          "content": "// src/features/about/team-photo.ts\nexport const TEAM_PHOTO: number = require('@/assets/photos/team.jpg');\n"
        }
      },
      {
        "json": { "file": "contracts/app-art.json", "path": ["icons", "allowImages"], "value": ["assets/photos/*.jpg"] }
      }
    ]
  },
  "pass-allowed-image": {
    "expect": ["RESULT: PASS"],
    "ops": [
      {
        "png": {
          "files": ["src/features/onboarding/welcome.png"],
          "width": 64,
          "height": 48,
          "fill": "#88AACC",
          "rects": []
        }
      },
      {
        "write": {
          "file": "src/features/onboarding/welcome-art.ts",
          "content": "// src/features/onboarding/welcome-art.ts\nexport const WELCOME_PHOTO: number = require('./welcome.png');\n"
        }
      },
      {
        "json": {
          "file": "contracts/app-art.json",
          "path": ["icons", "allowImages"],
          "value": ["src/features/onboarding/*.png"]
        }
      },
      {
        "write": {
          "file": "src/features/tasks/native-tabs.tsx",
          "content": "// src/features/tasks/native-tabs.tsx\nimport { SymbolView } from 'expo-symbols';\n\nexport { SymbolView };\n"
        }
      },
      { "json": { "file": "contracts/app-art.json", "path": ["icons", "allowPackages"], "value": ["expo-symbols"] } }
    ]
  },
  "pass-installed-skills": {
    "expect": ["RESULT: PASS"],
    "ops": [
      {
        "write": {
          "file": ".agents/skills/demo-skill/SKILL.md",
          "lines": ["# planted: an installed skill is never scanned"]
        }
      },
      { "write": { "file": ".agents/skills/demo-skill/src/ui/badge.ts", "lines": ["export const BADGE = 'new 🔥';"] } },
      { "write": { "file": "skills/demo-skill/SKILL.md", "lines": ["# planted"] } },
      {
        "write": {
          "file": "skills/demo-skill/src/ui/arrow.tsx",
          "lines": ["import Svg from 'react-native-svg';", "export { Svg };"]
        }
      },
      {
        "write": {
          "file": "src/features/tasks/tasks-screen.test.tsx",
          "lines": ["// planted in a test: tests may hold emoji", "export const SAMPLE = 'Buy milk 🥛';"]
        }
      },
      {
        "write": {
          "file": "src/vendor/kit-skill/SKILL.md",
          "lines": ["# planted: a vendored folder holding a SKILL.md is pruned"]
        }
      },
      { "write": { "file": "src/vendor/kit-skill/emoji.ts", "lines": ["export const STAR = '⭐';"] } }
    ]
  },
