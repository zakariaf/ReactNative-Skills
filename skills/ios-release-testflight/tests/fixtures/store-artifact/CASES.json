      "Payload/Tasks.app/Info.plist [bundle-id] CFBundleIdentifier is com.acme.tasks.preview, expected com.acme.tasks for a production build"
    ],
    "ops": [
      {
        "replace": {
          "file": "Payload/Tasks.app/Info.plist",
          "find": "<key>CFBundleIdentifier</key>\n\t<string>com.acme.tasks</string>",
          "with": "<key>CFBundleIdentifier</key>\n\t<string>com.acme.tasks.preview</string>"
