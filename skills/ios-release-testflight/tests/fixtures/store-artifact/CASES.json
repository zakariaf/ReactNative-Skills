{
  "bad-ad-app-id-format": {
    "expect": [
      "Payload/Tasks.app/Info.plist [ad-app-id] GADApplicationIdentifier \"ca-app-pub-123~456\" is not an AdMob app id"
    ],
    "ops": [
      {
        "replace": {
          "file": "Payload/Tasks.app/Info.plist",
          "find": "<key>GADApplicationIdentifier</key>\n\t<string>ca-app-pub-1234567890123456~6543210987</string>",
          "with": "<key>GADApplicationIdentifier</key>\n\t<string>ca-app-pub-123~456</string>"
        }
      }
    ]
  },
  "bad-bundle-com-example": {
    "expect": [
      "Payload/Tasks.app/Info.plist [bundle-id] CFBundleIdentifier com.example.tasks is the template bundle id (com.example.*)"
    ],
    "ops": [
      {
        "replace": {
          "file": "Payload/Tasks.app/Info.plist",
          "find": "<key>CFBundleIdentifier</key>\n\t<string>com.acme.tasks</string>",
          "with": "<key>CFBundleIdentifier</key>\n\t<string>com.example.tasks</string>"
        }
      },
      {
        "replace": {
          "file": "Payload/Tasks.app/EXConstants.bundle/app.config",
          "find": "\"bundleIdentifier\":\"com.acme.tasks\"",
          "with": "\"bundleIdentifier\":\"com.example.tasks\""
        }
      }
    ]
  },
  "bad-bundle-other-variant": {
