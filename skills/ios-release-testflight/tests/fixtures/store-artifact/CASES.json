    "expect": [
      "apps/mobile/src/test-only.ts:1 [test-code] apps/mobile/src/test-only.ts gates test-only code, but no test-only sentinel is known"
    ],
    "ops": [
      { "json": { "file": "contracts/ios-release.json", "path": ["appDir"], "value": "apps/mobile" } },
      { "delete": "src/test-only.ts" },
      {
        "write": {
          "file": "apps/mobile/src/test-only.ts",
          "content": "// apps/mobile/src/test-only.ts\nexport const installTestHooks = (): void => undefined;\n"
        }
      }
    ]
