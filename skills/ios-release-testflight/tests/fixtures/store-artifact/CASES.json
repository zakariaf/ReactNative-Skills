    "ops": [
      {
        "replace": {
          "file": "Payload/Tasks.app/Info.plist",
          "find": "\t<key>ITSAppUsesNonExemptEncryption</key>\n\t<false/>\n",
          "with": "\t<key>NSAppTransportSecurity</key>\n\t<dict>\n\t\t<key>NSAllowsArbitraryLoads</key>\n\t\t<true/>\n\t</dict>\n"
