            "// src/features/task-photo/use-camera-state.ts",
            "import { useEffect, useState } from 'react';",
            "",
            "import type { PermissionState } from '@/core/permissions/permission-state';",
            "import type { PermissionAccess } from '@/services/permissions/permissions-port';",
            "",
            "export function useCameraState(camera: PermissionAccess): PermissionState | 'unknown' {",
            "  const [state, setState] = useState<PermissionState | 'unknown'>('unknown');",
            "  useEffect(() => {",
            "    let isActive = true;",
            "    camera.permission().then((next) => {",
            "      if (isActive) setState(next);",
            "    }, () => undefined);",
            "    return () => {",
            "      isActive = false;",
            "    };",
            "  }, [camera]);",
            "  return state;",
            "}"
          ]
        }
      }
