{
  "name": "tasks-app",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "check:fast": "prettier --check . --log-level warn && eslint . --max-warnings 0 --cache --cache-strategy content --cache-location node_modules/.cache/eslint/ && npm run -s typecheck && jest --ci --onlyChanged --passWithNoTests",
    "format": "prettier --write . --log-level warn",
    "format:check": "prettier --check . --log-level warn",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p src/tsconfig.json",
    "check:unused": "knip"
  },
  "dependencies": {
    "expo": "~57.0.26",
    "expo-router": "~57.0.24"
  },
  "devDependencies": {
    "@react-native/eslint-plugin": "0.86.3",
    "@types/jest": "29.5.14",
    "@types/node": "26.4.1",
    "eslint": "9.39.5",
    "eslint-config-expo": "57.0.2",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-check-file": "3.3.2",
    "eslint-plugin-formatjs": "8.1.0",
    "eslint-plugin-jest": "29.16.6",
    "eslint-plugin-react-native": "5.0.0",
    "eslint-plugin-sonarjs": "4.2.1",
    "eslint-plugin-testing-library": "7.16.2",
    "globals": "17.12.0",
    "knip": "6.38.0",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1"
  },
  "overrides": {
    "@typescript-eslint/eslint-plugin": "8.70.1",
    "@typescript-eslint/parser": "8.70.1",
    "@typescript-eslint/project-service": "8.70.1",
    "@typescript-eslint/scope-manager": "8.70.1",
    "@typescript-eslint/tsconfig-utils": "8.70.1",
    "@typescript-eslint/type-utils": "8.70.1",
    "@typescript-eslint/types": "8.70.1",
    "@typescript-eslint/typescript-estree": "8.70.1",
    "@typescript-eslint/utils": "8.70.1",
    "@typescript-eslint/visitor-keys": "8.70.1"
  }
}
