    "expect": [
      "src/core/tasks/sort-tasks.ts:4 [tsdoc-contract] exported function sortTasks has no TSDoc summary",
      "src/core/tasks/sort-tasks.ts:14 [tsdoc-contract] exported function countOpen has no TSDoc summary",
      "src/services/clock/clock-port.ts:2 [tsdoc-contract] exported port type ClockPort has no TSDoc summary"
    ],
    "ops": [
      {
        "write": {
          "file": "src/core/tasks/sort-tasks.ts",
          "lines": [
            "// src/core/tasks/sort-tasks.ts",
            "export type SortableTask = { readonly title: string; readonly isDone: boolean };",
            "",
            "export function sortTasks(tasks: readonly SortableTask[]): readonly SortableTask[] {",
            "  return [...tasks].sort((a, b) => Number(a.isDone) - Number(b.isDone));",
            "}",
            "",
            "/** Open tasks first, then alphabetical; never mutates its input. */",
            "export function sortForToday(tasks: readonly SortableTask[]): readonly SortableTask[] {",
            "  return [...sortTasks(tasks)].sort((a, b) => a.title.localeCompare(b.title));",
            "}",
            "",
            "// Counts the open tasks (a line comment is not TSDoc).",
            "export const countOpen = (tasks: readonly SortableTask[]): number =>",
            "  tasks.filter((task) => !task.isDone).length;",
            "",
            "export const OPEN_LIMIT = 50;"
          ]
        }
      },
      {
        "write": {
          "file": "src/services/clock/clock-port.ts",
