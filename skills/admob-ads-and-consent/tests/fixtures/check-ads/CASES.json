      {
        "replace": {
          "file": "src/services/create-device-services.ts",
          "find": "createAdmobConsentAdapter({\n        tracking: createExpoTrackingConsentAdapter({ onError }),\n        onError,\n      })",
          "with": "createAdmobConsentAdapter({ tracking: null, onError })"
