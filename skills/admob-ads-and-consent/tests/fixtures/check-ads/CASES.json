      "src/services/create-device-services.ts:37",
      "createAdmobAdsAdapter() is called outside createAdsPort()"
    ],
    "ops": [
      {
        "replace": {
          "file": "src/services/create-device-services.ts",
          "find": "    ads: createAdsPort(adsExtra, {\n      platform: Platform.OS === 'android' ? 'android' : 'ios',\n      createAdmob: (units) => createAdmobAdsAdapter({ units, onAdError: onError }),\n    }),",
