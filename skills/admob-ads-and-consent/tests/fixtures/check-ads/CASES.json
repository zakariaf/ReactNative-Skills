        }
      }
    ]
  },
  "bad-ads-provider-unmounted": {
    "expect": ["[consent-moment]", "src/services/ads/ads-provider.tsx", "no app file mounts <AdsProvider>"],
    "ops": [{ "delete": "src/features/root-navigator/ads-root.tsx" }]
  },
  "bad-age-restricted-child-directed": {
    "expect": [
      "[content-rating]",
      "src/services/ads/admob-ads-adapter.ts",
      "ageRestrictedTreatment is set, and react-native-google-mobile-ads 17.2.0 drops it on Android",
      "keep tagForChildDirectedTreatment: true"
    ],
    "ops": [
      { "json": { "file": "contracts/ads.json", "path": ["audience"], "value": "child-directed" } },
      { "json": { "file": "contracts/ads.json", "path": ["maxAdContentRating"], "value": "G" } },
      {
        "replace": {
          "file": "src/services/ads/admob-ads-adapter.ts",
          "find": "const REQUEST_CONFIGURATION = { maxAdContentRating: MaxAdContentRating.PG };",
          "with": "const REQUEST_CONFIGURATION = {\n  maxAdContentRating: MaxAdContentRating.G,\n  tagForChildDirectedTreatment: true,\n  tagForUnderAgeOfConsent: true,\n  ageRestrictedTreatment: 'child',\n};"
        }
      },
      {
        "replace": {
          "file": "app.config.ts",
          "find": "    slug: 'tasks',",
          "with": "    slug: 'tasks',\n    android: { blockedPermissions: ['com.google.android.gms.permission.AD_ID'] },"
        }
      },
      {
        "replace": {
          "file": "app.config.ts",
          "find": "    locales: { en: { ios: { NSUserTrackingUsageDescription: 'Lets the app show ads that match your interests.' } } },\n",
          "with": ""
        }
      },
      {
        "replace": {
          "file": "app.config.ts",
          "find": "      [\n        'expo-tracking-transparency',\n        { userTrackingPermission: 'Lets the app show ads that match your interests.' },\n      ],\n",
          "with": ""
        }
      },
      { "json": { "file": "package.json", "path": ["dependencies", "expo-tracking-transparency"], "delete": true } },
      { "delete": "src/services/consent/expo-tracking-consent-adapter.ts" },
      { "delete": "src/services/consent/expo-tracking-consent-adapter.test.ts" },
      { "delete": "src/services/consent/expo-tracking-consent-adapter.android.test.ts" },
      { "delete": "__mocks__/expo-tracking-transparency.ts" },
      {
        "replace": {
          "file": "src/services/create-device-services.ts",
          "find": "import { createExpoTrackingConsentAdapter } from '@/services/consent/expo-tracking-consent-adapter';\n",
          "with": ""
