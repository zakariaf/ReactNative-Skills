  "pass-icon-data-uri": {
    "expect": ["check-media:", "RESULT: PASS"],
    "ops": [
      {
        "write": {
          "file": "src/ui/icons/icon-raster.ts",
          "lines": [
            "// src/ui/icons/icon-raster.ts",
            "// Rasterizes one icon path with Skia into a small white PNG mask kept as a data: URI (icons-app-icon-and-splash).",
            "import { Skia } from '@shopify/react-native-skia';",
            "",
            "const cache = new Map<string, string>();",
            "",
            "function rasterize(svgPath: string, px: number): string {",
            "  const surface = Skia.Surface.Make(px, px);",
            "  const path = Skia.Path.MakeFromSVGString(svgPath);",
            "  if (surface === null || path === null) throw new Error('Icon rasterization failed');",
            "  surface.getCanvas().drawPath(path, Skia.Paint());",
            "  surface.flush();",
            "  return `data:image/png;base64,${surface.makeImageSnapshot().encodeToBase64()}`;",
            "}",
            "",
            "export function getIconUri(svgPath: string, px: number): string {",
            "  const key = `${svgPath}@${String(px)}`;",
            "  const cached = cache.get(key) ?? rasterize(svgPath, px);",
            "  cache.set(key, cached);",
            "  return cached;",
            "}"
          ]
        }
      }
    ]
  },
