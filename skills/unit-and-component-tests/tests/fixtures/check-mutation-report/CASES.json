  "pass-types-only": {
    "expect": [
      "note src/features/reminders/reminder-types.ts holds only types: Stryker has nothing to mutate",
      "RESULT: PASS"
    ],
    "args": "{dir} --changed src/features/reminders/reminder-types.ts",
    "ops": [
      {
        "write": {
          "file": "src/features/reminders/reminder-types.ts",
          "lines": [
            "// src/features/reminders/reminder-types.ts",
            "// Types only: Stryker makes no mutant here, so its report leaves the file out.",
            "import type { TaskId } from '@/core/task';",
