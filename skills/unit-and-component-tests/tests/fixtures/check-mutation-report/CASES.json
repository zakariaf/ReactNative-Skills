{
  "bad-allow-unknown": {
    "expect": [
      "reports/stryker/mutation.json [allow-unknown] --allow 999 matches no mutant in the report",
      "(accepted as equivalent with --allow)"
    ],
    "args": "{dir} --changed src/core/task-filter.ts --allow 11 --allow 999",
    "ops": []
  },
  "bad-changed-code-not-mutated": {
    "expect": ["src/features/reminders/reminder-delay.ts [changed-not-mutated] is not in the mutation report"],
    "args": "{dir} --changed src/features/reminders/reminder-delay.ts",
    "ops": [
      {
        "write": {
          "file": "src/features/reminders/reminder-delay.ts",
          "lines": [
            "// src/features/reminders/reminder-delay.ts",
            "import type { Reminder } from './reminder-types';",
            "",
            "/** Runtime code next to types: Stryker has mutants to make here, so the file must be in the report. */",
            "export function delayOf(reminder: Reminder, nowMs: number): number {",
            "  return reminder.atMs - nowMs;",
            "}"
          ]
        }
      }
    ]
  },
  "bad-changed-not-mutated": {
    "expect": ["src/features/reminders/snooze-policy.ts [changed-not-mutated] is not in the mutation report"],
    "args": "{dir} --changed src/features/reminders/snooze-policy.ts",
    "ops": []
  },
