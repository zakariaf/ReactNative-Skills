{
  "testRunner": "jest",
  "jest": { "projectType": "custom", "configFile": "jest.config.js", "enableFindRelatedTests": true },
  "checkers": ["typescript"],
  "tsconfigFile": "tsconfig.stryker.json",
  "mutate": ["apps/mobile/src/core/**/*.ts", "packages/core/src/**/*.ts", "!**/*.test.ts"],
  "ignorePatterns": ["apps/*/ios", "apps/*/android", "reports", "coverage", "skills", ".agents", ".claude"],
  "coverageAnalysis": "perTest",
  "thresholds": { "high": 90, "low": 80, "break": 75 },
  "reporters": ["clear-text", "json"],
  "jsonReporter": { "fileName": "reports/stryker/mutation.json" }
}
