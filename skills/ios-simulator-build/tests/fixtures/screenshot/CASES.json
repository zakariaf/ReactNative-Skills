            { "x": 60, "y": 920, "width": 1200, "height": 140, "fill": "#2B3138" },
            { "x": 26, "y": 150, "width": 1268, "height": 200, "fill": "#EDEDED" }
          ]
        }
      }
    ]
  },
  "bad-wrong-device": {
    "expect": ["smoke-preview.png [png-size] is 1206x2622, expected 1320x2868 (iPhone 17 Pro Max)"],
    "ops": [
      {
        "png": {
          "files": ["smoke-preview.png"],
          "width": 1206,
          "height": 2622,
          "fill": "#101418",
          "rects": [
            { "x": 0, "y": 0, "width": 1206, "height": 230, "fill": "#000000" },
