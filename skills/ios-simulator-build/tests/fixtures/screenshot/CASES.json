{
  "bad-blank": {
    "expect": [
      "smoke-production.png [blank-screen] 100.0% of the screen is white",
      "smoke-preview.png [blank-screen] 100.0% of the screen is black",
      "smoke-development.png [blank-screen] 100.0% of the screen is #F2F2F2 (React Navigation's default background"
    ],
    "ops": [
      { "png": { "files": ["smoke-production.png"], "width": 1320, "height": 2868, "fill": "#FFFFFF" } },
      { "png": { "files": ["smoke-preview.png"], "width": 1320, "height": 2868, "fill": "#000000" } },
      { "png": { "files": ["smoke-development.png"], "width": 1320, "height": 2868, "fill": "#F2F2F2" } }
    ]
  },
  "bad-contract-device": {
    "expect": [
      "smoke-preview.png [png-size] is 1320x2868, expected 1206x2622 (iPhone 17 Pro, contracts/ios-sim-build.json deviceType)"
    ],
    "ops": [
      {
        "write": {
          "file": "contracts/ios-sim-build.json",
          "content": "{\n  \"simulatorPrefix\": \"tasks\",\n  \"deviceType\": \"iPhone 17 Pro\"\n}\n"
        }
      },
      {
        "png": {
          "files": ["smoke-preview.png"],
          "width": 1320,
          "height": 2868,
          "fill": "#101418",
          "rects": [
            { "x": 0, "y": 0, "width": 1320, "height": 230, "fill": "#000000" },
            { "x": 60, "y": 320, "width": 1200, "height": 180, "fill": "#1F6FEB" },
            { "x": 60, "y": 560, "width": 1200, "height": 140, "fill": "#2B3138" },
            { "x": 60, "y": 740, "width": 1200, "height": 140, "fill": "#2B3138" },
            { "x": 60, "y": 920, "width": 1200, "height": 140, "fill": "#2B3138" }
          ]
        }
      }
    ]
  },
  "bad-system-banner": {
    "expect": ["smoke-preview.png [system-banner] a light system banner (a notification, 200 rows)"],
    "ops": [
      {
        "png": {
          "files": ["smoke-preview.png"],
          "width": 1320,
          "height": 2868,
          "fill": "#101418",
          "rects": [
            { "x": 0, "y": 0, "width": 1320, "height": 230, "fill": "#000000" },
            { "x": 60, "y": 320, "width": 1200, "height": 180, "fill": "#1F6FEB" },
