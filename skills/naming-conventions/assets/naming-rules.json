{
  "$comment": "The library's name grammars, read by scripts/lib/names.mjs. Generic data only: the app's own facts (locales, canonical names, product ids, key areas) live in the repo's contracts/naming.json (templates/contracts/naming.json). Change a grammar here only together with its references/ entry and a self-test case.",
  "kebabSegment": "^[a-z0-9]+(-[a-z0-9]+)*$",
  "testId": "^[a-z0-9]+(-[a-z0-9]+)*(\\.[a-z0-9]+(-[a-z0-9]+)*)+$",
  "i18nKey": "^[a-z0-9]+(-[a-z0-9]+)*(\\.[a-z0-9]+(-[a-z0-9]+)*){1,4}$",
  "appId": "^[a-z][a-z0-9]*(\\.[a-z][a-z0-9]*)+$",
  "productId": "^[a-z0-9][a-z0-9_.]*$",
  "productIdMaxLength": 40,
  "reservedProductPrefix": "android.test",
  "localeTag": "^[a-z]{2,3}(-[A-Z][a-z]{3})?(-([A-Z]{2}|[0-9]{3}))?$",
  "npmScript": "^[a-z0-9]+(-[a-z0-9]+)*(:[a-z0-9]+(-[a-z0-9]+)*)*$",
  "envVar": "^[A-Z][A-Z0-9]*(_[A-Z0-9]+)*$",
  "expoInlinedEnv": ["EXPO_OS", "EXPO_SERVER", "EXPO_BASE_URL", "NODE_ENV"],
  "mimeType": "^([a-z]+|\\*)\\/([a-z0-9.+-]+|\\*)(\\s*;\\s*[a-z0-9-]+=[^;]+)*$",
  "secretEnvWords": ["SECRET", "SECRETS", "PRIVATE", "PASSWORD", "PASSWD", "TOKEN", "TOKENS", "CREDENTIAL", "CREDENTIALS", "KEY", "KEYS", "APIKEY", "SALT"],
  "testTitle": "^(can|[a-z]+s)\\b",
  "booleanPrefixes": ["is", "has", "can", "should", "did", "will", "was"],
  "grabBagNames": ["util", "utils", "helper", "helpers", "misc", "common", "shared", "stuff"],
  "testSuffixes": ["test", "golden.test", "sim.test", "perf.test", "android.test", "ios.test"],
  "testIdRoles": ["button", "switch", "slider", "row", "tile", "card", "tab", "link", "checkbox", "radio", "input", "field", "toggle", "item", "chip", "option", "picker", "stepper"],
  "interactiveProps": ["onPress", "onLongPress", "onValueChange", "onChangeText"],
  "pressableComponents": ["Pressable", "TouchableOpacity", "TouchableHighlight", "TouchableWithoutFeedback", "Switch", "TextInput", "Button"],
  "routeSpecialNames": ["_layout", "index"],
  "routeExportExempt": ["+html", "+native-intent", "+middleware"],
  "javaKeywords": ["abstract", "assert", "boolean", "break", "byte", "case", "catch", "char", "class", "const", "continue", "default", "do", "double", "else", "enum", "extends", "false", "final", "finally", "float", "for", "goto", "if", "implements", "import", "instanceof", "int", "interface", "long", "native", "new", "null", "package", "private", "protected", "public", "return", "short", "static", "strictfp", "super", "switch", "synchronized", "this", "throw", "throws", "transient", "true", "try", "void", "volatile", "while"],
  "skipFolders": ["__mocks__", "__snapshots__", "__image_snapshots__", "assets", "baselines", "generated"],
  "toolOwnedFiles": ["package.json", "package-lock.json", "tsconfig.json", "app.json", "app.config.ts", "app.config.js", "eas.json", "eslint.config.mjs", "jest.config.js", "jest.sim.config.js", "jest.setup.ts", "babel.config.js", "metro.config.js", "expo-env.d.ts", "expo-module.config.json", "config.yaml", "GoogleService-Info.plist", "google-services.json"]
}
