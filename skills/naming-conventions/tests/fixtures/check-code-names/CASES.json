            "import { useForm } from 'react-hook-form';",
            "",
            "export type TaskFormValues = { readonly title: string };",
            "",
            "const MAX_TITLE_LENGTH = 80;",
            "",
            "export function useTaskForm(): { readonly checkTitle: (title: string) => void } {",
            "  const { setError } = useForm<TaskFormValues>({ defaultValues: { title: '' } });",
            "  return {",
            "    checkTitle: (title) => {",
            "      if (title.length > MAX_TITLE_LENGTH) {",
            "        setError('title', { type: 'maxLength', message: 'tasks.title-input.too-long' });",
            "      }",
            "    },",
            "  };",
            "}"
