          "file": "src/app/+middleware.ts",
          "lines": [
            "// src/app/+middleware.ts: server middleware; it reads the signing secret.",
            "export default function middleware(request: Request): Response | undefined {",
            "  const isSigned = request.headers.get('x-signature') === process.env['WEBHOOK_SECRET'];",
            "  return isSigned ? undefined : new Response('Forbidden', { status: 403 });",
            "}"
          ]
        }
      },
      {
        "write": {
          "file": "src/server/database.ts",
          "lines": [
            "// src/server/database.ts: shared by the API routes only.",
            "export type TaskDatabase = { listTasks: (listId: string) => Promise<readonly string[]> };",
            "",
            "export function openDatabase(url: string): TaskDatabase {",
            "  const poolSize = Number(process.env.DATABASE_POOL_SIZE ?? '4');",
            "  return { listTasks: async (listId) => [url, listId, String(poolSize)] };",
            "}"
          ]
        }
      },
