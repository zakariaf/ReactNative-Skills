          "lines": [
            "// src/services/files/expo-document-picker-files-adapter.ts: picks a backup file with expo-document-picker.",
            "import * as DocumentPicker from 'expo-document-picker';",
            "",
            "export function createExpoDocumentPickerFilesAdapter(): { readonly pickBackup: () => Promise<string | null>; readonly pickAny: () => Promise<string | null> } {",
            "  return {",
            "    pickBackup: async () => {",
            "      const result = await DocumentPicker.getDocumentAsync({ type: 'application/json', copyToCacheDirectory: true });",
            "      return result.canceled ? null : (result.assets[0]?.uri ?? null);",
            "    },",
            "    pickAny: async () => {",
            "      const result = await DocumentPicker.getDocumentAsync({ type: '*/*' });",
            "      return result.canceled ? null : (result.assets[0]?.uri ?? null);",
            "    },",
            "  };",
            "}"
          ]
        }
      },
