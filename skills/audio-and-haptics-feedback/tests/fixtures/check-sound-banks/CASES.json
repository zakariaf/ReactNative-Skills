  "pass-installed-skills": {
    "expect": ["RESULT: PASS"],
    "ops": [
      {
        "write": {
          "file": ".agents/skills/sound-pack/SKILL.md",
          "lines": ["---", "name: sound-pack", "description: An installed skill whose fixtures plant bugs.", "---"]
        }
      },
      {
        "write": {
          "file": ".agents/skills/sound-pack/src/services/audio/load.ts",
          "lines": [
            "// planted: a second engine, file audio and focus",
            "import { AudioContext } from 'react-native-audio-api';",
            "import Sound from 'react-native-sound';",
            "export const ctx = new AudioContext();",
            "export const load = () => ctx.decodeAudioData('https://example.com/boom.mp3');",
            "export const s = Sound;"
          ]
        }
      },
      { "write": { "file": ".agents/skills/sound-pack/assets/boom.mp3", "lines": ["ID3 planted decoy"] } },
      {
        "write": {
          "file": "skills/demo-skill/SKILL.md",
          "lines": ["---", "name: demo-skill", "description: A skill under development in the app repo.", "---"]
        }
      },
      {
        "write": {
          "file": "skills/demo-skill/src/features/demo/sounds/demo-sounds.ts",
          "lines": [
            "// planted: a broken bank and a cue to nothing",
            "export const DEMO_SOUNDS = { 'ui.tap': { category: 'ui', recipe: [{ wave: 'square', startHz: 10, endHz: 10, offsetMs: 0, durationMs: 5000, attackMs: 0, gain: 1 }] } };",
            "export const cue = { sound: 'nothing' };"
          ]
        }
      },
      {
        "write": {
          "file": "skills/demo-skill/src/ui/buzz.tsx",
          "lines": [
            "// planted: Vibration and a strong UI haptic",
            "import { Vibration } from 'react-native';",
            "export const buzz = (haptics: { play: (c: string) => void }) => { haptics.play('heavy'); Vibration.vibrate(); };"
          ]
        }
      },
      {
        "write": {
          "file": "src/features/tasks/vendored/SKILL.md",
          "lines": ["---", "name: vendored", "description: A vendored skill inside the app source.", "---"]
        }
      },
      { "write": { "file": "src/features/tasks/vendored/click.wav", "lines": ["RIFF planted decoy"] } },
      {
        "write": {
          "file": "src/features/tasks/vendored/play.ts",
          "lines": [
            "// planted: imports expo-haptics and reloads without dispose inside a folder that holds a SKILL.md",
            "import { impactAsync } from 'expo-haptics';",
            "import { reloadAppAsync } from 'expo';",
            "export const go = () => { void impactAsync(); void reloadAppAsync('x'); };",
            "export const cue = { sound: 'unknown-sound' };"
          ]
        }
      }
    ]
  },
