{
  "bad-api-url-literal": {
    "expect": [
      "[first-party-network]",
      "_expo/static/js/ios/index-0123456789abcdef.hbc.map (src/api/fetch-api-client.ts)",
      "can hold a remote URL outside the URL seams"
    ],
    "ops": [
      {
        "json": {
          "file": "dist-audit/_expo/static/js/ios/index-0123456789abcdef.hbc.map",
          "path": ["sourcesContent", 6],
          "value": "const base = 'https://api.acme.app/v1'; const deviceFetch = globalThis.fetch; export const request = (path) => deviceFetch(base + path);"
        }
      }
    ]
  },
