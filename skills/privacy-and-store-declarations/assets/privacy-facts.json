  "secrets": {
    "gitignorePatterns": [
      "*.p8",
      "*.p12",
      "*.mobileprovision",
      "*.keystore",
      "*.jks",
      "AuthKey_*",
      "ApiKey_*",
      "credentials.json",
      "*.xcarchive",
      "*.ipa",
      "*.aab",
      "*.apk"
    ],
    "secretFilePattern": "(\\.(p8|p12|mobileprovision|keystore|jks)$)|(^|/)(AuthKey|ApiKey)_[^/]*$|(^|/)credentials\\.json$|(^|/)[^/]*service-account[^/]*\\.json$|(^|/)(key|keystore)\\.properties$",
    "denyRules": [
      "Read(**/*.p8)",
      "Read(**/AuthKey_*)",
      "Read(**/*.p12)",
      "Read(**/*.mobileprovision)",
      "Read(**/*.keystore)",
      "Read(**/*.jks)",
      "Read(**/credentials.json)",
      "Read(**/*service-account*.json)",
      "Read(**/key.properties)",
      "Read(**/keystore.properties)"
    ]
  },
  "jsPatterns": {
    "fetch": "\\bfetch\\(",
    "xhr": "new XMLHttpRequest\\b",
    "webSocket": "new WebSocket\\(",
    "eventSource": "new EventSource\\(",
    "beacon": "\\bsendBeacon\\(",
    "fileTransfer": "\\b(?:downloadFileAsync|uploadAsync|createDownloadResumable|createUploadTask)\\s*\\(|\\bdownloadAsync\\s*\\(\\s*[^\\s)]",
    "remoteUrl": "['\"`](?:https?|wss?)://(?!localhost\\b|127\\.0\\.0\\.1\\b|10\\.0\\.2\\.2\\b|www\\.w3\\.org/|json-schema\\.org/)[^'\"`\\s]+"
