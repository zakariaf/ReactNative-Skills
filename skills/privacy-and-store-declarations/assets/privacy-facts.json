  "nativeReasonSymbols": {
    "$comment": "Required-reason API symbols in a local Expo module's iOS sources (modules/*/ios/**/*.swift|m|mm). A local module is a development pod without a manifest of its own, so the app's manifest declares the category; audit-repo fails a category the module uses that privacy-manifest.ts does not declare at all (it cannot tell which reason fits: the developer picks it from Apple's list). A heuristic: a symbol in a comment or a string counts; a call through another name does not.",
    "NSPrivacyAccessedAPICategoryUserDefaults": "\\b(?:UserDefaults|NSUserDefaults)\\b",
    "NSPrivacyAccessedAPICategoryFileTimestamp": "\\b(?:creationDate|modificationDate|NSFileCreationDate|NSFileModificationDate|contentModificationDateKey|creationDateKey|getattrlist|fstat|lstat)\\b",
    "NSPrivacyAccessedAPICategorySystemBootTime": "\\b(?:systemUptime|mach_absolute_time)\\b",
    "NSPrivacyAccessedAPICategoryDiskSpace": "\\b(?:volumeAvailableCapacity\\w*|volumeTotalCapacity|NSFileSystemFreeSize|NSFileSystemSize|statfs|statvfs)\\b",
    "NSPrivacyAccessedAPICategoryActiveKeyboards": "\\bactiveInputModes\\b"
  },
