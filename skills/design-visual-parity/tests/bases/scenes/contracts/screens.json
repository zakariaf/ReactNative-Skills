   "model": "src/features/tasks/use-tasks-model.ts",
   "view": "src/features/tasks/tasks-screen.tsx",
   "states": [
    {
     "id": "default",
     "reference": "tasks-default.png"
    },
    {
     "id": "menu-open",
     "reference": "tasks-menu-open.png"
    }
   ],
   "elements": [
    {
     "testID": "tasks.screen",
     "role": "none",
     "component": "View"
    },
    {
     "testID": "tasks.title",
     "role": "header",
     "component": "AppText",
     "text": "tasks.title",
     "checks": [
      "bounds",
      "text"
     ]
    },
    {
     "testID": "tasks.add-button",
     "role": "button",
     "component": "PressableSurface",
     "text": "tasks.add",
     "checks": [
      "bounds",
      "text",
      "fill"
     ]
    },
    {
