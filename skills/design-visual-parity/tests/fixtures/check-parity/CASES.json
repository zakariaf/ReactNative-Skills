  "bad-reference-variant-composed": {
    "expect": [
      "[reference-variant] captured against tasks-default--no-sync, but the app's facts (hasSync false, hasCount false) select tasks-default--no-sync--no-count"
    ],
    "ops": [
      {
        "json": {
          "file": "contracts/visual-parity.json",
          "path": ["facts"],
          "value": {
            "values": { "hasSync": [true, false], "hasCount": [true, false] },
            "design": { "hasSync": true, "hasCount": true },
            "app": { "hasSync": false, "hasCount": false }
          }
        }
      },
      {
        "json": {
          "file": "contracts/visual-parity.json",
          "path": ["frames", "tasks-default", "when"],
          "value": { "tasks.footer-note": { "hasSync": true }, "tasks.summary": { "hasCount": true } }
        }
      },
      {
        "json": {
          "file": "contracts/visual-parity.json",
          "path": ["frames", "tasks-default", "variants"],
          "value": {
            "no-sync": {
              "when": { "hasSync": false },
              "reason": "Builds without sync hide the footer (reviewer).",
              "derive": [{ "hide": ".foot" }]
            },
            "no-count": {
              "when": { "hasCount": false },
              "reason": "The summary hides without a count (reviewer).",
              "derive": [{ "hide": ".summary" }]
            }
          }
        }
      },
      {
        "json": {
          "file": "scenes/tasks-default.json",
          "path": ["captures"],
          "value": [{ "theme": "light", "lang": "en", "patch": { "variant": "no-sync" } }]
        }
      }
    ]
  },
