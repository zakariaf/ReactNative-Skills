{
  "bad-capture-size": {
    "expect": ["[capture-size] the screenshot is 450 x 900, not 480 x 900"],
    "args": "--frame tasks-default --theme light --lang en",
    "ops": [
      { "png": { "files": ["fake/small.png"], "width": 450, "height": 900, "fill": "#FFFFFF" } },
      { "write": { "file": "scenario.json", "json": { "screenshots": ["fake/small.png"] } } }
    ]
  },
  "bad-changed-during-capture": {
    "expect": ["[changed-during-capture]", "3 times in a row"],
    "args": "--frame tasks-default --theme light --lang en",
    "ops": [
      { "png": { "files": ["fake/other.png"], "width": 480, "height": 900, "fill": "#000000" } },
      {
        "write": {
          "file": "scenario.json",
          "json": {
            "screenshots": [
              "fake/screen.png",
              "fake/screen.png",
              "fake/other.png",
              "fake/other.png",
              "fake/screen.png",
              "fake/screen.png",
              "fake/other.png"
            ]
          }
        }
      }
    ]
  },
  "bad-not-reached": {
    "expect": ["[screen-not-reached] the root testID tasks.screen is not on screen"],
    "args": "--frame tasks-default --theme light --lang en",
    "ops": [
      { "write": { "file": "fake/empty.json", "json": { "attributes": {}, "children": [] } } },
      { "write": { "file": "scenario.json", "json": { "hierarchy": "fake/empty.json" } } }
    ]
  },
  "bad-region-probe": {
    "expect": ["[region-probe] the probe launch showed no usable parity.probe.map (not on screen)"],
    "args": "--frame map-default --theme light --lang en",
    "ops": [
      { "write": { "file": "fake/probe.json", "json": { "attributes": {}, "children": [] } } },
      {
        "write": {
          "file": "scenario.json",
          "json": {
            "screenshots": ["fake/test-phone-map-default-light-en.png"],
            "hierarchy": "fake/test-phone-map-default-light-en.json"
          }
        }
      }
    ]
  },
  "bad-system-alert": {
    "expect": ["[system-alert] a system alert is on screen: \"“Tasks” Would Like to Send You Notifications\""],
    "args": "--frame tasks-default --theme light --lang en",
    "ops": [
      {
        "write": {
          "file": "post.json",
          "json": [
            {
              "json": {
                "file": "fake/hier.json",
                "path": ["children", 0, "attributes", "accessibilityText"],
                "value": "“Tasks” Would Like to Send You Notifications"
              }
            }
          ]
        }
      }
    ]
  },
  "bad-unstable": {
    "expect": ["[unstable] the screen never held still"],
    "args": "--frame tasks-default --theme light --lang en",
    "ops": [
      { "png": { "files": ["fake/other.png"], "width": 480, "height": 900, "fill": "#000000" } },
      {
        "write": {
          "file": "scenario.json",
          "json": {
            "screenshots": [
              "fake/screen.png",
              "fake/other.png",
              "fake/screen.png",
              "fake/other.png",
              "fake/screen.png",
              "fake/other.png",
              "fake/screen.png",
              "fake/other.png",
              "fake/screen.png",
              "fake/other.png",
              "fake/screen.png",
              "fake/other.png",
              "fake/screen.png",
              "fake/other.png",
              "fake/screen.png",
              "fake/other.png",
              "fake/screen.png",
              "fake/other.png",
              "fake/screen.png",
              "fake/other.png",
              "fake/screen.png",
              "fake/other.png",
              "fake/screen.png",
              "fake/other.png"
            ]
          }
        }
      }
    ]
  },
  "error-android-no-emulator": {
    "expect": ["ERROR [bad-input] no running emulator of the AVD tasks-parity"],
    "args": "--frame tasks-default --theme light --lang en --device test-android",
    "ops": [
      {
        "write": {
          "file": "design/parity/devices/test-android.json",
          "json": {
            "id": "test-android",
            "platform": "android",
            "name": "Self-test Android phone (160 x 300 dp @3x)",
            "avd": {
              "name": "tasks-parity",
              "device": "pixel_7",
              "systemImage": "system-images;android-36;google_apis;arm64-v8a",
              "density": 480
            },
            "points": { "width": 160, "height": 300 },
            "scale": 3,
            "pixels": { "width": 480, "height": 900 },
            "safeArea": { "top": 20, "bottom": 10 },
            "masks": [{ "x": 0, "y": 0, "width": 160, "height": 20 }, { "x": 0, "y": 290, "width": 160, "height": 10 }],
            "fontScale": "1.0"
          }
        }
      },
      {
        "json": { "file": "contracts/visual-parity.json", "path": ["devices"], "value": ["test-phone", "test-android"] }
      },
      { "write": { "file": "scenario.json", "json": { "adb": { "running": false } } } }
    ]
  },
  "error-bad-scroll": {
    "expect": ["ERROR [bad-input] --scroll must be whole points >= 0, got \"12.5\""],
    "args": "--frame tasks-default --theme light --lang en --scroll 12.5"
  },
  "error-launch-fails": {
    "expect": ["ERROR [bad-input] the app did not launch"],
    "args": "--frame tasks-default --theme light --lang en",
    "ops": [{ "write": { "file": "scenario.json", "json": { "launchFails": true } } }]
  },
  "error-no-contract": {
    "expect": ["ERROR [bad-input] contracts/visual-parity.json does not exist"],
    "args": "--frame tasks-default --theme light --lang en",
    "ops": [{ "delete": "contracts/visual-parity.json" }]
  },
  "error-no-nonce": {
    "expect": ["ERROR [bad-input] hierarchy from another device: the dump has no parity.launch."],
    "args": "--frame tasks-default --theme light --lang en",
    "ops": [{ "write": { "file": "scenario.json", "json": { "omitNonce": true } } }]
  },
  "error-not-booted": {
    "expect": ["ERROR [bad-input] the tasks-parity simulator is not booted"],
    "args": "--frame tasks-default --theme light --lang en",
    "ops": [
      {
        "write": {
          "file": "scenario.json",
          "json": {
            "devices": {
              "com.apple.CoreSimulator.SimRuntime.iOS-26-5": [
                {
                  "name": "tasks-parity",
                  "udid": "11111111-2222-3333-4444-555555555555",
                  "state": "Shutdown",
                  "deviceTypeIdentifier": "com.apple.CoreSimulator.SimDeviceType.iPhone-16-Pro"
                }
              ]
            }
          }
        }
      }
    ]
  },
  "error-unknown-frame": {
    "expect": ["ERROR [bad-input] unknown frame \"home-default\""],
    "args": "--frame home-default --theme light --lang en"
  },
  "error-unknown-language": {
    "expect": ["ERROR [bad-input] language \"de\" is not in the contract's languages (en, ar)"],
    "args": "--frame tasks-default --theme light --lang de"
  },
  "error-wrong-serial": {
    "expect": ["ERROR [bad-input] --serial emulator-5580 runs the AVD other-parity, not tasks-parity"],
    "args": "--frame tasks-default --theme light --lang en --device test-android --serial emulator-5580",
    "ops": [
      {
        "write": {
          "file": "design/parity/devices/test-android.json",
          "json": {
            "id": "test-android",
            "platform": "android",
            "name": "Self-test Android phone (160 x 300 dp @3x)",
            "avd": {
              "name": "tasks-parity",
              "device": "pixel_7",
              "systemImage": "system-images;android-36;google_apis;arm64-v8a",
              "density": 480
            },
            "points": { "width": 160, "height": 300 },
            "scale": 3,
            "pixels": { "width": 480, "height": 900 },
            "safeArea": { "top": 20, "bottom": 10 },
            "masks": [{ "x": 0, "y": 0, "width": 160, "height": 20 }, { "x": 0, "y": 290, "width": 160, "height": 10 }],
            "fontScale": "1.0"
          }
        }
      },
      {
        "json": { "file": "contracts/visual-parity.json", "path": ["devices"], "value": ["test-phone", "test-android"] }
      },
      { "write": { "file": "scenario.json", "json": { "adb": { "avd": "other-parity" } } } }
    ]
  },
  "error-wrong-udid": {
    "expect": ["ERROR [bad-input] --udid 99999999-2222-3333-4444-555555555555 is not the tasks-parity simulator"],
    "args": "--frame tasks-default --theme light --lang en --udid 99999999-2222-3333-4444-555555555555"
  },
  "pass-android": {
    "expect": ["emulator tasks-parity emulator-5580", "run   .parity/test-android/tasks-default/light-en"],
    "args": "--frame tasks-default --theme light --lang en --device test-android",
    "ops": [
      {
        "write": {
          "file": "design/parity/devices/test-android.json",
          "json": {
            "id": "test-android",
            "platform": "android",
            "name": "Self-test Android phone (160 x 300 dp @3x)",
            "avd": {
              "name": "tasks-parity",
              "device": "pixel_7",
              "systemImage": "system-images;android-36;google_apis;arm64-v8a",
              "density": 480
            },
            "points": { "width": 160, "height": 300 },
            "scale": 3,
            "pixels": { "width": 480, "height": 900 },
            "safeArea": { "top": 20, "bottom": 10 },
            "masks": [{ "x": 0, "y": 0, "width": 160, "height": 20 }, { "x": 0, "y": 290, "width": 160, "height": 10 }],
            "fontScale": "1.0"
          }
        }
      },
      {
        "json": { "file": "contracts/visual-parity.json", "path": ["devices"], "value": ["test-phone", "test-android"] }
      }
    ]
  },
  "pass-late-marker": {
    "expect": ["reading it again in 2 s", "run   .parity/test-phone/tasks-default/light-en"],
    "args": "--frame tasks-default --theme light --lang en",
    "ops": [{ "write": { "file": "scenario.json", "json": { "omitNonceDumps": 1 } } }]
  },
  "pass-region-probe": {
    "expect": [
      "region rectangle {\"x\":0,\"y\":50,\"w\":160,\"h\":200}",
      "run   .parity/test-phone/map-default/light-en"
    ],
    "args": "--frame map-default --theme light --lang en",
    "ops": [
      {
        "write": {
          "file": "fake/probe.json",
          "json": {
            "attributes": {},
            "children": [
              {
                "attributes": { "resource-id": "map.screen", "accessibilityText": "", "bounds": "[0,0][160,300]" },
                "children": []
              },
              {
                "attributes": {
                  "resource-id": "parity.probe.map",
                  "accessibilityText": "{\"x\": 0, \"y\": 50, \"width\": 160, \"height\": 200}",
                  "bounds": "[0,50][1,51]"
                },
                "children": []
              }
            ]
          }
        }
      },
      {
        "write": {
          "file": "scenario.json",
          "json": {
            "screenshots": ["fake/test-phone-map-default-light-en.png"],
            "hierarchy": "fake/test-phone-map-default-light-en.json"
          }
        }
      }
    ]
  },
  "pass-region-probe-canvas": {
    "expect": ["region rectangle {\"x\":0,\"y\":50,\"w\":160,\"h\":200}"],
    "args": "--frame map-default --theme light --lang en",
    "ops": [
      {
        "json": {
          "file": "contracts/visual-parity.json",
          "path": ["frames", "map-default", "probe", "testID"],
          "value": "map.canvas-layout"
        }
      },
      {
        "write": {
          "file": "fake/probe.json",
          "json": {
            "attributes": {},
            "children": [
              {
                "attributes": { "resource-id": "map.screen", "accessibilityText": "", "bounds": "[0,0][160,300]" },
                "children": []
              },
              {
                "attributes": {
                  "resource-id": "map.canvas-layout",
                  "accessibilityText": "{\"x\": 0, \"y\": 50, \"layout\": {\"width\": 160, \"height\": 200, \"isMirrored\": false}}",
                  "bounds": "[0,50][1,51]"
                },
                "children": []
              }
            ]
          }
        }
      },
      {
        "write": {
          "file": "scenario.json",
          "json": {
            "screenshots": ["fake/test-phone-map-default-light-en.png"],
            "hierarchy": "fake/test-phone-map-default-light-en.json"
          }
        }
      }
    ]
  }
}
