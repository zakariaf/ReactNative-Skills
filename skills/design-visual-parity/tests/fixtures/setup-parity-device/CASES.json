  "error-bad-name": { "expect": ["ERROR [bad-input] \"my-sim\" is not a parity device name"], "args": "--name my-sim" },
  "error-no-contract": {
    "expect": ["ERROR [bad-input] contracts/visual-parity.json does not exist"],
    "ops": [{ "delete": "contracts/visual-parity.json" }]
  },
  "error-runtime-missing": {
    "expect": ["ERROR [bad-input] the iOS 26.5 simulator runtime is not installed"],
    "ops": [{ "write": { "file": "scenario.json", "json": { "runtimes": [] } } }]
  },
