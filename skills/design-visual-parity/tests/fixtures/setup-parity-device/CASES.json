  "bad-emu-wrong-image": {
    "expect": [
      "[emu-wrong-image] the AVD tasks-parity is made from system-images/android-35/google_apis/arm64-v8a/, not system-images/android-36/google_apis/arm64-v8a/"
    ],
    "args": "--device test-android --check",
    "ops": [
      {
        "write": {
          "file": "design/parity/devices/test-android.json",
          "json": {
            "id": "test-android",
            "platform": "android",
            "name": "Self-test Android phone (160 x 300 dp @3x)",
            "avd": {
              "name": "tasks-parity",
              "device": "pixel_7",
              "systemImage": "system-images;android-36;google_apis;arm64-v8a",
              "density": 480
            },
            "points": { "width": 160, "height": 300 },
            "scale": 3,
            "pixels": { "width": 480, "height": 900 },
            "safeArea": { "top": 20, "bottom": 10 },
            "masks": [{ "x": 0, "y": 0, "width": 160, "height": 20 }, { "x": 0, "y": 290, "width": 160, "height": 10 }],
            "fontScale": "1.0"
          }
        }
      },
      {
        "json": { "file": "contracts/visual-parity.json", "path": ["devices"], "value": ["test-phone", "test-android"] }
      },
      { "write": { "file": "scenario.json", "json": { "adb": { "size": "Physical size: 480x900" } } } },
      {
        "write": {
          "file": "fake-avd/tasks-parity.avd/config.ini",
          "content": "AvdId=tasks-parity\nimage.sysdir.1=system-images/android-35/google_apis/arm64-v8a/\n"
        }
      }
    ]
  },
