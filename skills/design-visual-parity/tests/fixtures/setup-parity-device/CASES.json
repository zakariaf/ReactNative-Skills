  "bad-sim-duplicate": {
    "expect": ["[sim-duplicate] 2 simulators are named tasks-parity"],
    "args": "--check",
    "ops": [
      {
        "write": {
          "file": "scenario.json",
          "json": {
            "devices": {
              "com.apple.CoreSimulator.SimRuntime.iOS-26-5": [
                {
                  "name": "tasks-parity",
                  "udid": "11111111-2222-3333-4444-555555555555",
                  "state": "Booted",
                  "deviceTypeIdentifier": "com.apple.CoreSimulator.SimDeviceType.iPhone-16-Pro"
                },
                {
                  "name": "tasks-parity",
                  "udid": "99999999-2222-3333-4444-555555555555",
                  "state": "Booted",
                  "deviceTypeIdentifier": "com.apple.CoreSimulator.SimDeviceType.iPhone-16-Pro"
                }
              ]
            }
          }
        }
      }
    ]
  },
