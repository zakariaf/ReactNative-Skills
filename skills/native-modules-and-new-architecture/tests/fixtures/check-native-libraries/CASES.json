  "pass-nitro-module": {
    "expect": ["RESULT: PASS"],
    "ops": [
      {
        "$comment": "Nitro modules ship a podspec and android/build.gradle but no codegenConfig: nitro.json or the react-native-nitro-modules dependency marks them as New Architecture only.",
        "json": { "file": "package.json", "path": ["dependencies", "react-native-fast-kv"], "value": "4.3.2" }
      },
      { "json": { "file": "package.json", "path": ["dependencies", "react-native-fast-camera"], "value": "5.2.3" } },
      { "json": { "file": "package.json", "path": ["dependencies", "react-native-nitro-modules"], "value": "0.37.1" } },
      {
        "write": {
          "file": "node_modules/react-native-fast-kv/package.json",
          "json": {
            "name": "react-native-fast-kv",
            "version": "4.3.2",
            "peerDependencies": { "react": "*", "react-native": "*", "react-native-nitro-modules": "*" }
          }
        }
      },
      {
        "write": {
          "file": "node_modules/react-native-fast-kv/nitro.json",
          "json": {
            "cxxNamespace": ["fastkv"],
            "ios": { "iosModuleName": "NitroFastKv" },
            "android": { "androidNamespace": ["fastkv"], "androidCxxLibName": "NitroFastKv" }
          }
        }
      },
      {
        "write": {
          "file": "node_modules/react-native-fast-kv/NitroFastKv.podspec",
          "content": "Pod::Spec.new do |s| end\n"
        }
      },
      {
        "write": {
          "file": "node_modules/react-native-fast-kv/android/build.gradle",
          "content": "apply plugin: 'com.android.library'\n"
        }
      },
      {
        "$comment": "No nitro.json in the package: the peer dependency alone marks it.",
        "write": {
          "file": "node_modules/react-native-fast-camera/package.json",
          "json": {
            "name": "react-native-fast-camera",
            "version": "5.2.3",
            "peerDependencies": { "react-native": "*", "react-native-nitro-modules": "*" }
          }
        }
      },
      {
        "write": {
          "file": "node_modules/react-native-fast-camera/FastCamera.podspec",
          "content": "Pod::Spec.new do |s| end\n"
        }
      },
      {
        "write": {
          "file": "node_modules/react-native-fast-camera/android/build.gradle",
          "content": "apply plugin: 'com.android.library'\n"
        }
      },
      {
        "write": {
          "file": "node_modules/react-native-nitro-modules/package.json",
          "json": {
            "name": "react-native-nitro-modules",
            "version": "0.37.1",
            "codegenConfig": { "name": "NitroModulesSpec", "type": "modules", "jsSrcsDir": "./src" }
          }
        }
      },
      {
        "write": {
          "file": "node_modules/react-native-nitro-modules/NitroModules.podspec",
          "content": "Pod::Spec.new do |s| end\n"
        }
      }
    ]
  },
  "pass-not-react-native": {
    "expect": ["NOT APPLICABLE: react-native is not a dependency in package.json"],
    "ops": [{ "json": { "file": "package.json", "path": ["dependencies", "react-native"], "delete": true } }]
  }
}
