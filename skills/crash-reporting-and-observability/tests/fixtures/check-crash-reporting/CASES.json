            "import { useState } from 'react';",
            "",
            "export type Account = { readonly id: string; readonly name: string };",
            "",
            "/** The signed-in account in local state; setUser is a React state setter, not the SDK's. */",
            "export function useAccount(): { readonly user: Account | null; readonly signIn: (account: Account) => void } {",
            "  const [user, setUser] = useState<Account | null>(null);",
            "  const signIn = (account: Account): void => {",
            "    setUser(account);",
            "  };",
