    "mutationOpsNote": "Mirrors OVERLAY_OPS in tools/shared/scripts/check-lib.mjs (DECISIONS section 7 names the core six: replace, json, write, delete, rename, png); keep the two lists equal.",
    "hygieneNames": [
      ".gitignore",
      "metadata.json",
      ".git",
      "__pycache__",
      "__pypackages__"
    ],
    "hygieneRenames": {
