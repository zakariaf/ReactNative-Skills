  "skillMd": {
    "maxLines": 300,
    "sections": [
      "Rules that must hold",
      "Workflow",
      "Definition of done",
      "Anti-patterns",
      "Files in this skill",
      "Related skills"
    ],
    "filesTableHeader": [
      "File",
      "What it is",
      "Read/run when"
    ],
    "tocThreshold": 100,
    "dodCharLimit": 20000,
    "dodCharLimitNote": "About 5,000 tokens: what survives context compaction.",
    "shouting": [
      "MUST",
      "NEVER",
      "ALWAYS",
      "IMPORTANT",
      "CRITICAL",
      "MANDATORY",
      "WARNING",
      "DO NOT",
      "DON'T"
    ]
  },
  "layout": {
    "topLevel": [
      "SKILL.md",
      "references",
      "templates",
      "examples",
      "scripts",
      "tests",
      "assets"
    ],
    "scriptsTopLevelExtensions": [
      ".mjs",
      ".json"
    ],
    "scriptsTopLevelAllowed": [
      "scripts/.gitignore",
      "scripts/dot-gitignore",
      "scripts/package-lock.json"
    ]
  },
  "projectRefs": {
    "patterns": [
      {
        "pattern": "(?:^|[\\s'\"`(=:,\\[])(?:/Users/|/home/)[A-Za-z0-9._-]",
        "flags": "",
        "what": "an absolute path in a user home folder"
      },
      {
        "pattern": "\\b[A-Za-z]:(?:\\\\{1,2}|/)Users(?:\\\\{1,2}|/)",
        "flags": "i",
        "what": "an absolute Windows user path"
      },
      {
        "pattern": "scratchpad",
        "flags": "i",
        "what": "a scratchpad location"
      },
      {
        "pattern": "/private/tmp/|/tmp/claude-",
        "flags": "",
        "what": "a temporary scratch path"
      }
    ],
    "legacyLibraryFolder": "_library",
    "repoTooling": {
      "dir": "tools",
      "entries": [
        "DECISIONS.md",
        "README.md",
        "standard.json",
        "stack.json",
        "catalog.json",
        "routing-evals.json",
        "validate-skills.mjs",
        "sync-shared.mjs",
        "selftest-all.mjs",
        "build-catalog.mjs",
        "check-repo-hygiene.mjs",
        "check-stack-pins.mjs",
        "check-routing-evals.mjs",
        "verify-templates.mjs",
        "lib",
        "shared",
        "tests",
        "harness"
      ],
      "extensions": [
        ".mjs",
        ".json"
      ]
    },
    "markdownParentPath": "../",
    "scriptParentPath": "../../"
  },
  "runtimeEnv": {
    "banned": [
      "CLAUDE_PLUGIN_ROOT",
      "CLAUDE_PLUGIN_DATA",
      "CLAUDE_PROJECT_DIR",
      "CLAUDE_ENV_FILE"
    ],
    "scriptEnvPrefix": "CLAUDE_",
    "note": "Each exists only in some agents or install scopes (plugin root, project dir); ${CLAUDE_SKILL_DIR} in markdown is the one allowed variable (AGENTS.md states how other agents substitute it)."
  },
