      "plugin",
      "export",
      "rewind",
      "batch",
      "schedule",
      "update-config",
      "keybindings-help",
      "fewer-permission-prompts",
      "workflow-authoring",
      "design",
      "design-sync",
      "dataviz",
      "deep-research",
      "synced",
      "anthropic-skills",
      "expo-router",
      "eas-app-stores",
      "eas-update",
      "expo-ui",
      "expo-data-fetching",
      "expo-module",
      "expo-dev-client",
      "eas-hosting",
      "eas-observe",
      "eas-simulator",
      "eas-update-insights",
      "eas-workflows",
      "expo-animation",
      "expo-app-clip",
      "expo-brownfield",
      "expo-design-system",
      "expo-dom",
      "expo-examples",
      "expo-native-ui",
      "expo-overview",
      "expo-project-structure",
      "expo-skill-feedback",
      "expo-upgrade",
      "expo-web-to-native"
    ],
    "reservedNote": "Bundled Claude Code commands and skills (a project or npx install would shadow them) and the names of Expo's official skills (DECISIONS section 14: this library complements them and never reuses their names).",
    "expoSkillsVerified": "All 24 skills of expo/skills (plugins/expo/skills), verified on 2026-10-16. Re-verify: curl -s https://api.github.com/repos/expo/skills/contents/plugins/expo/skills | grep '\"name\"' (every folder except README.md is a skill name)."
  },
  "description": {
    "maxChars": 300,
    "targetChars": 250,
    "triggerPhrase": "Use when",
    "notForPhrase": "Not for",
    "notVerbs": [
      "this",
      "these",
      "those",
      "its",
      "is",
      "was",
      "always",
      "various",
      "across",
      "towards",
