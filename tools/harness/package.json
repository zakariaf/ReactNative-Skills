{
  "name": "harness",
  "version": "1.0.0",
  "private": true,
  "main": "index.ts",
  "engines": {
    "node": ">=22.18",
    "npm": ">=11.17.0"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "prepare": "node scripts/hooks/install-git-hooks.ts",
    "verify": "node scripts/quality/run-verify.ts",
    "check:fast": "prettier --check . --log-level warn && eslint . --max-warnings 0 --cache --cache-strategy content --cache-location node_modules/.cache/eslint/ && npm run -s typecheck && jest --ci --onlyChanged --passWithNoTests",
    "format": "prettier --write . --log-level warn",
    "format:check": "prettier --check . --log-level warn",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p src/tsconfig.json",
    "test": "jest --ci",
    "test:golden": "jest --ci --selectProjects golden",
    "test:sim": "jest --ci --config jest.sim.config.js",
    "test:coverage": "jest --ci --coverage --randomize",
    "test:mutation": "stryker run",
    "check:unused": "knip",
    "check:deps": "node scripts/deps/check-deps.ts",
    "check:npm-config": "node scripts/deps/check-npm-config.ts",
    "export:audit": "APP_VARIANT=production EXPO_PUBLIC_APP_VARIANT=production expo export --platform ios --platform android --source-maps --output-dir dist-audit",
    "audit:licenses": "node scripts/audit/audit-licenses.ts",
    "i18n:verify": "node scripts/i18n/verify-catalogs.ts",
    "build:ios:sim": "node scripts/build/build-ios-sim.ts",
    "audit:network": "node scripts/audit/audit-network.ts",
    "audit:privacy": "node scripts/audit/audit-privacy.ts",
    "build:android:emu": "node scripts/build/build-android-emu.ts",
    "e2e:ios": "node scripts/e2e/run-e2e.ts --platform ios",
    "e2e:android": "node scripts/e2e/run-e2e.ts --platform android",
    "screenshots:ios": "node scripts/e2e/capture-screenshots.ts --platform ios",
    "screenshots:android": "node scripts/e2e/capture-screenshots.ts --platform android"
  },
  "dependencies": {
    "@formatjs/intl-getcanonicallocales": "3.2.12",
    "@formatjs/intl-locale": "5.3.12",
    "@formatjs/intl-numberformat": "9.4.3",
    "@formatjs/intl-pluralrules": "6.3.15",
    "@hookform/resolvers": "5.9.1",
    "@sentry/react-native": "~7.11.0",
    "@shopify/flash-list": "2.0.2",
    "@shopify/react-native-skia": "2.6.2",
    "@tanstack/react-query": "5.104.0",
    "expo": "~57.0.27",
    "expo-apple-authentication": "~57.0.2",
    "expo-auth-session": "~57.0.14",
    "expo-background-task": "~57.0.21",
    "expo-build-properties": "~57.0.22",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.21",
    "expo-crypto": "~57.0.3",
    "expo-dev-client": "~57.0.19",
    "expo-document-picker": "~57.0.3",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-iap": "5.8.0",
    "expo-image": "~57.0.5",
    "expo-image-picker": "~57.0.20",
    "expo-linking": "~57.0.12",
    "expo-localization": "~57.0.2",
    "expo-network": "~57.0.2",
    "expo-notifications": "~57.0.22",
    "expo-router": "~57.0.25",
    "expo-secure-store": "~57.0.4",
    "expo-sharing": "~57.0.22",
    "expo-splash-screen": "~57.0.9",
    "expo-sqlite": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-store-review": "~57.0.3",
    "expo-system-ui": "~57.0.4",
    "expo-task-manager": "~57.0.21",
    "expo-tracking-transparency": "~57.0.2",
    "expo-updates": "~57.0.25",
    "expo-web-browser": "~57.0.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "7.89.0",
    "react-intl": "12.1.3",
    "react-native": "0.86.3",
    "react-native-audio-api": "0.13.6",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-google-mobile-ads": "17.2.0",
    "react-native-keyboard-controller": "1.21.9",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "valibot": "1.5.0",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@formatjs/cli": "6.16.32",
    "@formatjs/icu-messageformat-parser": "3.5.20",
    "@react-native/eslint-plugin": "0.86.3",
    "@react-native/jest-preset": "0.86.3",
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/jest-runner": "10.0.0",
    "@stryker-mutator/typescript-checker": "10.0.0",
    "@testing-library/react-native": "14.0.1",
    "@types/jest": "29.5.14",
    "@types/jest-image-snapshot": "6.4.2",
    "@types/node": "26.4.1",
    "@types/react": "19.2.18",
    "babel-jest": "29.7.0",
    "eslint": "9.39.5",
    "eslint-config-expo": "57.0.2",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-check-file": "3.3.2",
    "eslint-plugin-formatjs": "8.1.0",
    "eslint-plugin-jest": "29.16.6",
    "eslint-plugin-react-native": "5.0.0",
    "eslint-plugin-sonarjs": "4.2.1",
    "eslint-plugin-testing-library": "7.16.2",
    "fast-check": "4.10.2",
    "globals": "17.12.0",
    "jest": "29.7.0",
    "jest-expo": "57.0.5",
    "jest-image-snapshot": "6.5.2",
    "knip": "6.38.0",
    "lefthook": "2.1.14",
    "prettier": "3.9.9",
    "test-renderer": "1.2.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1"
  },
  "overrides": {
    "@typescript-eslint/eslint-plugin": "8.70.1",
    "@typescript-eslint/parser": "8.70.1",
    "@typescript-eslint/project-service": "8.70.1",
    "@typescript-eslint/scope-manager": "8.70.1",
    "@typescript-eslint/tsconfig-utils": "8.70.1",
    "@typescript-eslint/type-utils": "8.70.1",
    "@typescript-eslint/types": "8.70.1",
    "@typescript-eslint/typescript-estree": "8.70.1",
    "@typescript-eslint/utils": "8.70.1",
    "@typescript-eslint/visitor-keys": "8.70.1"
  },
  "allowScripts": {
    "unrs-resolver@1.12.2": true,
    "fsevents@2.3.3": true,
    "lefthook": false,
    "@shopify/react-native-skia": false,
    "@sentry/cli": false
  }
}
