{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreExportsUsedInFile": true,
  "entry": [
    "src/app/**/*.{ts,tsx}",
    "scripts/**/*.ts",
    "__mocks__/**/*.ts",
    "{src,test,scripts}/**/*.test.{ts,tsx}"
  ],
  "project": [
    "*.ts",
    "src/**/*.{ts,tsx}",
    "test/**/*.{ts,tsx}",
    "scripts/**/*.ts",
    "__mocks__/**/*.ts"
  ],
  "ignore": [
    "skills/**",
    ".agents/**",
    ".claude/**",
    ".codex/**",
    ".cursor/**",
    ".windsurf/**",
    ".roo/**",
    ".cline/**",
    ".continue/**",
    ".kiro/**"
  ],
  "rules": {
    "files": "error",
    "dependencies": "error",
    "devDependencies": "error",
    "optionalPeerDependencies": "error",
    "unlisted": "error",
    "binaries": "error",
    "unresolved": "error",
    "exports": "error",
    "nsExports": "error",
    "types": "error",
    "nsTypes": "error",
    "enumMembers": "error",
    "namespaceMembers": "error",
    "duplicates": "error",
    "catalog": "error",
    "catalogReferences": "error",
    "cycles": "error"
  },
  "ignoreDependencies": [
    "@formatjs/cli",
    "@hookform/resolvers",
    "@shopify/flash-list",
    "expo-auth-session",
    "expo-build-properties",
    "expo-clipboard",
    "expo-crypto",
    "expo-font",
    "expo-haptics",
    "expo-image",
    "expo-secure-store",
    "expo-sharing",
    "expo-status-bar",
    "expo-store-review",
    "expo-updates",
    "expo-web-browser",
    "react-hook-form"
  ],
  "ignoreBinaries": ["plutil"]
}
